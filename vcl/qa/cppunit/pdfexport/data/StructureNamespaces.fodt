   <text:p text:style-name="Standard">Body under the first heading.<text:note text:id="ftn1" text:note-class="footnote"><text:note-citation>1</text:note-citation><text:note-body><text:p text:style-name="Footnote">The footnote body.</text:p></text:note-body></text:note></text:p>
   <text:p text:style-name="Quotations">A quoted paragraph.</text:p>
   <text:p text:style-name="Standard">A run in <text:span text:style-name="Quotation">quotation style</text:span>, a run in <text:span text:style-name="Source_20_Text">source text style</text:span>, and a citation <text:bibliography-mark text:identifier="Ref1" text:bibliography-type="book" text:author="An author" text:title="A title">[Ref1]</text:bibliography-mark>.</text:p>
