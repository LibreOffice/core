<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE script:module PUBLIC "-//OpenOffice.org//DTD OfficeDocument 1.0//EN" "module.dtd">
<script:module xmlns:script="http://openoffice.org/2000/script" script:name="SF_Python" script:language="StarBasic" script:moduleType="normal">REM =======================================================================================================================
REM ===			The ScriptForge library and its associated libraries are part of the LibreOffice project.				===
REM ===					Full documentation is available on https://help.libreoffice.org/								===
REM =======================================================================================================================

Option Compatible
Option Explicit

&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;
&apos;&apos;&apos;	SF_Python (aka Basic !!)
&apos;&apos;&apos;	=========
&apos;&apos;&apos;		Singleton class implementing the &quot;ScriptForge.Python&quot; and the &quot;ScriptForge.Basic&quot; services;.
&apos;&apos;&apos;		Implemented as a usual Basic module.
&apos;&apos;&apos;
&apos;&apos;&apos;		The &quot;Basic&quot; service must be called ONLY from a PYTHON script
&apos;&apos;&apos;		Service invocations: Next Python code lines are equivalent:
&apos;&apos;&apos;			bas = CreateScriptService(&apos;ScriptForge.Basic&apos;)
&apos;&apos;&apos;			bas = CreateScriptService(&apos;Basic&apos;)
&apos;&apos;&apos;
&apos;&apos;&apos;		This service proposes a collection of methods to be executed in a Python context
&apos;&apos;&apos;		to simulate the exact behaviour of the identical Basic builtin method.
&apos;&apos;&apos;		Typical example:
&apos;&apos;&apos;			bas.MsgBox(&apos;This has to be displayed in a message box&apos;)
&apos;&apos;&apos;
&apos;&apos;&apos;		The service includes also an agnostic &quot;_PythonDispatcher()&quot; function.
&apos;&apos;&apos;		It dispatches Python script requests to execute Basic services to the
&apos;&apos;&apos;		appropriate properties and methods via dynamic call techniques
&apos;&apos;&apos;
&apos;&apos;&apos;		----------------------------------------------------------------------------
&apos;&apos;&apos;
&apos;&apos;&apos;		The &quot;Python&quot; service must be called ONLY from a BASIC script
&apos;&apos;&apos;		Service invocations: Next Basic code lines are equivalent:
&apos;&apos;&apos;			py = CreateScriptService(&quot;ScriptForge.Python&quot;)
&apos;&apos;&apos;			py = CreateScriptService(&quot;Python&quot;)
&apos;&apos;&apos;
&apos;&apos;&apos;		The service proposes a set of methods to execute dynamically Python scripts
&apos;&apos;&apos;		passed from Basic code as strings. Such methods are typically a part
&apos;&apos;&apos;		of generic user-defined Calc functions
&apos;&apos;&apos;
&apos;&apos;&apos;		For all properties, the set value is preserved until it is explicitly set again.
&apos;&apos;&apos;
&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;&apos;

REM ================================================================== EXCEPTIONS

REM ============================================================ MODULE CONSTANTS

REM ===================================================== CONSTRUCTOR/DESTRUCTOR

REM -----------------------------------------------------------------------------
Public Function Dispose() As Variant
	Set Dispose = Nothing
End Function	&apos;	ScriptForge.SF_Python Explicit destructor

REM ================================================================== PROPERTIES

REM -----------------------------------------------------------------------------
Property Get CalcMode() As Variant
&apos;&apos;&apos;	Indicates whether the service is used from Calc user-defined functions (default)
&apos;&apos;&apos;	or not. In array formulas, result arrays have an orientation (vertical or horizontal).
&apos;&apos;&apos;	When False, the arguments and the results are passed without filter.
&apos;&apos;&apos;	Example:
&apos;&apos;&apos;		py = CreateScriptService(&quot;Python&quot;)
&apos;&apos;&apos;		MsgBox py.CalcMode
	CalcMode = _PropertyGet(&quot;CalcMode&quot;)
End Property	&apos;	ScriptForge.SF_Python.CalcMode (get)

REM -----------------------------------------------------------------------------
Property Let CalcMode(ByVal pvCalcMode As Variant)
&apos;&apos;&apos;	Set to False when run from usual Basic scripts, not from Calc user-defined functions.
&apos;&apos;&apos;	Example:
&apos;&apos;&apos;		py = CreateScriptService(&quot;Python&quot;)
&apos;&apos;&apos;		py.CalcMode = False
	_PropertySet &quot;CalcMode&quot;, pvCalcMode
End Property	&apos;	ScriptForge.SF_Python.CalcMode (let)

REM -----------------------------------------------------------------------------
Property Get ObjectType As String
&apos;&apos;&apos;	Only to enable object representation
	ObjectType = &quot;SF_Python&quot;
End Property	&apos;	ScriptForge.SF_Python.ObjectType

REM -----------------------------------------------------------------------------
Property Get Preload() As Variant
&apos;&apos;&apos;	Contains an initial list of assignments and/or imports and/or defs and/or classes
&apos;&apos;&apos;	executed before each code execution
&apos;&apos;&apos;	Example:
&apos;&apos;&apos;		py = CreateScriptService(&quot;Python&quot;)
&apos;&apos;&apos;		MsgBox py.Preload
	Preload = _PropertyGet(&quot;Preload&quot;)
End Property	&apos;	ScriptForge.SF_Python.Preload (get)

REM -----------------------------------------------------------------------------
Property Let Preload(ByVal pvPreload As Variant)
&apos;&apos;&apos;	Contains a list of assignments and/or imports executed before each code execution
&apos;&apos;&apos;	Use newlines or &quot;\n&quot; to separate statements from each other.
&apos;&apos;&apos;	When Security is NONE or MEDIUM, the set value is preserved until it is explicitly set again.
&apos;&apos;&apos;	Example:
&apos;&apos;&apos;		py = CreateScriptService(&quot;Python&quot;)
&apos;&apos;&apos;		py.Preload = &quot;import math\nimport numpy as np&quot;
	_PropertySet &quot;Preload&quot;, pvPreload
End Property	&apos;	ScriptForge.SF_Python.Preload (let)

REM -----------------------------------------------------------------------------
Property Get ReportScriptErrors() As Variant
&apos;&apos;&apos;	Indicates whether script errors are displayed in a message box when they occur
&apos;&apos;&apos;	The default value = False
&apos;&apos;&apos;	Example:
&apos;&apos;&apos;		py = CreateScriptService(&quot;Python&quot;)
&apos;&apos;&apos;		MsgBox py.ReportScriptErrors
	ReportScriptErrors = _PropertyGet(&quot;ReportScriptErrors&quot;)
End Property	&apos;	ScriptForge.SF_Python.ReportScriptErrors (get)

REM -----------------------------------------------------------------------------
Property Let ReportScriptErrors(ByVal pvReportScriptErrors As Variant)
&apos;&apos;&apos;	When set to False, an error occur silently. Useful f.i. in Calc user-defined functions.
&apos;&apos;&apos;	The set value is preserved until it is explicitly set again.
&apos;&apos;&apos;	Example:
&apos;&apos;&apos;		py = CreateScriptService(&quot;Python&quot;)
&apos;&apos;&apos;		py.ReportScriptErrors = False
	_PropertySet &quot;ReportScriptErrors&quot;, pvReportScriptErrors
End Property	&apos;	ScriptForge.SF_Python.ReportScriptErrors (let)

REM -----------------------------------------------------------------------------
Property Get Security() As Variant
&apos;&apos;&apos;	Indicates the level of protection set against malicious code
&apos;&apos;&apos;	When &gt;= SECURITYMEDIUM, dangerous statements are forbidden: import, open, ...
&apos;&apos;&apos;	The default value = SECURITYMEDIUM
&apos;&apos;&apos;	Example:
&apos;&apos;&apos;		py = CreateScriptService(&quot;Python&quot;)
&apos;&apos;&apos;		MsgBox py.Security
	Security = _PropertyGet(&quot;Security&quot;)
End Property	&apos;	ScriptForge.SF_Python.Security (get)

REM -----------------------------------------------------------------------------
Property Let Security(ByVal pvSecurity As Variant)
&apos;&apos;&apos;	When set to:
&apos;&apos;&apos;		SECURITYNONE	No protection
&apos;&apos;&apos;		SECURITYMEDIUM	Some statements (import, open, breakpoint, inputà are prohibited
&apos;&apos;&apos;		SECURITYHIGH	Idem + once set Security and Preload properties cannot
&apos;&apos;&apos;						be modified anymore until the LibreOffoce session ends
&apos;&apos;&apos;	When NONE or MEDIUM, the set value is preserved until it is explicitly set again.
&apos;&apos;&apos;	Example:
&apos;&apos;&apos;		py = CreateScriptService(&quot;Python&quot;)
&apos;&apos;&apos;		py.Security = False
	_PropertySet &quot;Security&quot;, pvSecurity
End Property	&apos;	ScriptForge.SF_Python.Security (let)

REM -----------------------------------------------------------------------------
Property Get SECURITYNONE() As Integer		&apos;	Constant values possible used from external scripts
	SECURITYNONE = 0
End Property	&apos;	ScriptForge.SF_Python.SECURITYNONE (get)
REM -----------------------------------------------------------------------------
Property Get SECURITYMEDIUM() As Integer
	SECURITYMEDIUM = 1
End Property	&apos;	ScriptForge.SF_Python.SECURITYMEDIUM (get)
REM -----------------------------------------------------------------------------
Property Get SECURITYHIGH() As Integer
	SECURITYHIGH = 2
End Property	&apos;	ScriptForge.SF_Python.SECURITYHIGH (get)

REM -----------------------------------------------------------------------------
Property Get VerboseErrors() As Variant
&apos;&apos;&apos;	Indicates whether returned script errors are a full Traceback or not
&apos;&apos;&apos;	The default value = False
&apos;&apos;&apos;	Example:
&apos;&apos;&apos;		py = CreateScriptService(&quot;Python&quot;)
&apos;&apos;&apos;		MsgBox py.VerboseErrors
	VerboseErrors = _PropertyGet(&quot;VerboseErrors&quot;)
End Property	&apos;	ScriptForge.SF_Python.VerboseErrors (get)

REM -----------------------------------------------------------------------------
Property Let VerboseErrors(ByVal pvVerboseErrors As Variant)
&apos;&apos;&apos;	When set to True, the full TraceBack is returned as a string
&apos;&apos;&apos;	The set value is preserved until it is explicitly set again.
&apos;&apos;&apos;	Example:
&apos;&apos;&apos;		py = CreateScriptService(&quot;Python&quot;)
&apos;&apos;&apos;		py.VerboseErrors = True
	_PropertySet &quot;VerboseErrors&quot;, pvVerboseErrors
End Property	&apos;	ScriptForge.SF_Python.VerboseErrors (let)

REM -----------------------------------------------------------------------------
Property Get ServiceName As String
&apos;&apos;&apos;	Internal use
	ServiceName = &quot;ScriptForge.Python&quot;
End Property	&apos;	ScriptForge.SF_Python.ServiceName

REM ============================================================== PUBLIC METHODS

REM -----------------------------------------------------------------------------
Public Function ExecuteExpression(Optional ByVal PyExpression As Variant) As Variant
&apos;&apos;&apos;	Execute the Python expression given as a string and return its value.
&apos;&apos;&apos;	The Preload string of import or assignment statements is executed beforehand.
&apos;&apos;&apos;	The method is assumed to be invoked from a Calc user-defined function.
&apos;&apos;&apos;	Args:
&apos;&apos;&apos;		PyExpression: a syntactically valid Python expression
&apos;&apos;&apos;		Imports: a comma-separated list of modules to import
&apos;&apos;&apos;	Returns:
&apos;&apos;&apos;		The value(s) returned by the execution to the expression. If &gt;1 values, enclosed in an array.
&apos;&apos;&apos;		If the execution failed, an error message is returned.
&apos;&apos;&apos;	Examples:
&apos;&apos;&apos;		py.Preload = &quot;import math\nunit=&apos;km&apos;&quot;
&apos;&apos;&apos;		py.ExecuteExpression(&quot;str(math.sin(math.pi / 2.0)) + unit&quot;, &quot;math&quot;)		&apos;	1.0km

Dim vReturn As Variant			&apos;	Returned value

Const cstThisSub = &quot;Python.ExecuteExpression&quot;
Const cstSubArgs = &quot;PyExpression&quot;

	If SF_Utils._ErrorHandling() Then On Local Error GoTo Catch
	vReturn = Empty

Check:
	If SF_Utils._EnterFunction(cstThisSub, cstSubArgs) Then
		If Not SF_Utils._Validate(PyExpression, &quot;PyExpression&quot;, V_STRING) Then GoTo Finally
	End If

Try:
	vReturn = SF_Python._ExecuteUDF(&quot;expression&quot;, PyExpression, &quot;&quot;, &quot;&quot;)

Finally:
	ExecuteExpression = vReturn
	SF_Utils._ExitFunction(cstThisSub)
	Exit Function
Catch:
	On Local Error GoTo 0
	GoTo Finally
End Function	&apos;	ScriptForge.SF_Python.ExecuteExpression

REM -----------------------------------------------------------------------------
Public Function ExecuteFormula(Optional ByVal PyFormula As Variant _
										, Optional ByRef Names As Variant _
										, Optional ByRef Values As Variant _
										, Optional ByVal Result As Variant _
										) As Variant
&apos;&apos;&apos;	Execute the Python &quot;formula&quot; given as a string and return the value hold in a given variable name.
&apos;&apos;&apos;	Each variable in Names is initialized with its counterpart in Values.
&apos;&apos;&apos;	The Preload string of import or assignment statements is executed beforehand.
&apos;&apos;&apos;	A formula in this context is a set of statements not located inside a def.
&apos;&apos;&apos;
&apos;&apos;&apos;	The method is assumed to be invoked from a Calc user-defined function.
&apos;&apos;&apos;	The function may be executed as a usual formula or as an array formula.
&apos;&apos;&apos;	In this case, the method identivies the orientation of the Names table (horizontal or vertical).
&apos;&apos;&apos;	The orientation of the Values table is assumed to be perpendicular to the Names orientation.
&apos;&apos;&apos;	The Calc cell formula may revert the orientation with the Transpose() Calc function.
&apos;&apos;&apos;
&apos;&apos;&apos;	Args:
&apos;&apos;&apos;		PyFormula: a syntactically valid Python formula. Use newlines or &quot;\n&quot; to separate statements.
&apos;&apos;&apos;		Names: A single variable name or an array of variable names
&apos;&apos;&apos;		Values: a scalar, or a 1D or 2D array of numeric and string values.
&apos;&apos;&apos;			Each name in Names will be initialized with a value from Values
&apos;&apos;&apos;			When 2D, the execution will run as many times as the array has rows (columns),
&apos;&apos;&apos;			each time with the set of values stored in the respective row (column).
&apos;&apos;&apos;			The number of items (1D) or the number of columns (rows) (2D) in Values
&apos;&apos;&apos;			must be equal to the number of items in Names.
&apos;&apos;&apos;		Result: the name of the variable holding the resulting value. Default = &quot;result&quot;.
&apos;&apos;&apos;	Returns:
&apos;&apos;&apos;		The value(s) returned by the execution to the formula.
&apos;&apos;&apos;		If Values is a 2D array, the results are enclosed in an array.
&apos;&apos;&apos;		If the execution failed, an error message is returned.
&apos;&apos;&apos;	Examples:
&apos;&apos;&apos;		Formula = &quot;discount = 0.1\n&quot; _
&apos;&apos;&apos;				&amp; &quot;price = unitprice * quantity * (1.0 - discount)&quot;
&apos;&apos;&apos;		py.ExecuteFormula(Formula, &quot;price&quot;, Array(&quot;unitprice&quot;, &quot;quantity&quot;), Array(90.0, 5))	&apos;	405.0

Dim vReturn As Variant			&apos;	Returned value
Dim vNames As Variant			&apos;	Alias of Names
Dim vValues As Variant			&apos;	Alias of Values
Dim bVertical As Boolean		&apos;	When True, data table is vertical

Const cstThisSub = &quot;Python.ExecuteFormula&quot;
Const cstSubArgs = &quot;PyFormula, [Names=Array()], [Values=Array()], [Result=&quot;&quot;result&quot;&quot;]&quot;

	If SF_Utils._ErrorHandling() Then On Local Error GoTo Catch
	vReturn = Empty

Check:
	If IsMissing(Names) Or IsEmpty(Names) Or IsError(Names) Then Names = Array()
	If IsMissing(Values) Or IsEmpty(Values) Or IsError(Values) Then Values = Array()
	If IsMissing(Result) Or IsEmpty(Result) Or IsError(Result) Then Result = &quot;result&quot;
	If SF_Utils._EnterFunction(cstThisSub, cstSubArgs) Then
		If Not SF_Utils._Validate(PyFormula, &quot;PyFormula&quot;, V_STRING) Then GoTo Finally
		If IsArray(Names) Then vNames = Names Else vNames = Array(Names)
		If Not SF_Utils._ValidateArray(vNames, &quot;Names&quot;, , V_STRING) Then GoTo Finally
		If IsArray(Values) Then vValues = Values Else vValues = Array(Values)
		If Not SF_Utils._ValidateArray(vValues, &quot;Values&quot;) Then GoTo Finally
		If Not SF_Utils._Validate(Result, &quot;Result&quot;, V_STRING) Then GoTo Finally
	End If

Try:
	&apos;	Names are passed as a scalar, a vector of names or a matrix when the origin is a selection of cells
	&apos;	Determine the direction (horizontal or vertical) and extract the meaningful column or row.
	&apos;	When the direction is horizontal, the data matrix must be transposed.
	If CalcMode And (SF_Array.CountDims(vNames) &gt; 1) Then
		If UBound(vNames, 1) = LBound(vNames, 1) Then		&apos;	A single row
			bVertical = True
			vNames = SF_Array.ExtractRow(vNames, LBound(vNames, 1))
		Else												&apos;	A single column
			bVertical = False
			vNames = SF_Array.ExtractColumn(vNames, LBound(vNames, 2))
			vValues = SF_Array.Transpose(vValues)
		End If
	End If

	vReturn = SF_Python._ExecuteUDF(&quot;formula&quot;, PyFormula, &quot;&quot;, Result, vNames, vValues)

	&apos;	When the returned value is a vector, the method is presumed called from an array formula
	&apos;	Its orientation is orthogonal to the Names vector
	If IsArray(vReturn) Then
		If CalcMode And (SF_Array.CountDims(vReturn) = 1) Then
			If bVertical Then
				vReturn = SF_Array.AppendColumn(Array(), vReturn)
			Else
				vReturn = SF_Array.AppendRow(Array(), vReturn)
			End If
		End If
	End If

Finally:
	ExecuteFormula = vReturn
	SF_Utils._ExitFunction(cstThisSub)
	Exit Function
Catch:
	On Local Error GoTo 0
	GoTo Finally
End Function	&apos;	ScriptForge.SF_Python.ExecuteFormula

REM -----------------------------------------------------------------------------
Public Function ExecuteFunction(Optional ByVal PyDef As Variant _
										, ParamArray Args As Variant _
										) As Variant
&apos;&apos;&apos;	Execute a Python script encapsulated in a &quot;def&quot; and return its returned value.
&apos;&apos;&apos;	The Preload string of import or assignment statements is executed beforehand.
&apos;&apos;&apos;	A Function in this context is a def statement. It must be the first executable statement in PyDef.
&apos;&apos;&apos;	Only the inner defs or classes are considered. Outer statements are ignored.
&apos;&apos;&apos;	The method is assumed to be invoked from a Calc user-defined function.
&apos;&apos;&apos;	Args:
&apos;&apos;&apos;		PyDef: a syntactically valid Python def function.
&apos;&apos;&apos;		Use newlines or &quot;\n&quot; to separate statements. Use tab characters, &quot;\t&quot; or spaces to indent the code.
&apos;&apos;&apos;		Args: a list of string or numeric arguments, or of vectors with such types.
&apos;&apos;&apos;	Returns:
&apos;&apos;&apos;		The value(s) returned by the execution to the function. They may be enclosed in an array.
&apos;&apos;&apos;		If the execution failed, an error message is returned.
&apos;&apos;&apos;	Examples:
&apos;&apos;&apos;		def = &quot;def add(a, b):\n&quot; _
&apos;&apos;&apos;				&amp; &quot;\treturn a + b&quot;
&apos;&apos;&apos;		py.ExecuteFunction(def, 25, 50)		&apos;	75.0

Dim vReturn As Variant			&apos;	Returned value
Dim sDef As String				&apos;	Name of the def to execute
Dim sDefinition As String		&apos;	Result of regex search
Dim vLines As Variant			&apos;	PyDef split line by line
Dim sLine As String				&apos;	One single item from vLines
Dim vArgs As Variant			&apos;	Alias of Args
Dim vArg As Variant				&apos;	A single vArg
Dim i As Long

Const cstThisSub = &quot;Python.ExecuteFunction&quot;
Const cstSubArgs = &quot;PyDef, [Arg0, ...]&quot;

	If SF_Utils._ErrorHandling() Then On Local Error GoTo Catch
	vReturn = Empty

Check:
	If SF_Utils._EnterFunction(cstThisSub, cstSubArgs) Then
		If Not SF_Utils._Validate(PyDef, &quot;PyDef&quot;, V_STRING) Then GoTo Finally
	End If

Try:
	&apos;	Manage newlines and tabs in the function
	
	&apos;	Determine the name of the def
	With SF_String
		vLines = .SplitLines(Replace(PyDef, &quot;\n&quot;, .sfNEWLINE))
		For Each sLine In vLines
			sDef = .FindRegex(sLine, &quot;^def +\w+ *\(&quot;, 1, CaseSensitive := True)
			If Len(sDef) &gt; 5 Then
				sDef = Trim(Mid(sDef, 5, Len(sDef) - 5))
				Exit For
			End If
		Next sLine
	End With

	&apos;	Manage cascading ParamArrays arguments when method called from user-defined function
	If UBound(Args, 1) = 0 Then vArgs = Args(0) Else vArgs = Args

	&apos;	Arguments are passed as scalars or vectors when the origin is a selection of cells
	&apos;	Extract in each argument the meaningful column or row.
	For i = 0 To UBound(vArgs, 1)
		vArg = vArgs(i)
		If CalcMode And (SF_Array.CountDims(vArg) &gt; 1) Then
			If UBound(vArg, 1) = LBound(vArg, 1) Then		&apos;	A single row
				vArgs(i) = SF_Array.ExtractRow(vArg, LBound(vArg, 1))
			Else											&apos;	A single column
				vArgs(i) = SF_Array.ExtractColumn(vArg, LBound(vArg, 2))
			End If
		End If
	Next i

	If Len(sDef) &gt; 0 Then vReturn = SF_Python._ExecuteUDF(&quot;function&quot;, PyDef, sDef, &quot;&quot;, vArgs)

	&apos;	When the returned value is a vector, the method is presumed called from a vertical array formula
	If IsArray(vReturn) Then
		If CalcMode And (SF_Array.CountDims(vReturn) = 1) Then vReturn = SF_Array.AppendColumn(Array(), vReturn)
	End If

Finally:
	ExecuteFunction = vReturn
	SF_Utils._ExitFunction(cstThisSub)
	Exit Function
Catch:
	On Local Error GoTo 0
	GoTo Finally
End Function	&apos;	ScriptForge.SF_Python.ExecuteFunction

REM -----------------------------------------------------------------------------
Public Function GetProperty(Optional ByVal PropertyName As Variant) As Variant
&apos;&apos;&apos;	Return the actual value of the given property
&apos;&apos;&apos;	Args:
&apos;&apos;&apos;		PropertyName: the name of the property as a string
&apos;&apos;&apos;	Returns:
&apos;&apos;&apos;		The actual value of the property
&apos;&apos;&apos;	Exceptions
&apos;&apos;&apos;		ARGUMENTERROR		The property does not exist

Const cstThisSub = &quot;Python.GetProperty&quot;
Const cstSubArgs = &quot;PropertyName&quot;

	If SF_Utils._ErrorHandling() Then On Local Error GoTo Catch
	GetProperty = Null

Check:
	If SF_Utils._EnterFunction(cstThisSub, cstSubArgs) Then
		If Not SF_Utils._Validate(PropertyName, &quot;PropertyName&quot;, V_STRING, Properties()) Then GoTo Catch
	End If

Try:
	GetProperty = _PropertyGet(PropertyName)

Finally:
	SF_Utils._ExitFunction(cstThisSub)
	Exit Function
Catch:
	GoTo Finally
End Function	&apos;	ScriptForge.SF_Python.GetProperty

REM -----------------------------------------------------------------------------
Public Function Methods() As Variant
&apos;&apos;&apos;	Return the list of public methods of the Python service as an array

	Methods = Array( _
					&quot;ExecuteExpression&quot; _
					, &quot;ExecuteFormula&quot; _
					, &quot;ExecuteFunction&quot; _
					)		&apos;	PyXxx() methods are not included

End Function	&apos;	ScriptForge.SF_Python.Methods

REM -----------------------------------------------------------------------------
Public Function Properties() As Variant
&apos;&apos;&apos;	Return the list or properties of the Python class as an array

	Properties = Array( _
					&quot;CalcMode&quot; _
					, &quot;Preload&quot; _
					, &quot;ReportScriptErrors&quot; _
					, &quot;Security&quot; _
					, &quot;VerboseErrors&quot; _
					)

End Function	&apos;	ScriptForge.SF_Python.Properties

REM -----------------------------------------------------------------------------
Public Function PyCDate(ByVal DateArg As Variant) As Variant
&apos;&apos;&apos;	Convenient function to replicate CDate() in Python scripts
&apos;&apos;&apos;	Args:
&apos;&apos;&apos;		DateArg: a date as a string or as a double
&apos;&apos;&apos;	Returns:
&apos;&apos;&apos;		The converted date as a UNO DateTime structure
&apos;&apos;&apos;		If the input argument could not be recognized as a date, return the argument unchanged
&apos;&apos;&apos;	Example: (Python code)
&apos;&apos;&apos;		a = bas.CDate(&apos;2021-02-18&apos;)

Dim vDate As Variant				&apos;	Return value
Const cstThisSub = &quot;Basic.CDate&quot;
Const cstSubArgs = &quot;datearg&quot;

	On Local Error GoTo Catch
	vDate = Null

Check:
	SF_Utils._EnterFunction(cstThisSub, cstSubArgs)

Try:
	vDate = CDate(DateArg)

Finally:
	If VarType(vDate) = V_DATE Then PyCDate = CDateToUnoDateTime(vDate) Else PyCDate = DateArg
	SF_Utils._ExitFunction(cstThisSub)
	Exit Function
Catch:
	On Local Error GoTo 0
	GoTo Finally
End Function	&apos;	ScriptForge.SF_Python.PyCDate

REM -----------------------------------------------------------------------------
Public Function PyConvertFromUrl(ByVal FileName As Variant) As String
&apos;&apos;&apos;	Convenient function to replicate ConvertFromUrl() in Python scripts
&apos;&apos;&apos;	Args:
&apos;&apos;&apos;		FileName: a string representing a file in URL format
&apos;&apos;&apos;	Returns:
&apos;&apos;&apos;		The same file name in native operating system notation
&apos;&apos;&apos;	Example: (Python code)
&apos;&apos;&apos;		a = bas.ConvertFromUrl(&apos;file:////boot.sys&apos;)

Dim sFileName As String			&apos;	Return value
Const cstThisSub = &quot;Basic.ConvertFromUrl&quot;
Const cstSubArgs = &quot;filename&quot;

	If SF_Utils._ErrorHandling() Then On Local Error GoTo Catch
	sFileName = &quot;&quot;

Check:
	SF_Utils._EnterFunction(cstThisSub, cstSubArgs)

Try:
	sFileName = ConvertFromUrl(FileName)

Finally:
	PyConvertFromUrl = sFileName
	SF_Utils._ExitFunction(cstThisSub)
	Exit Function
Catch:
	GoTo Finally
End Function	&apos;	ScriptForge.SF_Python.PyConvertFromUrl

