<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- System.Windows.Automation, the UI Automation client, comes with WPF. -->
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>coda-driver</AssemblyName>
    <RootNamespace>CodaDriver</RootNamespace>
  </PropertyGroup>

</Project>
