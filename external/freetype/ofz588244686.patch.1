From 3f6dad8e4f82c4f9c7cf9ffbf82972b912c08e48 Mon Sep 17 00:00:00 2001
From: Werner Lemberg <wl@gnu.org>
Date: Tue, 27 Oct 2026 06:23:06 +0100
Subject: [PATCH] * src/truetype/ttvarc.c (read_uint32var): Avoid undefined
 shift.

Reported as

  https://issues.oss-fuzz.com/issues/578116201
---
 src/truetype/ttvarc.c | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/src/truetype/ttvarc.c b/src/truetype/ttvarc.c
index de57443c..5dad23f4 100644
--- a/src/truetype/ttvarc.c
+++ b/src/truetype/ttvarc.c
@@ -176,10 +176,10 @@
     {
       if ( *p + 3 >= limit )
         return FT_THROW( Invalid_Table );
-      result = ( (*p)[0] << 24 ) |
-               ( (*p)[1] << 16 ) |
-               ( (*p)[2] << 8  ) |
-                 (*p)[3];
+      result = ( (FT_UInt32)(*p)[0] << 24 ) |
+               ( (FT_UInt32)(*p)[1] << 16 ) |
+               ( (FT_UInt32)(*p)[2] << 8  ) |
+                 (FT_UInt32)(*p)[3];
       *p += 4;
       *value = result;
       return FT_Err_Ok;
-- 
2.56.1

