From: =?UTF-8?q?Caol=C3=A1n=20McNamara?= <caolan.mcnamara@collabora.com>
Date: Mon, 9 Nov 2026 17:22:08 +0000
Subject: [PATCH 5/5] limit the cache of loaded language modules to 64 entries

Each new language string loads and keeps its own compiled program of
about 0.5 MB, and region variants count separately, so the cache grew
without limit. Once 64 are cached, remove one before adding another.
---
 src/Numbertext.cxx | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/src/Numbertext.cxx b/src/Numbertext.cxx
index e7ebc8f..0a11272 100644
--- a/src/Numbertext.cxx
+++ b/src/Numbertext.cxx
@@ -21,6 +21,7 @@
 #define SOROS_EXT ".sor"
 #define LANG_PATTERN_NO "n[bn]([-_]NO)\?"
 #define MAX_INPUT_LENGTH 1024
+#define MAX_MODULES 64
 
 // U+E000..U+E00A are the internal markers of the Soros programs
 static bool is_marker(wchar_t c)
@@ -73,6 +74,8 @@ bool Numbertext::load(std::string lang, std::string filename)
             }
         }
     }
+    if (modules.size() >= MAX_MODULES)
+        modules.erase(modules.begin());
     modules.insert(std::make_pair(lang, Soros(module, string2wstring(lang))));
     return true;
 }
