From 79f99311035d1eec0a40139f59292bc121692961 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Caol=C3=A1n=20McNamara?= <caolan.mcnamara@collabora.com>
Date: Sun, 8 Nov 2026 18:10:46 +0000
Subject: [PATCH 08/11] check the MTX block offsets are in order before using
 them as sizes

the old check added each size back to its offset, so it could not see a
size that had wrapped
---
 src/lzcomp/liblzcomp.c | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/src/lzcomp/liblzcomp.c b/src/lzcomp/liblzcomp.c
index 4371346..8ec458e 100644
--- a/src/lzcomp/liblzcomp.c
+++ b/src/lzcomp/liblzcomp.c
@@ -52,14 +52,14 @@ enum EOTError unpackMtx(struct Stream *buf, unsigned size, uint8_t **bufsOut, un
 		sResult = BEReadU24(buf, &offsets[i]);
 		CHK_CN(sResult, EOT_MTX_ERROR);
 	}
+	if (offsets[1] < offsets[0] || offsets[2] < offsets[1] || offsets[2] > buf->size)
+	{
+		returnedStatus = EOT_MTX_ERROR;
+		goto CLEANUP;
+	}
 	unsigned sizes[] = {offsets[1] - offsets[0], offsets[2] - offsets[1], buf->size - offsets[2]};
 	for (unsigned i = 0; i < 3; ++i)
 	{
-		if (offsets[i] + sizes[i] > buf->size)
-		{
-			returnedStatus = EOT_MTX_ERROR;
-			goto CLEANUP;
-		}
 		long sizeOut;
 		bufsOut[i] = (uint8_t *)MTX_LZCOMP_UnPackMemory(lzcomp, buf->buf + offsets[i], sizes[i], &sizeOut, versionMagic);
 		bufSizesOut[i] = sizeOut;
-- 
