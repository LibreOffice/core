From ea38c8da3fe15e4c113c957dc963b4d9dcffa8bd Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Caol=C3=A1n=20McNamara?= <caolan.mcnamara@collabora.com>
Date: Sun, 8 Nov 2026 18:10:59 +0000
Subject: [PATCH 09/11] check that a copy item's source starts within the
 decoded data

The source can reach back into the preload area as well. Check this in
both branches of Decode, and make the assert on maxCopyDistance in the
ring buffer branch a real check.
---
 src/lzcomp/lzcomp.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/src/lzcomp/lzcomp.c b/src/lzcomp/lzcomp.c
index b6dff21..2a37b61 100644
--- a/src/lzcomp/lzcomp.c
+++ b/src/lzcomp/lzcomp.c
@@ -766,6 +766,7 @@ static unsigned char *Decode( register LZCOMP *t, long *size )
                 if ( distance >=max_2Byte_Dist  ) length++;
                 start        = pos - distance - length + 1;
                 if ( length > t->out_len - pos ) longjmp( t->mem->env, ERR_LZCOMP_Decode_bounds );
+                if ( distance + length - 1 > pos + preLoadSize ) longjmp( t->mem->env, ERR_LZCOMP_Decode_bounds );
                 for ( j = 0; j < length; j++ ) {
                     value = ptr1[ start + j ];
                     ptr1[ pos++ ] = value;
@@ -826,8 +827,9 @@ static unsigned char *Decode( register LZCOMP *t, long *size )
                 distance    = DecodeDistance2( t, numDistRanges );
                 if ( distance >=max_2Byte_Dist  ) length++;
                 start        = dst - distance - length + 1;
-                assert( distance + length - 1 <= t->maxCopyDistance );
                 if ( length > t->out_len - pos ) longjmp( t->mem->env, ERR_LZCOMP_Decode_bounds );
+                if ( distance + length - 1 > pos + preLoadSize ||
+                     distance + length - 1 > t->maxCopyDistance ) longjmp( t->mem->env, ERR_LZCOMP_Decode_bounds );
                 for ( j = 0; j < length; j++ ) {
                     src = start + j;
                     if ( src < 0 ) src = src + t->maxCopyDistance;
-- 
