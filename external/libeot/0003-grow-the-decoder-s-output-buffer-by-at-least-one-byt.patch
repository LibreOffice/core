From 1769649dc5fd21fe94a3ccd6ee0863f51805e659 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Caol=C3=A1n=20McNamara?= <caolan.mcnamara@collabora.com>
Date: Sun, 8 Nov 2026 17:23:28 +0000
Subject: [PATCH 3/5] grow the decoder's output buffer by at least one byte

---
 src/lzcomp/lzcomp.c | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/src/lzcomp/lzcomp.c b/src/lzcomp/lzcomp.c
index 9dc3daa..fd6d000 100644
--- a/src/lzcomp/lzcomp.c
+++ b/src/lzcomp/lzcomp.c
@@ -774,7 +774,7 @@ static unsigned char *Decode( register LZCOMP *t, long *size )
                     } else {
                         assert( index <= dataOutSize );
                         if ( index >=dataOutSize ) {
-                            dataOutSize += dataOutSize>>1; /* Allocate in exponentially increasing steps */
+                            dataOutSize += (dataOutSize>>1) + 1; /* Allocate in exponentially increasing steps */
                             dataOut = (unsigned char *)MTX_mem_realloc( t->mem, dataOut, dataOutSize );
                         }
                         dataOut[ index++ ] = value;
@@ -789,7 +789,7 @@ static unsigned char *Decode( register LZCOMP *t, long *size )
             } else {
                 assert( index <= dataOutSize );
                 if ( index >=dataOutSize ) {
-                    dataOutSize += dataOutSize>>1; /* Allocate in exponentially increasing steps */
+                    dataOutSize += (dataOutSize>>1) + 1; /* Allocate in exponentially increasing steps */
                     dataOut = (unsigned char *)MTX_mem_realloc( t->mem, dataOut, dataOutSize );
                 }
                 dataOut[ index++ ] = value;
@@ -839,7 +839,7 @@ static unsigned char *Decode( register LZCOMP *t, long *size )
                     } else {
                         assert( index <= dataOutSize );
                         if ( index >=dataOutSize ) {
-                            dataOutSize += dataOutSize>>1; /* Allocate in exponentially increasing steps */
+                            dataOutSize += (dataOutSize>>1) + 1; /* Allocate in exponentially increasing steps */
                             dataOut = (unsigned char *)MTX_mem_realloc( t->mem, dataOut, dataOutSize );
                         }
                         dataOut[ index++ ] = value;
@@ -856,7 +856,7 @@ static unsigned char *Decode( register LZCOMP *t, long *size )
             } else {
                 assert( index <= dataOutSize );
                 if ( index >=dataOutSize ) {
-                    dataOutSize += dataOutSize>>1; /* Allocate in exponentially increasing steps */
+                    dataOutSize += (dataOutSize>>1) + 1; /* Allocate in exponentially increasing steps */
                     dataOut = (unsigned char *)MTX_mem_realloc( t->mem, dataOut, dataOutSize );
                 }
                 dataOut[ index++ ] = value;
@@ -1190,7 +1190,7 @@ void MTX_RUNLENGTHCOMP_SaveBytes( register RUNLENGTHCOMP *t, unsigned char value
         } else {
             assert( index <= dataOutSize );
             if ( index >=dataOutSize ) {
-                dataOutSize += dataOutSize>>1; /* Allocate in exponentially increasing steps */
+                dataOutSize += (dataOutSize>>1) + 1; /* Allocate in exponentially increasing steps */
                 dataOut = (unsigned char *)MTX_mem_realloc( t->mem, dataOut, dataOutSize );
             }
             dataOut[ index++ ] = value;
@@ -1199,7 +1199,7 @@ void MTX_RUNLENGTHCOMP_SaveBytes( register RUNLENGTHCOMP *t, unsigned char value
         if ( (t->count = value) == 0 ) {
             assert( index <= dataOutSize );
             if ( index >=dataOutSize ) {
-                dataOutSize += dataOutSize>>1; /* Allocate in exponentially increasing steps */
+                dataOutSize += (dataOutSize>>1) + 1; /* Allocate in exponentially increasing steps */
                 dataOut = (unsigned char *)MTX_mem_realloc( t->mem, dataOut, dataOutSize );
             }
             dataOut[ index++ ] = t->escape;
