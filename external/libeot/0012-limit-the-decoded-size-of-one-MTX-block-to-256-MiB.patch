From be85a61632ed37b9f77d3d21d1c900e10ff04917 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Caol=C3=A1n=20McNamara?= <caolan.mcnamara@collabora.com>
Date: Sun, 8 Nov 2026 21:16:20 +0000
Subject: [PATCH] limit the decoded size of one MTX block to 256 MiB

The biggest I found that Windows allowed was a block that decoded to
135 MB
---
 src/lzcomp/lzcomp.c | 31 ++++++++++++++++++-------------
 1 file changed, 18 insertions(+), 13 deletions(-)

diff --git a/src/lzcomp/lzcomp.c b/src/lzcomp/lzcomp.c
index b53a5e4..63aa84a 100644
--- a/src/lzcomp/lzcomp.c
+++ b/src/lzcomp/lzcomp.c
@@ -28,6 +28,8 @@
 /*const int NUM_SYMS      = DUP6 + 1; */
 
 const long max_2Byte_Dist = 512;
+/* The largest decoded size of one block, far above what real fonts reach */
+const long max_DecodedBlockSize = 256L * 1024 * 1024;
 
 /* Sets the maximum number of distance ranges used, based on the <length> parameter */
 static void SetDistRange( LZCOMP *t, long length )
@@ -1209,12 +1211,24 @@ const unsigned char needByteState   = 2;
 
 #ifdef DECOMPRESS_ON
 
+/* Grows the output to hold at least needed bytes, in exponentially increasing steps */
+static unsigned char *GrowOutput( MTX_MemHandler *mem, unsigned char *dataOut, long *dataOutSize, long needed )
+{
+    long size;
+    if ( needed > max_DecodedBlockSize ) longjmp( mem->env, ERR_LZCOMP_Decode_bounds );
+    size = needed + (*dataOutSize>>1);
+    if ( size > max_DecodedBlockSize ) size = max_DecodedBlockSize;
+    dataOut = (unsigned char *)MTX_mem_realloc( mem, dataOut, size );
+    *dataOutSize = size;
+    return dataOut;
+}
+
 /* Use this method to decompress the data transparantly */
 /* as it goes to the memory. */
 void MTX_RUNLENGTHCOMP_SaveBytes( register RUNLENGTHCOMP *t, unsigned char value, unsigned char * *dataOutRef, long *dataOutSizeRef, long *indexRef )
 {
     register unsigned char *dataOut = *dataOutRef;
-    register long dataOutSize = *dataOutSizeRef;
+    long dataOutSize = *dataOutSizeRef;
     register long index = *indexRef;
     
     if ( t->state == normalState ) {
@@ -1222,19 +1236,13 @@ void MTX_RUNLENGTHCOMP_SaveBytes( register RUNLENGTHCOMP *t, unsigned char value
             t->state = seenEscapeState;
         } else {
             assert( index <= dataOutSize );
-            if ( index >=dataOutSize ) {
-                dataOutSize += (dataOutSize>>1) + 1; /* Allocate in exponentially increasing steps */
-                dataOut = (unsigned char *)MTX_mem_realloc( t->mem, dataOut, dataOutSize );
-            }
+            if ( index >=dataOutSize ) dataOut = GrowOutput( t->mem, dataOut, &dataOutSize, index + 1 );
             dataOut[ index++ ] = value;
         }
     } else if ( t->state == seenEscapeState ) {
         if ( (t->count = value) == 0 ) {
             assert( index <= dataOutSize );
-            if ( index >=dataOutSize ) {
-                dataOutSize += (dataOutSize>>1) + 1; /* Allocate in exponentially increasing steps */
-                dataOut = (unsigned char *)MTX_mem_realloc( t->mem, dataOut, dataOutSize );
-            }
+            if ( index >=dataOutSize ) dataOut = GrowOutput( t->mem, dataOut, &dataOutSize, index + 1 );
             dataOut[ index++ ] = t->escape;
             t->state = normalState;
         } else {
@@ -1243,10 +1251,7 @@ void MTX_RUNLENGTHCOMP_SaveBytes( register RUNLENGTHCOMP *t, unsigned char value
     } else if ( t->state == needByteState ) {
         register int i;
         
-        if ( index + (long)t->count > dataOutSize ) {
-            dataOutSize = index + (long)t->count + (dataOutSize>>1); /* Allocate in exponentially increasing steps */
-            dataOut = (unsigned char *)MTX_mem_realloc( t->mem, dataOut, dataOutSize );
-        }
+        if ( index + (long)t->count > dataOutSize ) dataOut = GrowOutput( t->mem, dataOut, &dataOutSize, index + (long)t->count );
         /* for ( i = 0; i < t->count; i++ ) */
         for ( i = t->count; i > 0; i-- ) {
             dataOut[ index++ ] = value;
