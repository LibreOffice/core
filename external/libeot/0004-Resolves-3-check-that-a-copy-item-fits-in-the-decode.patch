From ec94bad0a80cb3048f42a9b117e6e045b68bfa80 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Caol=C3=A1n=20McNamara?= <caolan.mcnamara@collabora.com>
Date: Sun, 8 Nov 2026 17:23:37 +0000
Subject: [PATCH 4/5] Resolves #3 check that a copy item fits in the decoded
 length

---
 src/lzcomp/lzcomp.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/src/lzcomp/lzcomp.c b/src/lzcomp/lzcomp.c
index fd6d000..e999fb5 100644
--- a/src/lzcomp/lzcomp.c
+++ b/src/lzcomp/lzcomp.c
@@ -766,6 +766,7 @@ static unsigned char *Decode( register LZCOMP *t, long *size )
                 distance    = DecodeDistance2( t, numDistRanges );
                 if ( distance >=max_2Byte_Dist  ) length++;
                 start        = pos - distance - length + 1;
+                if ( length > t->out_len - pos ) longjmp( t->mem->env, ERR_LZCOMP_Decode_bounds );
                 for ( j = 0; j < length; j++ ) {
                     value = ptr1[ start + j ];
                     ptr1[ pos++ ] = value;
@@ -827,6 +828,7 @@ static unsigned char *Decode( register LZCOMP *t, long *size )
                 if ( distance >=max_2Byte_Dist  ) length++;
                 start        = dst - distance - length + 1;
                 assert( distance + length - 1 <= t->maxCopyDistance );
+                if ( length > t->out_len - pos ) longjmp( t->mem->env, ERR_LZCOMP_Decode_bounds );
                 for ( j = 0; j < length; j++ ) {
                     src = start + j;
                     if ( src < 0 ) src = src + t->maxCopyDistance;
-- 
