From bf1fd3625d3a8058d1cf1db3c913d33ef15a0cb4 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Caol=C3=A1n=20McNamara?= <caolan.mcnamara@collabora.com>
Date: Sun, 8 Nov 2026 18:11:00 +0000
Subject: [PATCH 10/11] stop DecodeLength once the length passes out_len

Each continuation symbol shifts the value left with no limit, so a
long run of them overflowed the signed long. No valid length can be
more than out_len.
---
 src/lzcomp/lzcomp.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/src/lzcomp/lzcomp.c b/src/lzcomp/lzcomp.c
index 2a37b61..b77ef27 100644
--- a/src/lzcomp/lzcomp.c
+++ b/src/lzcomp/lzcomp.c
@@ -242,6 +242,7 @@ static long DecodeLength( LZCOMP *t, int symbol, long *numDistRanges )
         bits &= ~mask;
         value <<= bit_Range;
         value |= bits;
+        if ( value > t->out_len ) longjmp( t->mem->env, ERR_LZCOMP_Decode_bounds );
     } while ( !done );
     
     value += len_min;
