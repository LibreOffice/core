<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:presentation="urn:oasis:names:tc:opendocument:xmlns:presentation:1.0" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:form="urn:oasis:names:tc:opendocument:xmlns:form:1.0" xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:ooo="http://openoffice.org/2004/office" office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.presentation">
  <office:automatic-styles>
    <style:page-layout style:name="PM1">
      <style:page-layout-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:margin-left="0cm" fo:margin-right="0cm" fo:page-width="28cm" fo:page-height="15.75cm" style:print-orientation="landscape"/>
    </style:page-layout>
    <style:style style:name="dp1" style:family="drawing-page"/>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="PM1" draw:style-name="dp1"/>
  </office:master-styles>
  <office:body>
    <office:presentation>
      <draw:page draw:name="slide1" draw:style-name="dp1" draw:master-page-name="Default">
        <office:forms form:automatic-focus="false" form:apply-design-mode="false">
          <form:form form:name="Form" form:control-implementation="ooo:com.sun.star.form.component.Form">
            <form:checkbox form:name="Agree" form:control-implementation="ooo:com.sun.star.form.component.CheckBox" form:id="control1" form:label="Agree" form:tab-index="3"/>
            <form:text form:name="Name" form:control-implementation="ooo:com.sun.star.form.component.TextField" form:id="control2" form:current-value="Alice" form:value="Alice" form:tab-index="1"/>
            <form:formatted-text form:name="Amount" form:control-implementation="ooo:com.sun.star.form.component.NumericField" form:id="control3" form:tab-index="2"/>
            <form:radio form:name="Answer" form:control-implementation="ooo:com.sun.star.form.component.RadioButton" form:id="control4" form:label="Yes" form:tab-index="4"/>
            <form:listbox form:name="Colour" form:control-implementation="ooo:com.sun.star.form.component.ListBox" form:id="control5" form:dropdown="true" form:size="1" form:tab-index="5">
              <form:option form:label="Red" form:selected="true" form:current-selected="true"/>
              <form:option form:label="Green"/>
              <form:option form:label="Blue"/>
            </form:listbox>
            <form:listbox form:name="Count" form:control-implementation="ooo:com.sun.star.form.component.ListBox" form:id="control6" form:dropdown="false" form:size="3" form:tab-index="6">
              <form:option form:label="One" form:selected="true" form:current-selected="true"/>
              <form:option form:label="Two"/>
              <form:option form:label="Three"/>
            </form:listbox>
            <form:button form:name="Press" form:control-implementation="ooo:com.sun.star.form.component.CommandButton" form:id="control7" form:label="Press" form:button-type="push" form:tab-stop="false" form:tab-index="7"/>
            <form:date form:name="Day" form:control-implementation="ooo:com.sun.star.form.component.DateField" form:id="control8" form:tab-index="8">
              <form:properties>
                <form:property form:property-name="Dropdown" office:value-type="boolean" office:boolean-value="true"/>
              </form:properties>
            </form:date>
            <form:time form:name="Hour" form:control-implementation="ooo:com.sun.star.form.component.TimeField" form:id="control9" form:tab-index="9"/>
            <form:text form:name="Fixed" form:control-implementation="ooo:com.sun.star.form.component.TextField" form:id="control10" form:current-value="Fixed" form:value="Fixed" form:readonly="true" form:tab-index="10"/>
            <form:text form:name="Off" form:control-implementation="ooo:com.sun.star.form.component.TextField" form:id="control11" form:current-value="Off" form:value="Off" form:disabled="true" form:tab-index="11"/>
            <form:fixed-text form:name="Caption" form:control-implementation="ooo:com.sun.star.form.component.FixedText" form:id="control12" form:label="Label"/>
            <form:formatted-text form:name="Phone" form:control-implementation="ooo:com.sun.star.form.component.PatternField" form:id="control13" form:tab-index="12">
              <form:properties>
                <form:property form:property-name="EditMask" office:value-type="string" office:string-value="LNNNLLNNNLNNNN"/>
                <form:property form:property-name="LiteralMask" office:value-type="string" office:string-value="(___) ___-____"/>
                <form:property form:property-name="StrictFormat" office:value-type="boolean" office:boolean-value="true"/>
              </form:properties>
            </form:formatted-text>
            <form:listbox form:name="Size" form:control-implementation="ooo:com.sun.star.form.component.ListBox" form:id="control14" form:dropdown="true" form:size="1" form:tab-index="13">
              <form:properties>
                <form:property form:property-name="ReadOnly" office:value-type="boolean" office:boolean-value="true"/>
              </form:properties>
              <form:option form:label="Small" form:selected="true" form:current-selected="true"/>
              <form:option form:label="Large"/>
            </form:listbox>
          </form:form>
        </office:forms>
        <draw:control draw:layer="controls" svg:x="2cm" svg:y="1.5cm" svg:width="5cm" svg:height="1cm" draw:control="control1"/>
        <draw:control draw:layer="controls" svg:x="2cm" svg:y="3cm" svg:width="5cm" svg:height="1cm" draw:control="control2"/>
        <draw:control draw:layer="controls" svg:x="2cm" svg:y="4.5cm" svg:width="5cm" svg:height="1cm" draw:control="control3"/>
        <draw:control draw:layer="controls" svg:x="2cm" svg:y="6cm" svg:width="5cm" svg:height="1cm" draw:control="control4"/>
        <draw:control draw:layer="controls" svg:x="2cm" svg:y="7.5cm" svg:width="5cm" svg:height="1cm" draw:control="control5"/>
        <draw:control draw:layer="controls" svg:x="9cm" svg:y="1.5cm" svg:width="5cm" svg:height="3cm" draw:control="control6"/>
        <draw:control draw:layer="controls" svg:x="9cm" svg:y="5cm" svg:width="5cm" svg:height="1cm" draw:control="control7"/>
        <draw:control draw:layer="controls" svg:x="9cm" svg:y="6.5cm" svg:width="5cm" svg:height="1cm" draw:control="control8"/>
        <draw:control draw:layer="controls" svg:x="9cm" svg:y="8cm" svg:width="5cm" svg:height="1cm" draw:control="control9"/>
        <draw:control draw:layer="controls" svg:x="16cm" svg:y="1.5cm" svg:width="5cm" svg:height="1cm" draw:control="control10"/>
        <draw:control draw:layer="controls" svg:x="16cm" svg:y="3cm" svg:width="5cm" svg:height="1cm" draw:control="control11"/>
        <draw:control draw:layer="controls" svg:x="16cm" svg:y="4.5cm" svg:width="5cm" svg:height="1cm" draw:control="control12"/>
        <draw:control draw:layer="controls" svg:x="16cm" svg:y="6cm" svg:width="5cm" svg:height="1cm" draw:control="control13"/>
        <draw:control draw:layer="controls" svg:x="16cm" svg:y="7.5cm" svg:width="5cm" svg:height="1cm" draw:control="control14"/>
      </draw:page>
    </office:presentation>
  </office:body>
</office:document>
