 </office:font-face-decls>
 <office:styles>
  <style:default-style style:family="paragraph">
   <style:text-properties style:font-name="Liberation Serif" fo:font-size="12pt"/>
  </style:default-style>
 </office:styles>
 <office:body>
  <office:text>
   <text:p>Before <draw:frame draw:name="Image1" text:anchor-type="as-char" svg:width="0.2in" svg:height="0.2in"><draw:image draw:mime-type="image/png"><office:binary-data>iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR4nGNgYPj/HwADAgH/eL9GtQ==</office:binary-data></draw:image><svg:title>A red square</svg:title><svg:desc>A small square filled with red</svg:desc></draw:frame> after.</text:p>
   <text:p>Ending with <draw:frame draw:name="Image2" text:anchor-type="as-char" svg:width="0.2in" svg:height="0.2in"><draw:image draw:mime-type="image/png"><office:binary-data>iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR4nGNgYPj/HwADAgH/eL9GtQ==</office:binary-data></draw:image><svg:title>A second square</svg:title></draw:frame></text:p>
  </office:text>
 </office:body>
