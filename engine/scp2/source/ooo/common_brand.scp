#if defined WNT
#define CONFIGURATION_LAYERS_WINREG " winreg:LOCAL_MACHINE"
#define CONFIGURATION_LAYERS_WINUSERREG " winreg:CURRENT_USER"
#else
#define CONFIGURATION_LAYERS_WINREG
#define CONFIGURATION_LAYERS_WINUSERREG
#endif
ProfileItem gid_Brand_Profileitem_Fundamental_Configuration_Layers
    ProfileID = gid_Brand_Profile_Fundamental_Ini;
    ModuleID = gid_Module_Root_Brand;
    Section = "Bootstrap";
    Key = "CONFIGURATION_LAYERS";
    // The "sharedext" layer holds the shared AutoText, Dictionary and Template
    // paths that desktop/source/lib/init.cxx files into it at run time. The ini
    // does not exist; the layer starts out empty. It ranks above the shipped
    // defaults and below the user's own settings.
    Value = "xcsxcu:${BRAND_BASE_DIR}/" LIBO_SHARE_FOLDER "/registry res:${BRAND_BASE_DIR}/" LIBO_SHARE_FOLDER "/registry" CONFIGURATION_LAYERS_WINREG " sharedext:${BRAND_BASE_DIR}/" LIBO_SHARE_FOLDER "/registry/sharedext.ini" CONFIGURATION_LAYERS_WINUSERREG " user:!${$BRAND_BASE_DIR/" LIBO_ETC_FOLDER "/" PROFILENAME(bootstrap) ":UserInstallation}/user/registrymodifications.xcu";
End
#undef CONFIGURATION_LAYERS_WINREG
#undef CONFIGURATION_LAYERS_WINUSERREG

