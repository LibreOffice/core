 src/OdgGenerator.cxx  |   1 +
 src/OdpGenerator.cxx  |   1 +
 src/OdsGenerator.cxx  |   1 +
 src/OdtGenerator.cxx  |   1 +
 test/testGraphic1.cxx |  25 ++++++++
 6 files changed, 166 insertions(+), 6 deletions(-)

diff --git a/src/FillManager.cxx b/src/FillManager.cxx
index 8bc8d7d..419931b 100644
--- a/src/FillManager.cxx
+++ b/src/FillManager.cxx
@@ -22,11 +22,92 @@
 
 #include "FillManager.hxx"
 
+#include <algorithm>
+#include <cmath>
+#include <locale>
+#include <sstream>
+#include <vector>
+
 #include <librevenge/librevenge.h>
 
 #include "FilterInternal.hxx"
 #include "DocumentElement.hxx"
 
+namespace
+{
+
+//! reads a value in [0, 1] given as "0.5" or "50%"
+bool getFractionValue(librevenge::RVNGProperty const *prop, double &value)
+{
+	if (!prop)
+		return false;
+	std::istringstream stream(prop->getStr().cstr());
+	stream.imbue(std::locale::classic());
+	double val = 0;
+	stream >> val;
+	if (stream.fail() || !std::isfinite(val))
+		return false;
+	if (stream.peek() == '%')
+		val /= 100;
+	value = std::max(0., std::min(1., val));
+	return true;
+}
+
+struct GradientStop
+{
+	GradientStop() : offset(0), colour(), opacity(1) {}
+	//! the offset in ODF's order: 0 at draw:start-color
+	double offset;
+	librevenge::RVNGString colour;
+	double opacity;
+};
+
+/** Returns the stops of a gradient vector in ODF's order.
+
+	As draw:start-color and draw:end-color are taken from the vector,
+	its last stop is at the start of the gradient and its first one is at
+	the end: a stop's offset in ODF is 1 - svg:offset. A stop without an
+	svg:offset is placed as if the stops were evenly spaced.
+ */
+std::vector<GradientStop> getOdfGradientStops(librevenge::RVNGPropertyListVector const &gradient)
+{
+	std::vector<GradientStop> stops;
+	unsigned long const count = gradient.count();
+	for (unsigned long i = count; i > 0;)
+	{
+		--i;
+		librevenge::RVNGPropertyList const &stop = gradient[i];
+		double offset = count > 1 ? double(i) / double(count - 1) : 0;
+		getFractionValue(stop["svg:offset"], offset);
+		GradientStop odfStop;
+		odfStop.offset = 1 - offset;
+		if (stop["svg:stop-color"])
+			odfStop.colour = stop["svg:stop-color"]->getStr();
+		getFractionValue(stop["svg:stop-opacity"], odfStop.opacity);
+		stops.push_back(odfStop);
+	}
+	std::stable_sort(stops.begin(), stops.end(), [](GradientStop const &a, GradientStop const &b)
+	{
+		return a.offset < b.offset;
+	});
+	return stops;
+}
+
+//! whether the start and the end values alone would lose some of the stops
+bool needStopElements(std::vector<GradientStop> const &stops)
+{
+	if (stops.size() > 2)
+		return true;
+	for (GradientStop const &stop : stops)
+	{
+		if (stop.offset > 0 && stop.offset < 1)
+			return true;
+	}
+	return false;
+}
+
+}
+
 void FillManager::clean()
 {
 	mBitmapStyles.clear();
@@ -177,12 +258,16 @@ librevenge::RVNGString FillManager::getStyleNameForGradient(librevenge::RVNGProp
 	}
 	else if (gradient->count() >= 2)
 	{
-		if ((*gradient)[1]["svg:stop-color"])
-			openElement->addAttribute("draw:start-color", (*gradient)[1]["svg:stop-color"]->getStr());
+		unsigned long const last = gradient->count() - 1;
+		if ((*gradient)[last]["svg:stop-color"])
+			openElement->addAttribute("draw:start-color", (*gradient)[last]["svg:stop-color"]->getStr());
 		if ((*gradient)[0]["svg:stop-color"])
 			openElement->addAttribute("draw:end-color", (*gradient)[0]["svg:stop-color"]->getStr());
-		if ((*gradient)[0]["svg:stop-opacity"] || (*gradient)[1]["svg:stop-opacity"])
-			needCreateOpacityStyle=true;
+		for (unsigned long i = 0; i <= last; ++i)
+		{
+			if ((*gradient)[i]["svg:stop-opacity"])
+				needCreateOpacityStyle=true;
+		}
 		openElement->addAttribute("draw:border", "0%");
 	}
 	else
@@ -191,6 +276,25 @@ librevenge::RVNGString FillManager::getStyleNameForGradient(librevenge::RVNGProp
 	}
 
 	mGradientStyles.push_back(openElement);
+	// stops that the start and end colours cannot express: loext:gradient-stop
+	if (gradient && gradient->count() >= 2)
+	{
+		std::vector<GradientStop> const stops = getOdfGradientStops(*gradient);
+		if (needStopElements(stops))
+		{
+			for (GradientStop const &stop : stops)
+			{
+				if (stop.colour.empty())
+					continue;
+				std::shared_ptr<TagOpenElement> stopElement = std::make_shared<TagOpenElement>("loext:gradient-stop");
+				stopElement->addAttribute("svg:offset", libodfgen::doubleToString(stop.offset));
+				stopElement->addAttribute("loext:color-type", "rgb");
+				stopElement->addAttribute("loext:color-value", stop.colour);
+				mGradientStyles.push_back(stopElement);
+				mGradientStyles.push_back(std::make_shared<TagCloseElement>("loext:gradient-stop"));
+			}
+		}
+	}
 	mGradientStyles.push_back(std::make_shared<TagCloseElement>("draw:gradient"));
 	return name;
 }
@@ -278,12 +382,30 @@ librevenge::RVNGString FillManager::getStyleNameForOpacity(librevenge::RVNGPrope
 	const librevenge::RVNGPropertyListVector *gradient = style.child("svg:linearGradient");
 	if (!gradient)
 		gradient = style.child("svg:radialGradient");
+	std::vector<GradientStop> stops;
 	if (gradient && gradient->count() >= 2)
 	{
-		if ((*gradient)[1]["svg:stop-opacity"])
-			pList.insert("draw:start", (*gradient)[1]["svg:stop-opacity"]->getStr());
+		unsigned long const last = gradient->count() - 1;
+		if ((*gradient)[last]["svg:stop-opacity"])
+			pList.insert("draw:start", (*gradient)[last]["svg:stop-opacity"]->getStr());
 		if ((*gradient)[0]["svg:stop-opacity"])
 			pList.insert("draw:end", (*gradient)[0]["svg:stop-opacity"]->getStr());
+		stops = getOdfGradientStops(*gradient);
+		if (needStopElements(stops))
+		{
+			librevenge::RVNGPropertyListVector opacities;
+			for (GradientStop const &stop : stops)
+			{
+				librevenge::RVNGPropertyList opacity;
+				opacity.insert("svg:offset", stop.offset);
+				opacity.insert("svg:stop-opacity", stop.opacity);
+				opacities.append(opacity);
+			}
+			// (in the key: transparencies that differ only in their stops are different)
+			pList.insert("librevenge:opacity-stops", opacities);
+		}
+		else
+			stops.clear();
 	}
 	// prepare angle: ODG angle unit is 0.1 degree
 	librevenge::RVNGString angleValue;
@@ -341,6 +463,15 @@ librevenge::RVNGString FillManager::getStyleNameForOpacity(librevenge::RVNGPrope
 		openElement->addAttribute("draw:end", pList["draw:end"]->getStr());
 
 	mOpacityStyles.push_back(openElement);
+	// stops that the start and end values cannot express: loext:opacity-stop
+	for (GradientStop const &stop : stops)
+	{
+		std::shared_ptr<TagOpenElement> stopElement = std::make_shared<TagOpenElement>("loext:opacity-stop");
+		stopElement->addAttribute("svg:offset", libodfgen::doubleToString(stop.offset));
+		stopElement->addAttribute("svg:stop-opacity", libodfgen::doubleToString(stop.opacity));
+		mOpacityStyles.push_back(stopElement);
+		mOpacityStyles.push_back(std::make_shared<TagCloseElement>("loext:opacity-stop"));
+	}
 	mOpacityStyles.push_back(std::make_shared<TagCloseElement>("draw:opacity"));
 	return name;
 }
