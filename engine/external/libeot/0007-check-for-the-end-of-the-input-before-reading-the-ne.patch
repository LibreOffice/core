From 5e26e8961ca867d4267a0524ac0abd6bef69c6d8 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Caol=C3=A1n=20McNamara?= <caolan.mcnamara@collabora.com>
Date: Sun, 8 Nov 2026 18:10:37 +0000
Subject: [PATCH 07/11] check for the end of the input before reading the next
 byte

---
 src/lzcomp/bitio.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/lzcomp/bitio.c b/src/lzcomp/bitio.c
index b3638ea..cdf62a9 100644
--- a/src/lzcomp/bitio.c
+++ b/src/lzcomp/bitio.c
@@ -42,10 +42,10 @@ short MTX_BITIO_input_bit( register BITIO *t )
 {
     /*assert( t->ReadOrWrite == 'r' ); */
     if ( t->input_bit_count-- == 0 ) {
-        t->input_bit_buffer = t->mem_bytes[ t->mem_index++ ];
-        if ( t->mem_index > t->mem_size ) {
+        if ( t->mem_index >= t->mem_size ) {
             longjmp( t->mem->env, ERR_BITIO_end_of_file );
         }
+        t->input_bit_buffer = t->mem_bytes[ t->mem_index++ ];
         ++(t->bytes_in);
         t->input_bit_count = 7;
     }
-- 
