From 971aab4f8f407acc4d8d34241269ea94a53e2a94 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Caol=C3=A1n=20McNamara?= <caolan.mcnamara@collabora.com>
Date: Sun, 8 Nov 2026 17:22:55 +0000
Subject: [PATCH 1/5] compare a stream copy's length with the room left, not
 pos + length

---
 src/util/stream.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/util/stream.c b/src/util/stream.c
index 27571b3..917f214 100644
--- a/src/util/stream.c
+++ b/src/util/stream.c
@@ -293,11 +293,11 @@ enum StreamResult streamCopy(struct Stream *sIn, struct Stream *sOut, unsigned l
   {
     return EOT_OFF_BYTE_BOUNDARY;
   }
-  if (sIn->pos + length > sIn->size)
+  if (length > sIn->size || sIn->pos > sIn->size - length)
   {
     return EOT_NOT_ENOUGH_DATA;
   }
-  if (sOut->pos + length > sOut->reserved)
+  if (length > sOut->reserved || sOut->pos > sOut->reserved - length)
   {
     return EOT_OUT_OF_RESERVED_SPACE;
   }
-- 
