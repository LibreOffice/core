From b8ddacac9d03636ac96f8e21d97d66d132e0e7d9 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Caol=C3=A1n=20McNamara?= <caolan.mcnamara@collabora.com>
Date: Sun, 8 Nov 2026 18:10:30 +0000
Subject: [PATCH 06/11] set the jmp_buf that the decoder's error paths longjmp
 to

Nothing called setjmp on t->mem->env, so do it in
MTX_LZCOMP_UnPackMemory, and on a decode error free the decoder
state and return NULL
---
 src/lzcomp/LZCOMP.H |  2 ++
 src/lzcomp/lzcomp.c | 70 +++++++++++++++++++++++++++++++--------------
 2 files changed, 50 insertions(+), 22 deletions(-)

diff --git a/src/lzcomp/LZCOMP.H b/src/lzcomp/LZCOMP.H
index 53b85c2..11b3048 100644
--- a/src/lzcomp/LZCOMP.H
+++ b/src/lzcomp/LZCOMP.H
@@ -44,6 +44,8 @@ typedef struct {
     char filler1, filer2, filler3;
     /* New August 1, 1996 */
     RUNLENGTHCOMP *rlComp;
+    /* The output of a decode in progress */
+    unsigned char *dataOut;
     short usingRunLength;
     
     long length1, out_len;
diff --git a/src/lzcomp/lzcomp.c b/src/lzcomp/lzcomp.c
index e999fb5..b6dff21 100644
--- a/src/lzcomp/lzcomp.c
+++ b/src/lzcomp/lzcomp.c
@@ -738,10 +738,9 @@ static unsigned char *Decode( register LZCOMP *t, long *size )
     register unsigned char value;
     register int usingRunLength = t->usingRunLength;
     long dataOutSize, index = 0;
-    unsigned char *dataOut;
     const long preLoadSize = 2*32*96 + 4*256;
     
-    dataOut = (unsigned char *)MTX_mem_malloc( t->mem, dataOutSize = t->out_len );
+    t->dataOut = (unsigned char *)MTX_mem_malloc( t->mem, dataOutSize = t->out_len );
 
     InitializeModel( t, false );
     if ( !t->ptr1_IsSizeLimited ) {
@@ -771,14 +770,14 @@ static unsigned char *Decode( register LZCOMP *t, long *size )
                     value = ptr1[ start + j ];
                     ptr1[ pos++ ] = value;
                     if ( usingRunLength ) {
-                        MTX_RUNLENGTHCOMP_SaveBytes( t->rlComp, value, &dataOut, &dataOutSize, &index );
+                        MTX_RUNLENGTHCOMP_SaveBytes( t->rlComp, value, &t->dataOut, &dataOutSize, &index );
                     } else {
                         assert( index <= dataOutSize );
                         if ( index >=dataOutSize ) {
                             dataOutSize += (dataOutSize>>1) + 1; /* Allocate in exponentially increasing steps */
-                            dataOut = (unsigned char *)MTX_mem_realloc( t->mem, dataOut, dataOutSize );
+                            t->dataOut = (unsigned char *)MTX_mem_realloc( t->mem, t->dataOut, dataOutSize );
                         }
-                        dataOut[ index++ ] = value;
+                        t->dataOut[ index++ ] = value;
                         /*fputc( value, fpOut ); */
                     }
                 }
@@ -786,14 +785,14 @@ static unsigned char *Decode( register LZCOMP *t, long *size )
             }
             ptr1[ pos++ ] = value;
             if ( usingRunLength ) {
-                MTX_RUNLENGTHCOMP_SaveBytes( t->rlComp, value, &dataOut, &dataOutSize, &index );
+                MTX_RUNLENGTHCOMP_SaveBytes( t->rlComp, value, &t->dataOut, &dataOutSize, &index );
             } else {
                 assert( index <= dataOutSize );
                 if ( index >=dataOutSize ) {
                     dataOutSize += (dataOutSize>>1) + 1; /* Allocate in exponentially increasing steps */
-                    dataOut = (unsigned char *)MTX_mem_realloc( t->mem, dataOut, dataOutSize );
+                    t->dataOut = (unsigned char *)MTX_mem_realloc( t->mem, t->dataOut, dataOutSize );
                 }
-                dataOut[ index++ ] = value;
+                t->dataOut[ index++ ] = value;
                 /*fputc( value, fpOut ); */
             }
         }
@@ -837,14 +836,14 @@ static unsigned char *Decode( register LZCOMP *t, long *size )
                     dst = (dst + 1) % t->maxCopyDistance;
                     pos++;
                     if ( usingRunLength ) {
-                        MTX_RUNLENGTHCOMP_SaveBytes( t->rlComp, value, &dataOut, &dataOutSize, &index );
+                        MTX_RUNLENGTHCOMP_SaveBytes( t->rlComp, value, &t->dataOut, &dataOutSize, &index );
                     } else {
                         assert( index <= dataOutSize );
                         if ( index >=dataOutSize ) {
                             dataOutSize += (dataOutSize>>1) + 1; /* Allocate in exponentially increasing steps */
-                            dataOut = (unsigned char *)MTX_mem_realloc( t->mem, dataOut, dataOutSize );
+                            t->dataOut = (unsigned char *)MTX_mem_realloc( t->mem, t->dataOut, dataOutSize );
                         }
-                        dataOut[ index++ ] = value;
+                        t->dataOut[ index++ ] = value;
                         /*fputc( value, fpOut ); */
                     }
                 }
@@ -854,14 +853,14 @@ static unsigned char *Decode( register LZCOMP *t, long *size )
             dst = (dst + 1) % t->maxCopyDistance;
             pos++;
             if ( usingRunLength ) {
-                MTX_RUNLENGTHCOMP_SaveBytes( t->rlComp, value, &dataOut, &dataOutSize, &index );
+                MTX_RUNLENGTHCOMP_SaveBytes( t->rlComp, value, &t->dataOut, &dataOutSize, &index );
             } else {
                 assert( index <= dataOutSize );
                 if ( index >=dataOutSize ) {
                     dataOutSize += (dataOutSize>>1) + 1; /* Allocate in exponentially increasing steps */
-                    dataOut = (unsigned char *)MTX_mem_realloc( t->mem, dataOut, dataOutSize );
+                    t->dataOut = (unsigned char *)MTX_mem_realloc( t->mem, t->dataOut, dataOutSize );
                 }
-                dataOut[ index++ ] = value;
+                t->dataOut[ index++ ] = value;
                 /*fputc( value, fpOut ); */
             }
         }
@@ -872,9 +871,9 @@ static unsigned char *Decode( register LZCOMP *t, long *size )
     *size = index;
     assert( dataOutSize >=*size );
     if ( t->usingRunLength ) {
-        dataOut = (unsigned char *)MTX_mem_realloc( t->mem, dataOut, *size ); /* Free up some memory if possible */
+        t->dataOut = (unsigned char *)MTX_mem_realloc( t->mem, t->dataOut, *size ); /* Free up some memory if possible */
     }
-    return dataOut; /******/
+    return t->dataOut; /******/
 }
 
 
@@ -977,6 +976,23 @@ unsigned char *MTX_LZCOMP_PackMemory( register LZCOMP *t, void *dataIn, long siz
 #endif /* COMPRESS_ON */
 
 #ifdef DECOMPRESS_ON
+/* Frees what MTX_LZCOMP_UnPackMemory allocates, except ptr1 */
+static void FreeDecodeState( LZCOMP *t )
+{
+    if ( t->dist_ecoder ) MTX_AHUFF_Destroy( t->dist_ecoder );
+    t->dist_ecoder = NULL;
+    if ( t->len_ecoder ) MTX_AHUFF_Destroy( t->len_ecoder );
+    t->len_ecoder = NULL;
+    if ( t->sym_ecoder ) MTX_AHUFF_Destroy( t->sym_ecoder );
+    t->sym_ecoder = NULL;
+    if ( t->bitIn ) MTX_BITIO_Destroy( t->bitIn );
+    t->bitIn = NULL;
+    if ( t->rlComp ) MTX_RUNLENGTHCOMP_Destroy( t->rlComp );
+    t->rlComp = NULL;
+    MTX_mem_free( t->mem, t->dataOut );
+    t->dataOut = NULL;
+}
+
 /* Call this method to un-compress memory */
 unsigned char *MTX_LZCOMP_UnPackMemory( register LZCOMP *t, void *dataIn, long dataInSize, long *sizeOut, unsigned char version )
 {
@@ -993,6 +1009,20 @@ unsigned char *MTX_LZCOMP_UnPackMemory( register LZCOMP *t, void *dataIn, long d
         MTX_mem_free( t->mem, t->ptr1 );
     }
     t->ptr1 = NULL;
+    t->rlComp = NULL;
+    t->bitIn = NULL;
+    t->dist_ecoder = NULL;
+    t->len_ecoder = NULL;
+    t->sym_ecoder = NULL;
+    t->dataOut = NULL;
+    *sizeOut = 0;
+
+    /* Errors while decoding longjmp back here */
+    if ( setjmp( t->mem->env ) != 0 ) {
+        FreeDecodeState( t );
+        return NULL;
+    }
+
     t->rlComp = MTX_RUNLENGTHCOMP_Create( t->mem );
     
     
@@ -1019,13 +1049,9 @@ unsigned char *MTX_LZCOMP_UnPackMemory( register LZCOMP *t, void *dataIn, long d
 
     assert( t->sym_ecoder != NULL );
     dataOut = Decode( t, sizeOut); /* Do the work ! */
+    t->dataOut = NULL;
 
-    MTX_AHUFF_Destroy( t->dist_ecoder );     t->dist_ecoder = NULL;
-    MTX_AHUFF_Destroy( t->len_ecoder  );    t->len_ecoder  = NULL;
-    MTX_AHUFF_Destroy( t->sym_ecoder  );     t->sym_ecoder  = NULL;
-    
-    MTX_BITIO_Destroy( t->bitIn );             t->bitIn = NULL;
-    MTX_RUNLENGTHCOMP_Destroy( t->rlComp );    t->rlComp = NULL;
+    FreeDecodeState( t );
     
     assert( t->usingRunLength || *sizeOut < maxOutSize );
 
