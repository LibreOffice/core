From e0c2809626418f529b635f2249fa4cb83238996f Mon Sep 17 00:00:00 2001
From: Brennan Vincent <brennan@umanwizard.com>
Date: Sun, 8 Nov 2026 17:23:43 +0000
Subject: [PATCH 5/5] fix another use of uninitialized value

---
 src/lzcomp/liblzcomp.c | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/src/lzcomp/liblzcomp.c b/src/lzcomp/liblzcomp.c
index 365dc1c..4371346 100644
--- a/src/lzcomp/liblzcomp.c
+++ b/src/lzcomp/liblzcomp.c
@@ -28,12 +28,13 @@ enum EOTError unpackMtx(struct Stream *buf, unsigned size, uint8_t **bufsOut, un
 	}
 	enum StreamResult sResult;
 	enum EOTError returnedStatus = EOT_SUCCESS;
+	LZCOMP *lzcomp = NULL;
 	MTX_MemHandler *mem = MTX_mem_Create(&malloc, &realloc, &free);
 	if (!mem)
 	{
 		goto CLEANUP;
 	}
-	LZCOMP *lzcomp = MTX_LZCOMP_Create1(mem);
+	lzcomp = MTX_LZCOMP_Create1(mem);
 	if (!lzcomp)
 	{
 		goto CLEANUP;
@@ -69,7 +70,10 @@ enum EOTError unpackMtx(struct Stream *buf, unsigned size, uint8_t **bufsOut, un
 		}
 	}
 CLEANUP:
-	MTX_LZCOMP_Destroy(lzcomp);
+	if (lzcomp)
+	{
+		MTX_LZCOMP_Destroy(lzcomp);
+	}
 	free(mem);
 	return returnedStatus;
 }
