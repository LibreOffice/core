From 1438fe9ba22bd1a8179894799baea85825e29e4d Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Caol=C3=A1n=20McNamara?= <caolan.mcnamara@collabora.com>
Date: Sun, 8 Nov 2026 18:11:16 +0000
Subject: [PATCH 11/11] check the results of the MTX_mem allocations

Nothing looked at what MTX_mem_malloc or MTX_mem_realloc returned, so
make them longjmp to the decoder's error path when they fail. The
constructors run before that jmp_buf is set, so they check for NULL
themselves, and unpackMtx reports EOT_CANT_ALLOCATE_MEMORY if they fail.
---
 src/lzcomp/ERRCODES.H  |  1 +
 src/lzcomp/MTXMEM.H    |  1 +
 src/lzcomp/liblzcomp.c |  2 ++
 src/lzcomp/lzcomp.c    |  6 ++++--
 src/lzcomp/mtxmem.c    | 13 +++++++++++--
 5 files changed, 19 insertions(+), 4 deletions(-)

diff --git a/src/lzcomp/ERRCODES.H b/src/lzcomp/ERRCODES.H
index 08d70f7..c0abcea 100644
--- a/src/lzcomp/ERRCODES.H
+++ b/src/lzcomp/ERRCODES.H
@@ -2,3 +2,4 @@
 #define ERR_BITIO_end_of_file      3304 /*BITIO::input_bit:UNEXPECTED END OF FILE*/
 #define ERR_LZCOMP_Encode_bounds    3353 /*LZCOMP:Encode out of bounds i*/
 #define ERR_LZCOMP_Decode_bounds    3354 /*LZCOMP::Decode out of bounds pos*/
+#define ERR_MTX_mem_alloc           3355 /*MTX_mem: allocation failed*/
diff --git a/src/lzcomp/MTXMEM.H b/src/lzcomp/MTXMEM.H
index 1459196..d1eb271 100644
--- a/src/lzcomp/MTXMEM.H
+++ b/src/lzcomp/MTXMEM.H
@@ -53,6 +53,7 @@ void MTX_mem_CloseMemory( MTX_MemHandler *t ); /*  Frees internal memory and for
 void MTX_mem_FreeAllMemory( MTX_MemHandler *t ); /* Always call if the code throws an exception */
 
 
+/* On failure these longjmp to env, and realloc leaves p allocated */
 void *MTX_mem_malloc(MTX_MemHandler *t, unsigned long size);
 void *MTX_mem_realloc(MTX_MemHandler *t, void *p, unsigned long size);
 void  MTX_mem_free(MTX_MemHandler *t, void *deadObject);
diff --git a/src/lzcomp/liblzcomp.c b/src/lzcomp/liblzcomp.c
index 8ec458e..4f34546 100644
--- a/src/lzcomp/liblzcomp.c
+++ b/src/lzcomp/liblzcomp.c
@@ -32,11 +32,13 @@ enum EOTError unpackMtx(struct Stream *buf, unsigned size, uint8_t **bufsOut, un
 	MTX_MemHandler *mem = MTX_mem_Create(&malloc, &realloc, &free);
 	if (!mem)
 	{
+		returnedStatus = EOT_CANT_ALLOCATE_MEMORY;
 		goto CLEANUP;
 	}
 	lzcomp = MTX_LZCOMP_Create1(mem);
 	if (!lzcomp)
 	{
+		returnedStatus = EOT_CANT_ALLOCATE_MEMORY;
 		goto CLEANUP;
 	}
 	uint8_t versionMagic;
diff --git a/src/lzcomp/lzcomp.c b/src/lzcomp/lzcomp.c
index b77ef27..b53a5e4 100644
--- a/src/lzcomp/lzcomp.c
+++ b/src/lzcomp/lzcomp.c
@@ -1074,7 +1074,8 @@ unsigned char *MTX_LZCOMP_UnPackMemory( register LZCOMP *t, void *dataIn, long d
 LZCOMP *MTX_LZCOMP_Create1( MTX_MemHandler *mem  )
 {
     const short hNodeAllocSize = 4095;
-    LZCOMP *t    = (LZCOMP *)MTX_mem_malloc( mem, sizeof( LZCOMP ) );
+    LZCOMP *t    = (LZCOMP *)mem->malloc( sizeof( LZCOMP ) );
+    if ( !t ) return NULL;
     t->mem        = mem;
     
     t->ptr1                = NULL;
@@ -1093,7 +1094,8 @@ LZCOMP *MTX_LZCOMP_Create2( MTX_MemHandler *mem, long maxCopyDistance )
 {
     const long preLoadSize = 2*32*96 + 4*256;
     const short hNodeAllocSize = 4095;
-    LZCOMP *t    = (LZCOMP *)MTX_mem_malloc( mem, sizeof( LZCOMP ) );
+    LZCOMP *t    = (LZCOMP *)mem->malloc( sizeof( LZCOMP ) );
+    if ( !t ) return NULL;
     t->mem        = mem;
     
     t->ptr1                = NULL;
diff --git a/src/lzcomp/mtxmem.c b/src/lzcomp/mtxmem.c
index d61e596..fd71f66 100644
--- a/src/lzcomp/mtxmem.c
+++ b/src/lzcomp/mtxmem.c
@@ -5,15 +5,22 @@
 #include <string.h> /* for size_t */
 #include <stdlib.h>
 #include "MTXMEM.H"
+#include "ERRCODES.H"
 
 void *MTX_mem_malloc(MTX_MemHandler *t, unsigned long size)
 {
-    return t->malloc(size);
+    void *p = t->malloc(size);
+    if (!p && size)
+        longjmp(t->env, ERR_MTX_mem_alloc);
+    return p;
 }
 
 void *MTX_mem_realloc(MTX_MemHandler *t, void *p, unsigned long size)
 {
-    return t->realloc(p, size);
+    void *q = t->realloc(p, size);
+    if (!q && size)
+        longjmp(t->env, ERR_MTX_mem_alloc);
+    return q;
 }
 
 void  MTX_mem_free(MTX_MemHandler *t, void *deadObject)
@@ -25,6 +32,8 @@ void  MTX_mem_free(MTX_MemHandler *t, void *deadObject)
 MTX_MemHandler *MTX_mem_Create(MTX_MALLOCPTR mptr, MTX_REALLOCPTR rptr, MTX_FREEPTR fptr)
 {
     MTX_MemHandler *t = (MTX_MemHandler *)malloc(sizeof(MTX_MemHandler));
+    if (!t)
+        return NULL;
     *t = (MTX_MemHandler){0};
     t->malloc = mptr;
     t->realloc = rptr;
-- 
2.56.0

