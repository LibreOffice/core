Add a switch that leaves out the nss command-line tools.

The build only needs the nss shared libraries. The tools under nss/cmd and
nss/nss-tool, such as certutil and pk12util, are never installed or run.
Leaving them out drops about a fifth of the build steps.

The coreconf build reads NSS_DISABLE_CMD_TOOLS from the environment. It still
builds the library headers that the tools directory exports, and shlibsign.
The gyp build reads disable_cmds instead, because gyp gets its settings on the
command line rather than from the environment.

diff --git a/nss/cmd/manifest.mn b/nss/cmd/manifest.mn
--- a/nss/cmd/manifest.mn
+++ b/nss/cmd/manifest.mn
@@ -92,6 +92,11 @@
 endif
 endif
 
+ifdef NSS_DISABLE_CMD_TOOLS
+SOFTOKEN_SRCDIRS = $(SHLIBSIGN_SRCDIR)
+NSS_SRCDIRS =
+endif
+
 DIRS = \
  $(LIB_SRCDIRS) \
  $(SOFTOKEN_SRCDIRS) \
diff --git a/nss/coreconf/config.gypi b/nss/coreconf/config.gypi
--- a/nss/coreconf/config.gypi
+++ b/nss/coreconf/config.gypi
@@ -112,6 +112,7 @@
     'disable_deprecated_rc2%': 0,
     'disable_dbm%': 1,
     'disable_libpkix%': 1,
+    'disable_cmds%': 0,
     'disable_kyber%' : 0,
     'disable_werror%': 0,
     'disable_altivec%': 0,
diff --git a/nss/nss.gyp b/nss/nss.gyp
