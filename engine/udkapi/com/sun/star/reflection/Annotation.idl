module com { module sun { module star { module reflection {

/** An annotation attached to a UNOIDL entity. */
struct Annotation {
    /** The annotation name; never contains U+003D EQUALS SIGN. */
    string Name;

    /** The optional annotation value. */
    com::sun::star::beans::Optional<string> Value;
};

}; }; }; };

