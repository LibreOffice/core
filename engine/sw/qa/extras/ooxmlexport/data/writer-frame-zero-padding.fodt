<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
                 xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
                 xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
                 xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0"
                 xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
                 xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0"
                 office:version="1.3"
                 office:mimetype="application/vnd.oasis.opendocument.text">
 <office:automatic-styles>
  <style:style style:name="fr1" style:family="graphic" style:parent-style-name="Frame">
   <!-- A frame of Writer's own, so it is not one read from a framePr and is written as a
        drawing. It states no space around its text. -->
   <style:graphic-properties fo:padding="0cm" fo:border="none"
                             style:wrap="none"
                             style:vertical-pos="from-top" style:vertical-rel="paragraph"
                             style:horizontal-pos="from-left" style:horizontal-rel="paragraph"/>
  </style:style>
 </office:automatic-styles>
 <office:body>
  <office:text>
   <text:p>Body text.</text:p>
   <text:p>
    <draw:frame draw:style-name="fr1" draw:name="Frame1" text:anchor-type="paragraph"
                svg:x="1cm" svg:y="0cm" svg:width="5cm" draw:z-index="0">
     <draw:text-box><text:p>Framed text</text:p></draw:text-box>
    </draw:frame>
   </text:p>
  </office:text>
 </office:body>
</office:document>
