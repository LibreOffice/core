  <office:text>
   <text:p text:style-name="Standard"><text:reference-mark-start text:name="tip"/>Water daily<text:reference-mark-end text:name="tip"/> in the morning.</text:p>
   <text:p text:style-name="Standard">The tip: <text:reference-ref text:reference-format="text" text:ref-name="tip">Water daily</text:reference-ref>.</text:p>
