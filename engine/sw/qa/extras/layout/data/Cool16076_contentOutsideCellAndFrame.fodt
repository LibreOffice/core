<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.text">
 <office:font-face-decls>
  <style:font-face style:name="Liberation Serif" svg:font-family="&apos;Liberation Serif&apos;" style:font-family-generic="roman"/>
 </office:font-face-decls>
 <office:automatic-styles>
  <style:style style:name="Outer" style:family="table">
   <style:table-properties style:width="8cm" table:align="left"/>
  </style:style>
  <style:style style:name="OuterCol" style:family="table-column">
   <style:table-column-properties style:column-width="4cm"/>
  </style:style>
  <style:style style:name="Nested" style:family="table">
   <style:table-properties style:width="6cm" table:align="left"/>
  </style:style>
  <style:style style:name="NestedCol" style:family="table-column">
   <style:table-column-properties style:column-width="6cm"/>
  </style:style>
  <style:style style:name="Cell" style:family="table-cell">
   <style:table-cell-properties fo:padding="0.1cm" fo:border="0.5pt solid #000000"/>
  </style:style>
  <style:style style:name="Fr1" style:family="graphic" style:parent-style-name="Frame">
   <style:graphic-properties style:wrap="right" style:vertical-pos="from-top" style:vertical-rel="paragraph" style:horizontal-pos="from-left" style:horizontal-rel="paragraph" fo:border="0.5pt solid #000000" fo:padding="0cm"/>
  </style:style>
  <style:style style:name="PNeg" style:family="paragraph" style:parent-style-name="Standard">
   <style:paragraph-properties fo:margin-right="-2cm"/>
   <style:text-properties style:font-name="Liberation Serif" fo:font-size="10pt"/>
  </style:style>
  <style:style style:name="PNegLeft" style:family="paragraph" style:parent-style-name="Standard">
   <style:paragraph-properties fo:margin-left="-2cm"/>
   <style:text-properties style:font-name="Liberation Serif" fo:font-size="10pt"/>
  </style:style>
  <style:style style:name="P1" style:family="paragraph" style:parent-style-name="Standard">
   <style:text-properties style:font-name="Liberation Serif" fo:font-size="10pt"/>
  </style:style>
  <style:page-layout style:name="PM1">
   <style:page-layout-properties fo:page-width="10cm" fo:page-height="14cm" style:print-orientation="portrait" fo:margin-top="1cm" fo:margin-bottom="1cm" fo:margin-left="1cm" fo:margin-right="1cm"/>
  </style:page-layout>
 </office:automatic-styles>
 <office:master-styles>
  <style:master-page style:name="Standard" style:page-layout-name="PM1"/>
 </office:master-styles>
 <office:body>
  <office:text>
   <table:table table:name="Outer" table:style-name="Outer">
    <table:table-column table:style-name="OuterCol" table:number-columns-repeated="2"/>
    <table:table-row>
     <table:table-cell table:style-name="Cell" office:value-type="string">
      <table:table table:name="Nested" table:style-name="Nested">
       <table:table-column table:style-name="NestedCol"/>
       <table:table-row>
        <table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="P1">n001 n002 n003 n004 n005 n006 n007 n008</text:p></table:table-cell>
       </table:table-row>
      </table:table>
      <text:p text:style-name="P1"/>
     </table:table-cell>
     <table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="P1">right of the cell</text:p></table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P1"/>
   <text:p text:style-name="P1">
    <draw:frame draw:style-name="Fr1" draw:name="Frame1" text:anchor-type="paragraph" svg:x="0cm" svg:y="0cm" svg:width="4cm" draw:z-index="0">
     <draw:text-box fo:min-height="0.6cm">
      <table:table table:name="InFrame" table:style-name="Nested">
       <table:table-column table:style-name="NestedCol"/>
       <table:table-row>
        <table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="P1">f001 f002 f003 f004 f005 f006 f007 f008</text:p></table:table-cell>
       </table:table-row>
      </table:table>
     </draw:text-box>
    </draw:frame>right of the frame</text:p>
   <text:p text:style-name="P1"/>
   <text:p text:style-name="P1"/>
   <table:table table:name="Indent" table:style-name="Outer">
    <table:table-column table:style-name="OuterCol" table:number-columns-repeated="2"/>
    <table:table-row>
     <table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="PNeg">i001 i002 i003 i004 i005 i006 i007 i008</text:p></table:table-cell>
     <table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="P1">right of the indent</text:p></table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P1"/>
   <table:table table:name="IndentLeft" table:style-name="Outer">
    <table:table-column table:style-name="OuterCol" table:number-columns-repeated="2"/>
    <table:table-row>
     <table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="P1">left of the indent</text:p></table:table-cell>
     <table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="PNegLeft">L001 L002 L003</text:p></table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P1"/>
  </office:text>
 </office:body>
</office:document>
