<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" office:version="1.4" office:mimetype="application/vnd.oasis.opendocument.text">
 <office:font-face-decls>
  <style:font-face style:name="Liberation Serif" svg:font-family="'Liberation Serif'"/>
 </office:font-face-decls>
 <office:styles>
  <style:default-style style:family="paragraph">
   <style:text-properties style:font-name="Liberation Serif" fo:font-size="12pt"/>
  </style:default-style>
 </office:styles>
 <office:body>
  <office:text>
   <text:p>First paragraph.</text:p>
   <text:p>Before <draw:rect text:anchor-type="as-char" draw:name="Blue box" svg:width="0.4cm" svg:height="0.4cm"><svg:title>Blue box</svg:title><svg:desc>A small blue square</svg:desc></draw:rect> after.</text:p>
   <text:p><draw:ellipse text:anchor-type="paragraph" draw:name="Red circle" svg:x="10cm" svg:y="0cm" svg:width="1cm" svg:height="1cm"><svg:title>Red circle</svg:title></draw:ellipse>Ending with a circle.</text:p>
   <text:p>Last paragraph.</text:p>
  </office:text>
 </office:body>
</office:document>
