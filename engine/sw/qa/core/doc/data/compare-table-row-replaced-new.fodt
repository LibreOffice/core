<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.text">
 <office:body>
  <office:text>
   <text:p>Before</text:p>
   <table:table table:name="Table1">
    <table:table-column table:number-columns-repeated="3"/>
    <table:table-row>
     <table:table-cell><text:p>Apples</text:p></table:table-cell>
     <table:table-cell><text:p>Red</text:p></table:table-cell>
     <table:table-cell><text:p>Eleven boxes</text:p></table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell><text:p>Cherries</text:p></table:table-cell>
     <table:table-cell><text:p>Dark red</text:p></table:table-cell>
     <table:table-cell><text:p>Three boxes</text:p></table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell><text:p>Dates</text:p></table:table-cell>
     <table:table-cell><text:p>Brown</text:p></table:table-cell>
     <table:table-cell><text:p>Four boxes</text:p></table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell><text:p>Figs</text:p></table:table-cell>
     <table:table-cell><text:p>Purple</text:p></table:table-cell>
     <table:table-cell><text:p>Six boxes</text:p></table:table-cell>
    </table:table-row>
   </table:table>
   <text:p>After</text:p>
  </office:text>
 </office:body>
