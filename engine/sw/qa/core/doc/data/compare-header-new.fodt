<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.text">
  <office:automatic-styles>
    <style:page-layout style:name="pm1"/>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="pm1">
      <style:header>
        <text:p>Header new text</text:p>
      </style:header>
      <style:footer>
        <text:p>Footer new text</text:p>
      </style:footer>
    </style:master-page>
    <style:master-page style:name="Unused" style:page-layout-name="pm1">
      <style:header>
        <text:p>Unused new text</text:p>
      </style:header>
    </style:master-page>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p>Body text</text:p>
    </office:text>
  </office:body>
</office:document>
