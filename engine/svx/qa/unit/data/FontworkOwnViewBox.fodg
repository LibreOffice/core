<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.graphics">
 <office:body>
  <office:drawing>
   <draw:page draw:name="page1">
    <draw:custom-shape draw:name="Spiral" svg:width="10.2cm" svg:height="6.3cm" svg:x="5cm" svg:y="4cm">
     <text:p>Fontwork along its own path</text:p>
     <draw:enhanced-geometry svg:viewBox="0 0 34 21" draw:text-path="true" draw:text-path-scale="path" draw:type="non-primitive" draw:enhanced-path="M 0 0 Y 21 21 34 8 26 0 21 5 24 8 26 6 25 5 24 6 N"/>
    </draw:custom-shape>
   </draw:page>
  </office:drawing>
 </office:body>
