<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
                 xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0"
                 xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
                 xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0"
                 office:version="1.2"
                 office:mimetype="application/vnd.oasis.opendocument.presentation">
 <office:body>
  <office:presentation>
   <draw:page>
    <draw:frame svg:width="10cm" svg:height="2cm" svg:x="2cm" svg:y="2cm">
     <draw:text-box><text:p>Source one</text:p></draw:text-box>
    </draw:frame>
   </draw:page>
   <draw:page>
    <draw:frame svg:width="10cm" svg:height="2cm" svg:x="2cm" svg:y="2cm">
     <draw:text-box><text:p>Source two</text:p></draw:text-box>
    </draw:frame>
   </draw:page>
   <draw:page>
    <draw:frame svg:width="10cm" svg:height="2cm" svg:x="2cm" svg:y="2cm">
     <draw:text-box><text:p>Source three</text:p></draw:text-box>
    </draw:frame>
   </draw:page>
  </office:presentation>
 </office:body>
</office:document>
