<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
                 xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
                 xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0"
                 xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
                 xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
                 xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0"
                 xmlns:coext="urn:com:collaboraoffice:names:experimental:office:xmlns:coext:1.0"
                 office:version="1.2"
                 office:mimetype="application/vnd.oasis.opendocument.presentation">
 <office:font-face-decls>
  <style:font-face style:name="DejaVu Sans" svg:font-family="&apos;DejaVu Sans&apos;" style:font-family-generic="swiss"/>
 </office:font-face-decls>
 <office:styles>
  <style:default-style style:family="graphic">
   <style:graphic-properties svg:stroke-color="#0b1f2a" draw:fill-color="#1b3a4b"/>
   <style:text-properties style:font-name="DejaVu Sans" fo:font-size="40pt"/>
  </style:default-style>
  <style:style style:name="standard" style:family="graphic">
   <style:graphic-properties draw:stroke="solid" svg:stroke-color="#0b1f2a" draw:fill="solid" draw:fill-color="#1b3a4b"/>
   <style:text-properties style:font-name="DejaVu Sans" fo:font-size="40pt"/>
  </style:style>
  <style:style style:name="objectwithoutfill" style:family="graphic" style:parent-style-name="standard">
   <style:graphic-properties draw:stroke="none" draw:fill="none"/>
  </style:style>
 </office:styles>
 <office:body>
  <office:presentation>
   <draw:page draw:name="TargetOne" coext:guid="{7F672955-0001-46E9-AEE0-2DB9314BD16B}">
    <draw:rect draw:style-name="standard" svg:width="10cm" svg:height="2cm" svg:x="2cm" svg:y="2cm"/>
    <draw:frame draw:style-name="objectwithoutfill" svg:width="10cm" svg:height="2cm" svg:x="2cm" svg:y="5cm">
     <draw:text-box><text:p>Target one</text:p></draw:text-box>
    </draw:frame>
   </draw:page>
  </office:presentation>
 </office:body>
</office:document>
