module scriptinterop {

// Forward declaration: appendParagraph returns a paragraph, and the paragraph's getRange returns
// a range, so the two interfaces refer to each other.
interface XTextParagraph;

interface XTextRange : XBase
{
    string asString();

    XTextRange setText([in] string newText);

    XTextRange appendText([in] string text);

    XTextParagraph appendParagraph([in] string text);

    XTextRange setBulletLevel([in] long level);

    XTextStyle getTextStyle();
};

};

