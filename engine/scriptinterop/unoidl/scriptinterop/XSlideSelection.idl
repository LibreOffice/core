module scriptinterop {

interface XSlideSelection : XBase
{
    com::sun::star::beans::Optional<XPage> getCurrentPage();

    com::sun::star::beans::Optional<XPageElementRange> getPageElementRange();

    com::sun::star::beans::Optional<XPageRange> getPageRange();

    SelectionType getSelectionType();

    com::sun::star::beans::Optional<XSlideTableCellRange> getTableCellRange();

    com::sun::star::beans::Optional<XTextRange> getTextRange();
};

};

