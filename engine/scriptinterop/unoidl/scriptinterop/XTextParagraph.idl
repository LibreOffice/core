module scriptinterop {

interface XTextRange;

/** A paragraph of the text in a shape or table cell.

    @gas Paragraph
 */
interface XTextParagraph : XBase
{
    /** Returns the index of the newline that ends the paragraph, counted from the start of the
        whole text, or null when the paragraph has been deleted.

        @unimplemented
        @gas Paragraph.getIndex
     */
    com::sun::star::beans::Optional<long> getIndex();

    /** The range covers the whole paragraph as it is when this is called, followed by the
        newline of the paragraph. For an empty paragraph the range is a position in it. The
        paragraph is found by its position among the paragraphs of the text, so the result is
        null once the text has fewer paragraphs than that.

        @gas Paragraph.getRange
     */
    com::sun::star::beans::Optional<XTextRange> getRange();
};

};

