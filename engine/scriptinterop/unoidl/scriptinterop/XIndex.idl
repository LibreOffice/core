module scriptinterop {

/** An index other than a table of contents, such as an alphabetical index or a bibliography, as an
    element of type INDEX.

    Writer generates the paragraphs of an index from the rest of the document. They are the
    children of the index.
 */
interface XIndex: XContainerElement {
    /** Returns which kind of index this is. */
    IndexKind getIndexKind();
};

};

