module scriptinterop {

interface XSlideTable;
interface XSlideTableColumn;
interface XSlideTableRow;
interface XTextRange;

/** A cell of a table on a slide.

    Indexes are 0-based.

    @gas TableCell
 */
interface XSlideTableCell : XBase
{
    /** @unimplemented @gas TableCell.getColumnIndex */
    long getColumnIndex();

    /** Returns 0 for a cell merged into another cell.

        @unimplemented
        @gas TableCell.getColumnSpan
     */
    long getColumnSpan();

    /** @unimplemented @gas TableCell.getContentAlignment */
    ContentAlignment getContentAlignment();

    /** @unimplemented @gas TableCell.getFill */
    XFill getFill();

    /** @unimplemented @gas TableCell.getMergeState */
    CellMergeState getMergeState();

    /** @unimplemented @gas TableCell.getParentColumn */
    XSlideTableColumn getParentColumn();

    /** @unimplemented @gas TableCell.getParentRow */
    XSlideTableRow getParentRow();

    /** @unimplemented @gas TableCell.getParentTable */
    XSlideTable getParentTable();

    /** @unimplemented @gas TableCell.getRowIndex */
    long getRowIndex();

    /** Returns 0 for a cell merged into another cell.

        @unimplemented
        @gas TableCell.getRowSpan
     */
    long getRowSpan();

    /** @unimplemented @gas TableCell.getText */
    XTextRange getText();

    /** @unimplemented @gas TableCell.setContentAlignment */
    XSlideTableCell setContentAlignment([in] ContentAlignment contentAlignment);
};

};

