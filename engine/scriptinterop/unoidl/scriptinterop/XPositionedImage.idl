module scriptinterop {

interface XParagraph;

interface XPositionedImage: XBase {
    long getHeight();

    string getId();

    PositionedLayout getLayout();

    double getLeftOffset();

    XParagraph getParagraph();

    double getTopOffset();

    long getWidth();

    XPositionedImage setHeight([in] long height);

    XPositionedImage setLayout([in] PositionedLayout layout);

    XPositionedImage setLeftOffset([in] double offset);

    XPositionedImage setTopOffset([in] double offset);

    XPositionedImage setWidth([in] long width);

    // Setting the ID, the image's name in the document, which GAS's PositionedImage does not offer:

    XPositionedImage setId([in] string id);

    // Anchoring to a page, after which the offsets are measured from the top left corner of the
    // page, which GAS's PositionedImage does not offer:

    com::sun::star::beans::Optional<long> getPageAnchor();

    XPositionedImage setPageAnchor([in] long page);
};

};

