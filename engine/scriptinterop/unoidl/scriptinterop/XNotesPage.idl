module scriptinterop {

interface XShape;

/** The notes page of a slide, which holds its speaker notes.

    @gas NotesPage
 */
interface XNotesPage : XPageBase
{
    /** @throws RuntimeException
            when the notes page has no notes shape.

        @gas NotesPage.getSpeakerNotesShape
     */
    XShape getSpeakerNotesShape();

    /** Replaces every match of findText in the shapes on this page, ignoring case.

        @returns
            The number of occurrences replaced.
        @throws RuntimeException
            when findText is empty.

        @gas NotesPage.replaceAllText
     */
    [overload replaceAllText] long replaceAllText([in] string findText, [in] string replaceText);

    /** Replaces every match of findText in the shapes on this page.

        @returns
            The number of occurrences replaced.
        @throws RuntimeException
            when findText is empty.

        @gas NotesPage.replaceAllText
     */
    [overload replaceAllText] long replaceAllTextMatchCase(
        [in] string findText, [in] string replaceText, [in] boolean matchCase);

};

};

