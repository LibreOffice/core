module scriptinterop {

/** The authorization mode an Apps Script trigger runs in.

    @internal

    @gas ScriptApp.AuthMode
 */
enum AuthMode {
    NONE,
    CUSTOM_FUNCTION,
    LIMITED,
    FULL
};

};

