module scriptinterop {

// One selection segment, consistent with GAS's Selection.getRangeElements() model.  The element is
// the paragraph that a text segment lives in, or the inline image that is selected on its own.
// Offsets are character positions within that paragraph's own getText(), and are -1 for a segment
// that is not partial:
interface XRangeElement: XBase {
    XElement getElement();

    long getEndOffsetInclusive();

    long getStartOffset();

    boolean isPartial();
};

};

