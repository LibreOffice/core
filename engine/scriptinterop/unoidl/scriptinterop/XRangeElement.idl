module scriptinterop {

// One selection segment, tied back to the paragraph it lives in.  Offsets are character positions
// within that paragraph's own getText(), consistent with GAS's Selection.getRangeElements() model:
interface XRangeElement: XBase {
    XParagraph getElement();

    long getEndOffsetInclusive();

    long getStartOffset();

    boolean isPartial();
};

};

