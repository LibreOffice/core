module scriptinterop {

/** The theme colors of a page and the concrete colors they stand for.

    No call returns this object yet.

    @gas ColorScheme
 */
interface XColorScheme : XBase
{
    /** @unimplemented @gas ColorScheme.getConcreteColor */
    XColor getConcreteColor([in] ThemeColorType themeColorType);

    /** @unimplemented @gas ColorScheme.getThemeColors */
    sequence<ThemeColorType> getThemeColors();

    /** @param color
            A Color or a color string.

        @unimplemented
        @gas ColorScheme.setConcreteColor
     */
    [overload setConcreteColor] XColorScheme setConcreteColor(
        [in] ThemeColorType themeColorType, [in] any color);

    /** Red, green and blue each run from 0 to 255.

        @unimplemented
        @gas ColorScheme.setConcreteColor
     */
    [overload setConcreteColor] XColorScheme setConcreteColorRgb(
        [in] ThemeColorType themeColorType, [in] long red, [in] long green, [in] long blue);

};

};

