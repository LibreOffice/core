module scriptinterop {

interface XLayout;
interface XNotesPage;

interface XSlide : XEditablePageBase
{
    XSlide duplicate();

    XLayout getLayout();

    XNotesPage getNotesPage();

    SlideLinkingMode getSlideLinkingMode();

    boolean isSkipped();

    void move([in] long index);

    XSlide setBackgroundColor([in] string hexColor);

    void setSkipped([in] boolean skipped);
};

};

