module scriptinterop {

interface XLink;

interface XTextStyle : XBase
{
    XColor getBackgroundColor();

    TextBaselineOffset getBaselineOffset();

    string getFontFamily();

    double getFontSize();

    XColor getForegroundColor();

    XLink getLink();

    boolean hasLink();

    boolean isBackgroundTransparent();

    boolean isBold();

    boolean isItalic();

    boolean isSmallCaps();

    boolean isStrikethrough();

    boolean isUnderline();

    XTextStyle removeLink();

    [overload setBackgroundColor] XTextStyle setBackgroundColor([in] any color);

    [overload setBackgroundColor] XTextStyle setBackgroundColorRgb(
        [in] long red, [in] long green, [in] long blue);

    XTextStyle setBackgroundColorTransparent();

    XTextStyle setBaselineOffset([in] TextBaselineOffset baselineOffset);

    XTextStyle setBold([in] boolean bold);

    XTextStyle setFontFamily([in] string fontFamily);

    XTextStyle setFontSize([in] double points);

    [overload setForegroundColor] XTextStyle setForegroundColor([in] any color);

    [overload setForegroundColor] XTextStyle setForegroundColorRgb(
        [in] long red, [in] long green, [in] long blue);

    XTextStyle setItalic([in] boolean italic);

    XTextStyle setLinkSlide([in] any slide);

    XTextStyle setLinkUrl([in] string url);

    XTextStyle setSmallCaps([in] boolean smallCaps);

    XTextStyle setStrikethrough([in] boolean strikethrough);

    XTextStyle setUnderline([in] boolean underline);
};

};

