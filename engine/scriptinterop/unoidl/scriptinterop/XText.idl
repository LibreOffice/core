module scriptinterop {

interface XText: XBase {
    short getEscapement([in] long offset); // -1 subscript, 0 normal, 1 superscript

    string getFontFamily([in] long offset);

    string getLinkUrl([in] long offset);

    string getText();

    sequence<long> getTextAttributeIndices();

    boolean isBold([in] long offset);

    boolean isItalic([in] long offset);

    boolean isStrikethrough([in] long offset);

    boolean isUnderline([in] long offset);

    [overload setBold] XText setBold([in] boolean value);

    [overload setBold] XText setBoldRange(
        [in] long startOffset, [in] long endOffsetInclusive, [in] boolean value);

    [overload setFontFamily] XText setFontFamily([in] string fontFamilyName);

    [overload setFontFamily] XText setFontFamilyRange(
        [in] long startOffset, [in] long endOffsetInclusive, [in] string fontFamilyName);

    [overload setItalic] XText setItalic([in] boolean value);

    [overload setItalic] XText setItalicRange(
        [in] long startOffset, [in] long endOffsetInclusive, [in] boolean value);

    [overload setLinkUrl] XText setLinkUrl([in] string url);

    [overload setLinkUrl] XText setLinkUrlRange(
        [in] long startOffset, [in] long endOffsetInclusive, [in] string url);

    [overload setStrikethrough] XText setStrikethrough([in] boolean value);

    [overload setStrikethrough] XText setStrikethroughRange(
        [in] long startOffset, [in] long endOffsetInclusive, [in] boolean value);

    [overload setTextAlignment] XText setTextAlignment([in] TextAlignment textAlignment);

    [overload setTextAlignment] XText setTextAlignmentRange(
        [in] long startOffset, [in] long endOffsetInclusive, [in] TextAlignment textAlignment);

    [overload setUnderline] XText setUnderline([in] boolean value);

    [overload setUnderline] XText setUnderlineRange(
        [in] long startOffset, [in] long endOffsetInclusive, [in] boolean value);
};

};

