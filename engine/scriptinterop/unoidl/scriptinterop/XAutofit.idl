module scriptinterop {

/** How the text of a shape is fitted to the shape.

    @gas Autofit
 */
interface XAutofit : XBase
{
    /** @unimplemented @gas Autofit.disableAutofit */
    XAutofit disableAutofit();

    /** @unimplemented @gas Autofit.getAutofitType */
    AutofitType getAutofitType();

    /** Returns the factor that the font sizes are scaled by, where 1 means no scaling.

        @unimplemented
        @gas Autofit.getFontScale
     */
    double getFontScale();

    /** Returns how much the line spacing is reduced, where 0 means no reduction.

        @unimplemented
        @gas Autofit.getLineSpacingReduction
     */
    double getLineSpacingReduction();
};

};

