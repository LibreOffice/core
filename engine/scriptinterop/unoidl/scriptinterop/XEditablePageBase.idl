module scriptinterop {

interface XConnectionSite;
interface XGroup;
interface XImage;
interface XLine;
interface XPageElement;
interface XPageElementBase;
interface XShape;
interface XSlideTable;
interface XWordArt;

interface XEditablePageBase : XPageBase
{
    XPageBackground getBackground();

    XColorScheme getColorScheme();

    PageType getPageType();

    XGroup group([in] sequence<XPageElementBase> pageElements);

    XGroup insertGroup([in] XGroup group);

    [overload insertImage] XImage insertImage([in] any image);

    [overload insertImage] XImage insertImageAt([in] any image, [in] double left, [in] double top,
                                                [in] double width, [in] double height);

    [overload insertLine] XLine insertLine([in] XLine line);

    [overload insertLine] XLine insertLineBetween([in] LineCategory lineCategory,
                                                  [in] XConnectionSite startConnectionSite,
                                                  [in] XConnectionSite endConnectionSite);

    [overload insertLine] XLine insertLineAt([in] LineCategory lineCategory, [in] double startLeft,
                                             [in] double startTop, [in] double endLeft,
                                             [in] double endTop);

    XPageElement insertPageElement([in] XPageElement pageElement);

    [overload insertShape] XShape insertShape([in] any shape);

    [overload insertShape] XShape insertShapeAt([in] ShapeType shapeType, [in] double left,
                                                [in] double top, [in] double width,
                                                [in] double height);

    [overload insertTable] XSlideTable insertTable([in] long numRows, [in] long numColumns);

    [overload insertTable] XSlideTable insertTableAt([in] long numRows, [in] long numColumns,
                                                     [in] double left, [in] double top,
                                                     [in] double width, [in] double height);

    [overload insertTable] XSlideTable insertTableCopy([in] XSlideTable table);

    [overload insertTextBox] XShape insertTextBox([in] string text);

    [overload insertTextBox] XShape insertTextBoxAt([in] string text, [in] double left,
                                                    [in] double top, [in] double width,
                                                    [in] double height);

    XWordArt insertWordArt([in] XWordArt wordArt);

    void remove();

    [overload replaceAllText] long replaceAllText([in] string findText, [in] string replaceText);

    [overload replaceAllText] long replaceAllTextMatchCase(
        [in] string findText, [in] string replaceText, [in] boolean matchCase);

    void selectAsCurrentPage();
};

};

