module scriptinterop {

interface XImage;
interface XLink;
interface XPageElement;
interface XTextRange;

interface XShape : XPageElementBase
{
    XAutofit getAutofit();

    XBorder getBorder();

    ContentAlignment getContentAlignment();

    XFill getFill();

    XLink getLink();

    XPageElement getParentPlaceholder();

    long getPlaceholderIndex();

    PlaceholderType getPlaceholderType();

    ShapeType getShapeType();

    XTextRange getText();

    void removeLink();

    [overload replaceWithImage] XImage replaceWithImage([in] any image);

    [overload replaceWithImage] XImage replaceWithImageCropped([in] any image, [in] boolean crop);

    XShape setContentAlignment([in] ContentAlignment contentAlignment);

    XLink setLinkSlide([in] any slide);

    XLink setLinkUrl([in] string url);
};

};

