module scriptinterop {

interface XImage;
interface XLink;
interface XPageElement;
interface XTextRange;

/** A shape on a page: a text box, a rectangle, a custom shape or any other element of the SHAPE
    kind.

    @gas Shape
 */
interface XShape : XPageElementBase
{
    /** Returns null when the shape cannot hold text.

        @unimplemented
        @gas Shape.getAutofit
     */
    com::sun::star::beans::Optional<XAutofit> getAutofit();

    /** @unimplemented @gas Shape.getBorder */
    XBorder getBorder();

    /** @unimplemented @gas Shape.getContentAlignment */
    ContentAlignment getContentAlignment();

    /** @unimplemented @gas Shape.getFill */
    XFill getFill();

    /** Returns null when the shape has no link.

        @unimplemented
        @gas Shape.getLink
     */
    com::sun::star::beans::Optional<XLink> getLink();

    /** Returns the placeholder on the layout or master that this shape inherits from, or null
        when the shape is not a placeholder or has no parent.

        @unimplemented
        @gas Shape.getParentPlaceholder
     */
    com::sun::star::beans::Optional<XPageElement> getParentPlaceholder();

    /** Returns the index that tells this placeholder apart from others of the same kind on the
        page, or null when the shape is not a placeholder.

        @unimplemented
        @gas Shape.getPlaceholderIndex
     */
    com::sun::star::beans::Optional<long> getPlaceholderIndex();

    /** Returns NONE when the shape is not a placeholder.

        @unimplemented
        @gas Shape.getPlaceholderType
     */
    PlaceholderType getPlaceholderType();

    /** @unimplemented @gas Shape.getShapeType */
    ShapeType getShapeType();

    /** Returns the whole text of the shape.

        @throws RuntimeException
            if the shape cannot hold text.

        @gas Shape.getText
     */
    XTextRange getText();

    /** @unimplemented @gas Shape.removeLink */
    void removeLink();

    /** Replaces the shape with a picture, scaled to fit the shape.

        @param image
            The new picture: a blob, or a URL string to fetch the picture from.

        @unimplemented
        @gas Shape.replaceWithImage
     */
    [overload replaceWithImage] XImage replaceWithImage([in] any image);

    /** @param image
            The new picture: a blob, or a URL string to fetch the picture from.
        @param crop
            true to crop the picture to the size of the shape, false to scale it to fit.

        @unimplemented
        @gas Shape.replaceWithImage
     */
    [overload replaceWithImage] XImage replaceWithImageCropped([in] any image, [in] boolean crop);

    /** @unimplemented @gas Shape.setContentAlignment */
    XShape setContentAlignment([in] ContentAlignment contentAlignment);

    /** @param slide
            The slide to link to: a slide object, its 0-based index, or a SlidePosition value.

        @unimplemented
        @gas Shape.setLinkSlide
     */
    XLink setLinkSlide([in] any slide);

    /** @unimplemented @gas Shape.setLinkUrl */
    XLink setLinkUrl([in] string url);
};

};

