module scriptinterop {

interface XInlineImage;

// Common base for the heterogeneous children of a body (paragraphs, tables, etc.):
interface XElement: XBase {
    XInlineImage asInlineImage();

    XElement copy();

    com::sun::star::beans::Optional<XElement> getNextSibling();

    com::sun::star::beans::Optional<XElement> getParent();

    com::sun::star::beans::Optional<XElement> getPreviousSibling();

    string getText();

    ElementType getType();

    void removeFromParent();
};

};

