module scriptinterop {

interface XAffineTransform;

interface XAffineTransformBuilder : XBase
{
    XAffineTransform build();

    XAffineTransformBuilder setScaleX([in] double scaleX);

    XAffineTransformBuilder setScaleY([in] double scaleY);

    XAffineTransformBuilder setShearX([in] double shearX);

    XAffineTransformBuilder setShearY([in] double shearY);

    XAffineTransformBuilder setTranslateX([in] double translateX);

    XAffineTransformBuilder setTranslateY([in] double translateY);
};

};

