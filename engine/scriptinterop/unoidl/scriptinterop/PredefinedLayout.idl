module scriptinterop {

enum PredefinedLayout
{
    UNSUPPORTED,
    BLANK,
    CAPTION_ONLY,
    TITLE,
    TITLE_AND_BODY,
    TITLE_AND_TWO_COLUMNS,
    TITLE_ONLY,
    SECTION_HEADER,
    SECTION_TITLE_AND_DESCRIPTION,
    ONE_COLUMN_TEXT,
    MAIN_POINT,
    BIG_NUMBER
};

};

