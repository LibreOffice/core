module scriptinterop {

interface XPivotTable : XBase
{
    string getName();

    XPivotTable addRowGroup([in] long sourceColumn);

    XPivotTable addColumnGroup([in] long sourceColumn);

    XPivotTable addPivotValue([in] long sourceColumn, [in] string summarizeFunction);

    XPivotTable addFilter([in] long sourceColumn, [in] string visibleValue);

    void remove();
};

};

