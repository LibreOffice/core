module com {  module sun {  module star {  module style {

/** This method returns the collection of style families available
    in the container document.
    @see StyleFamilies
 */
published interface XStyleFamilies
{
    interface com::sun::star::container::XNameAccess;
    interface com::sun::star::container::XIndexAccess;

    /** @returns
        the style family with the specified name.

        @param aName
            the name of the style family.

        @throws NoSuchElementException
            if a style family under Name does not exist.

        @throws  com::sun::star::lang::WrappedTargetException
            If the implementation has internal reasons for exceptions,
            then wrap these in a com::sun::star::lang::WrappedTargetException
            exception.
     */
    XStyleFamily getStyleFamilyByName( [in] string aName )
            raises( com::sun::star::container::NoSuchElementException,
                    com::sun::star::lang::WrappedTargetException );

    /** @returns
            the style family at the specified index.

        @param Index
            specifies the position in the array. The first index is 0.

        @throws com::sun::star::lang::IndexOutOfBoundsException
            if the index is not valid.

        @throws  com::sun::star::lang::WrappedTargetException
            If the implementation has internal reasons for exceptions,
            then wrap these in a com::sun::star::lang::WrappedTargetException
            exception.
     */
    XStyleFamily getStyleFamilyByIndex( [in] long Index )
            raises( com::sun::star::lang::IndexOutOfBoundsException,
                    com::sun::star::lang::WrappedTargetException );
};


}; }; }; };

