#ifndef INCLUDED_SCADDINS_IDL_ORG_COLLABORAOFFICE_SHEET_ADDIN_XPYTHONCOMPUTEFUNCTIONS_IDL
#define INCLUDED_SCADDINS_IDL_ORG_COLLABORAOFFICE_SHEET_ADDIN_XPYTHONCOMPUTEFUNCTIONS_IDL

#include <cpo/uno/XInterface.idl>
#include <com/sun/star/lang/IllegalArgumentException.idl>

module org { module collaboraoffice { module sheet { module addin {

/** Calc add-in entry points for Online/remote Python compute (=PY / =PYTHON). */
interface XPythonComputeFunctions : cpo::uno::XInterface
{
    /** Execute Python; returns XVolatileResult (interim "#BUSY!", then a ResultEvent). */
    any getPy( [in] string code, [in] sequence<any> data )
        raises( com::sun::star::lang::IllegalArgumentException );

    /** Alias for getPy (display name PYTHON). */
    any getPython( [in] string code, [in] sequence<any> data )
        raises( com::sun::star::lang::IllegalArgumentException );
};

}; }; }; };

#endif
