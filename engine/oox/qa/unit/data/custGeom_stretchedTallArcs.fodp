  <office:body>
    <office:presentation>
      <draw:page draw:name="page1" draw:master-page-name="">
        <draw:custom-shape draw:name="tall arcs" svg:width="4cm" svg:height="8cm" svg:x="2cm" svg:y="2cm">
          <text:p/>
          <draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:type="non-primitive" draw:modifiers="6000"
              draw:path-stretchpoint-x="10800"
              draw:enhanced-path="M 0 0 L 0 21600 21600 21600 21600 0 Z N U 10800 10800 ?f0 ?f0 30 150 Z N V 3000 3000 18600 18600 18600 10800 3000 10800 Z N">
            <draw:equation draw:name="f0" draw:formula="$0"/>
            <draw:handle draw:handle-position="$0 10800" draw:handle-range-x-minimum="2000" draw:handle-range-x-maximum="10800"/>
          </draw:enhanced-geometry>
        </draw:custom-shape>
      </draw:page>
    </office:presentation>
