<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0" xmlns:dr3d="urn:oasis:names:tc:opendocument:xmlns:dr3d:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.presentation">
 <office:font-face-decls>
  <style:font-face style:name="Liberation Sans" svg:font-family="'Liberation Sans'" style:font-family-generic="swiss" style:font-pitch="variable"/>
 </office:font-face-decls>
 <office:automatic-styles>
  <style:style style:name="gr1" style:family="graphic">
   <style:graphic-properties draw:fill="none" draw:stroke="none"/>
   <style:text-properties style:font-name="Liberation Sans"/>
  </style:style>
 </office:automatic-styles>
 <office:body>
  <office:presentation>
   <draw:page draw:name="p1">
    <draw:g draw:style-name="gr1">
     <draw:frame draw:style-name="gr1" svg:x="2cm" svg:y="2cm" svg:width="8cm" svg:height="2cm">
      <draw:text-box><text:p>Step one</text:p></draw:text-box>
     </draw:frame>
     <draw:frame draw:style-name="gr1" svg:x="12cm" svg:y="2cm" svg:width="2cm" svg:height="2cm">
      <draw:image><office:binary-data>iVBORw0KGgoAAAANSUhEUgAAABAAAAAQCAIAAACQkWg2AAAAFklEQVR4nGM4ISdHEmIY1TCqYfhqAADkYgQQ60fIxgAAAABJRU5ErkJggg==</office:binary-data></draw:image>
      <svg:title>Arrow icon</svg:title>
     </draw:frame>
    </draw:g>
    <draw:g draw:style-name="gr1">
     <draw:frame draw:style-name="gr1" svg:x="2cm" svg:y="6cm" svg:width="8cm" svg:height="2cm">
      <draw:text-box><text:p>Diagram text</text:p></draw:text-box>
     </draw:frame>
     <draw:frame draw:style-name="gr1" svg:x="12cm" svg:y="6cm" svg:width="2cm" svg:height="2cm">
      <draw:image><office:binary-data>iVBORw0KGgoAAAANSUhEUgAAABAAAAAQCAIAAACQkWg2AAAAFklEQVR4nGM4ISdHEmIY1TCqYfhqAADkYgQQ60fIxgAAAABJRU5ErkJggg==</office:binary-data></draw:image>
     </draw:frame>
     <svg:title>Workflow diagram</svg:title>
    </draw:g>
    <draw:g draw:style-name="gr1">
     <draw:frame draw:style-name="gr1" svg:x="2cm" svg:y="10cm" svg:width="8cm" svg:height="2cm">
      <draw:text-box><text:p>Cube text</text:p></draw:text-box>
     </draw:frame>
     <dr3d:scene draw:style-name="gr1" svg:x="12cm" svg:y="10cm" svg:width="2cm" svg:height="2cm" dr3d:vrp="(0 0 25000)" dr3d:vpn="(0 0 1)" dr3d:vup="(0 1 0)" dr3d:projection="perspective" dr3d:distance="10cm" dr3d:focal-length="10cm">
      <dr3d:cube dr3d:min-edge="(-2500 -2500 -2500)" dr3d:max-edge="(2500 2500 2500)"/>
      <svg:title>Cube</svg:title>
     </dr3d:scene>
    </draw:g>
   </draw:page>
  </office:presentation>
 </office:body>
</office:document>
