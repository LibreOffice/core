<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" xmlns:loext="urn:org:documentfoundation:names:experimental:office:xmlns:loext:1.0" office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.presentation">
 <office:font-face-decls>
  <style:font-face style:name="Liberation Sans" svg:font-family="'Liberation Sans'" style:font-family-generic="swiss" style:font-pitch="variable"/>
 </office:font-face-decls>
 <office:automatic-styles>
  <style:style style:name="gr1" style:family="graphic">
   <style:graphic-properties draw:fill="none" draw:stroke="none"/>
   <style:text-properties style:font-name="Liberation Sans"/>
  </style:style>
  <style:style style:name="gr2" style:family="graphic">
   <style:graphic-properties draw:fill="none" draw:stroke="none" loext:decorative="true"/>
   <style:text-properties style:font-name="Liberation Sans"/>
  </style:style>
 </office:automatic-styles>
 <office:body>
  <office:presentation>
   <draw:page draw:name="p1">
    <draw:g draw:style-name="gr1">
     <draw:frame draw:style-name="gr1" svg:x="2cm" svg:y="2cm" svg:width="20cm" svg:height="2cm">
      <draw:text-box><text:p>Meaningful text</text:p></draw:text-box>
     </draw:frame>
     <draw:frame draw:style-name="gr2" svg:x="2cm" svg:y="5cm" svg:width="20cm" svg:height="2cm">
      <draw:text-box><text:p>Decorative member</text:p></draw:text-box>
     </draw:frame>
     <svg:title>Group</svg:title>
    </draw:g>
    <draw:g draw:style-name="gr2">
     <draw:frame draw:style-name="gr2" svg:x="2cm" svg:y="9cm" svg:width="20cm" svg:height="2cm">
      <draw:text-box><text:p>Decorative member of a decorative group</text:p></draw:text-box>
     </draw:frame>
    </draw:g>
   </draw:page>
  </office:presentation>
 </office:body>
</office:document>
