    <presentation:notes draw:style-name="dp5" coext:guid="{A7A75AD8-7781-4FFB-AA63-1ACFCA11BA65}">
     <draw:page-thumbnail draw:style-name="gr25" draw:layer="layout" svg:width="19.798cm" svg:height="11.136cm" svg:x="0.6cm" svg:y="2.257cm" draw:page-number="5" presentation:class="page"/>
     <draw:frame presentation:style-name="pr32" draw:text-style-name="P51" draw:layer="layout" svg:width="16.799cm" svg:height="13.364cm" svg:x="2.1cm" svg:y="14.107cm" presentation:class="notes" presentation:placeholder="true" presentation:user-transformed="true">
      <draw:text-box/>
     </draw:frame>
