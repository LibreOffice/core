   </draw:page>
   <draw:page draw:name="page6" draw:style-name="dp11" draw:master-page-name="Default" presentation:presentation-page-layout-name="AL2T1" presentation:use-footer-name="ftr1" presentation:use-date-time-name="dtd1" coext:guid="{8C6E7181-0896-42A7-8C72-117F139D48EB}" xml:id="id11" draw:id="id11">
    <office:forms form:automatic-focus="false" form:apply-design-mode="false"/>
    <draw:frame presentation:style-name="pr34" draw:text-style-name="P48" draw:layer="layout" svg:width="25.191cm" svg:height="2.63cm" svg:x="1.398cm" svg:y="0.626cm" presentation:class="title" presentation:user-transformed="true">
     <draw:text-box>
      <text:p text:style-name="P52"><text:span text:style-name="T10">Advantages of Collabora Online</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr30" draw:text-style-name="P57" draw:layer="layout" svg:width="8.149cm" svg:height="1.748cm" svg:x="2cm" svg:y="14cm">
     <draw:text-box>
      <text:p text:style-name="P56"><text:span text:style-name="T14">Slide Transition</text:span><text:span text:style-name="T15">: Shape (Plus)</text:span></text:p>
      <text:p text:style-name="P56"><text:span text:style-name="T14">Animation</text:span><text:span text:style-name="T15">: Venetian Blinds (Exit)</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame presentation:style-name="pr36" draw:text-style-name="P64" draw:layer="layout" svg:width="25.191cm" svg:height="9.133cm" svg:x="1.398cm" svg:y="3.682cm" presentation:class="outline" presentation:user-transformed="true">
     <draw:text-box>
      <text:list text:style-name="L6">
       <text:list-item>
        <text:p xml:id="id12" text:id="id12" text:style-name="P63"><text:span text:style-name="T19">Open-source nature:</text:span></text:p>
        <text:p xml:id="id13" text:id="id13" text:style-name="P63"><text:span text:style-name="T20">Collabobra Online’s code is 100% open source; and it is built on the Open source LibreOffice codebase. This gives transparency, and the ability for anyone to contribute to the project as they like.</text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p xml:id="id14" text:id="id14" text:style-name="P63"><text:span text:style-name="T19">Security features:</text:span></text:p>
        <text:p xml:id="id15" text:id="id15" text:style-name="P63"><text:span text:style-name="T20">Collabora Office prioritizes security with encryption, access controls, and regular updates, ensuring the confidentiality and integrity of user data.</text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p xml:id="id16" text:id="id16" text:style-name="P63"><text:span text:style-name="T20">It also ensures you can control your own compute and networking on-premise, and not let your data out of your site.</text:span></text:p>
       </text:list-item>
      </text:list>
     </draw:text-box>
    </draw:frame>
    <anim:par presentation:node-type="timing-root">
     <anim:par smil:begin="id11.begin">
