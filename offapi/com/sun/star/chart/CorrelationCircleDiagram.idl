module com {  module sun {  module star {  module chart {

/** a service for correlation circle plots.

    <p>Each series holds one feature column together with the two dimension
    columns every series shares, and stands for one point, at the correlation of
    the feature with each of the two dimensions.</p>
 */
service CorrelationCircleDiagram
{
    service com::sun::star::chart::Diagram;
    service com::sun::star::chart::ChartAxisXSupplier;
    service com::sun::star::chart::ChartTwoAxisYSupplier;
};

}; }; }; };

