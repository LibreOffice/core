module com { module sun { module star { module script { module provider {

/**
   A subclass of ScriptFrameworkErrorException that can be used when
   an attempt is made to execute a non-existant script. This gives
   some extra information about the location of the script.
*/
exception ScriptMissingException : ScriptFrameworkErrorException {
    /** Location of the library, such as whether it is in user macros
        or embedded in a document.
     */
    string location;
    /** Name of the library containing the module
     */
    string library;
    /** Name of the module containing the script
     */
    string moduleName;
    /** Name of the script */
    string name;
};

}; }; }; }; }; // ::com::sun::star::script::provider

