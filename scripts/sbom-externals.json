{
    "_comment": [
        "Metadata for third-party components of Collabora Online that cannot be",
        "discovered mechanically, consumed by scripts/create-sbom.py.",
        "engine_externals: statically linked C++ libraries built in the engine tree;",
        "  version and source tarball sha256 come from the engine's download.lst",
        "  (tarball_var names the variable prefix there).",
        "bundled: components contained in another component (parent).",
        "vendored: sources checked into this repository; 'compiled' means the code",
        "  is compiled into our binaries (concluded license follows the engine",
        "  convention of MPL-2.0 for permissive code compiled into the product).",
        "npm_thirdparty: direct npm dependencies that ship to the browser, mapped to",
        "  the heading text used in THIRDPARTYLICENSES (policy: direct dependencies",
        "  are listed in THIRDPARTYLICENSES, transitive ones only in the SBOM).",
        "'thirdparty' strings are verified against THIRDPARTYLICENSES by --check."
    ],
    "engine_externals": {
        "poco": {
            "tarball_var": "POCO",
            "vendor": "pocoproject",
            "url": "https://pocoproject.org/",
            "declared": "BSL-1.0",
            "concluded": "MPL-2.0",
            "thirdparty": "POCO C++ Libraries"
        },
        "openssl": {
            "tarball_var": "OPENSSL",
            "vendor": "openssl",
            "url": "https://www.openssl.org/",
            "declared": "Apache-2.0",
            "concluded": "MPL-2.0",
            "thirdparty": "OpenSSL"
        },
        "zlib": {
            "tarball_var": "ZLIB",
            "vendor": "zlib",
            "url": "http://www.zlib.net/",
            "declared": "Zlib",
            "concluded": "MPL-2.0",
            "thirdparty": "zlib"
        },
        "zstd": {
            "tarball_var": "ZSTD",
            "vendor": "facebook",
            "url": "https://facebook.github.io/zstd/",
            "declared": "BSD-3-Clause OR GPL-2.0-only",
            "concluded": "MPL-2.0",
            "thirdparty": "Zstandard"
        },
        "libpng": {
            "tarball_var": "LIBPNG",
            "vendor": "libpng",
            "url": "http://www.libpng.org/",
            "declared": "Libpng",
            "concluded": "MPL-2.0",
            "thirdparty": "libpng"
        },
        "expat": {
            "tarball_var": "EXPAT",
