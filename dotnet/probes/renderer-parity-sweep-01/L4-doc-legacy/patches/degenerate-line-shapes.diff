+        //
+        // Both edges coinciding in *both* axes is still nothing to draw, and a negative extent is a
+        // malformed record rather than a rule.
+        if (anchor.Width < 0 || anchor.Height < 0) return null;
+        if (anchor.Width <= 0 && anchor.Height <= 0) return null;
+        if (!isLine && (anchor.Width <= 0 || anchor.Height <= 0)) return null;
