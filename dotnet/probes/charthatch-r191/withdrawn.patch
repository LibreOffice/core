+    /// <summary>
+    /// Fills an outline with a paint, expanding a hatch into the commands a sink understands.
+    /// </summary>
+    /// <remarks>
+    /// <para>
+    /// A hatch is the one <see cref="Paint"/> kind no backend implements, so it has to be expanded
+    /// at the last point that still knows the shape's own outline — and it has to be expanded in
+    /// <em>one</em> place, for the reason the note on this class gives. Every caller that paints a
+    /// <see cref="Paint"/> onto an <see cref="IDrawingSink"/> and may be handed a hatch comes
+    /// here: slide shapes, and a chart's own two backdrops on all three tracks.
+    /// </para>
+    /// <para>
+    /// Clipped to the outline rather than intersected with it, because a hatch fills a rounded
+    /// rectangle and a chevron as readily as a box and the segments <see cref="Lines"/> produces
+    /// span the outline's whole bounding box. The background goes down first, when the hatch has
+    /// one, exactly as <c>FillHatchPrimitive2D</c> decomposes it.
+    /// </para>
+    /// </remarks>
+    /// <param name="outline">The region to fill.</param>
+    /// <param name="fill">The paint.</param>
+    /// <param name="sink">Where to draw.</param>
+    public static void Fill(GraphicsPath outline, Paint fill, IDrawingSink sink)
+    {
+        ArgumentNullException.ThrowIfNull(outline);
+        ArgumentNullException.ThrowIfNull(fill);
+        ArgumentNullException.ThrowIfNull(sink);
+
+        if (fill is not HatchPaint hatch)
+        {
+            sink.FillPath(outline, fill);
+            return;
+        }
+
+        if (hatch.Background is { } background) sink.FillPath(outline, Paint.Solid(background));
+
+        Stroke pen = new(Paint.Solid(hatch.LineColour), Length.Zero);
+
+        sink.Save();
+        try
+        {
+            sink.ClipPath(outline);
+
+            foreach ((DocPoint from, DocPoint to) in Lines(BoxOf(outline), hatch))
+            {
+                sink.StrokePath(new GraphicsPath().MoveTo(from).LineTo(to), pen);
+            }
+        }
+        finally
+        {
+            sink.Restore();
+        }
+    }
+
+    /// <summary>The bounding box of a path's own points.</summary>
+    /// <remarks>
+    /// Control points included, which overstates a curved outline's box slightly and is right
+    /// here: the hatch is clipped to the outline, so a box that is too large costs a few segments
+    /// the clip discards and a box that is too small leaves a corner unhatched.
+    /// </remarks>
+    private static DocRect BoxOf(GraphicsPath path)
+    {
+        long left = long.MaxValue, top = long.MaxValue;
+        long right = long.MinValue, bottom = long.MinValue;
+
+        foreach (PathCommand command in path.Commands)
+        {
+            if (command.Verb == PathVerb.Close) continue;
+
+            foreach (DocPoint point in command.Verb == PathVerb.CubicTo
+                         ? (ReadOnlySpan<DocPoint>)
+                           [command.Point, command.Control1, command.Control2]
+                         : (ReadOnlySpan<DocPoint>)[command.Point])
+            {
+                left = Math.Min(left, point.X.Emu);
+                top = Math.Min(top, point.Y.Emu);
+                right = Math.Max(right, point.X.Emu);
+                bottom = Math.Max(bottom, point.Y.Emu);
+            }
+        }
+
+        return right <= left || bottom <= top
+            ? DocRect.Empty
+            : new DocRect(
+                Length.FromEmu(left),
+                Length.FromEmu(top),
+                Length.FromEmu(right - left),
+                Length.FromEmu(bottom - top));
+    }
 }
