Worksheets(&quot;1&quot;).Range(&quot;p27&quot;) = Worksheets(&quot;lots&quot;).Cells(lotrow, 33)

EnterLotData.Show
movelot
Worksheets(&quot;summary&quot;).Select
End Sub


