     <ooo:module ooo:name="Module4">
      <ooo:source-code>Rem Attribute VBA_ModuleType=VBAModule
Option VBASupport 1

Sub clearall()
&apos;
&apos; clearall Macro
&apos; Macro recorded 10/13/00 by Rodney N. Joel
&apos;
clears = 0
clear.Show
Worksheets(&quot;lots&quot;).Select

If Worksheets(&quot;summary&quot;).Range(&quot;r1&quot;) = 1 Then
    Range(&quot;A2:BE325&quot;).Select
    Selection.ClearContents
    Range(&quot;A2&quot;).Select
Else: GoTo skip
End If
skip:
Worksheets(&quot;summary&quot;).Select
End Sub

Sub printsummary()
Worksheets(&quot;summary&quot;).Select
Call changeprintarea

ActiveWindow.SelectedSheets.PrintOut Copies:=1, Collate:=True
Call resetprintarea

End Sub
Sub changeprintarea()
&apos;
&apos; changeprintarea Macro
&apos; Macro recorded 11/29/2006 by  RNJ
  &apos; macro to shrink print area of summary sheet based on number of lots
&apos;

Dim nlots As Long, endlots As Long
&apos;reset nlots to zero
nlots = 0

nlots = Worksheets(&quot;summary&quot;).Range(&quot;n10&quot;) + 13


&apos;spreadsheet currently set to allow 300 lots starting in row 12
endlots = 313
 With Worksheets(&quot;summary&quot;)
 
&apos;
Worksheets(&quot;summary&quot;).Unprotect


 Rows(nlots &amp; &quot;:&quot; &amp; endlots).EntireRow.Hidden = True
 
    End With
    Worksheets(&quot;summary&quot;).Protect
    
End Sub
Sub resetprintarea()
  &apos;macro to reset row height on summary sheet after printing
With Worksheets(&quot;summary&quot;)
Worksheets(&quot;summary&quot;).Unprotect

Rows(&quot;12:313&quot;).EntireRow.Hidden = False
&apos;Selection.RowHeight = 12.5

Worksheets(&quot;summary&quot;).Protect

End With

End Sub


      </ooo:source-code>
     </ooo:module>
     <ooo:module ooo:name="Module1">
      <ooo:source-code>Rem Attribute VBA_ModuleType=VBAModule
Option VBASupport 1
Sub lot1()
&apos;
&apos; lot1 Macro
&apos; Macro recorded 10/12/00 by Rodney N. Joel

Dim lotno
&apos;set lot number to start at zero
lotno = 0
enterlotno.Show

lotno = Worksheets(&quot;1&quot;).Range(&quot;d9&quot;)
Worksheets(&quot;lots&quot;).Range(&quot;a1&quot;) = lotno
&apos;save basic lot parameters that probably span lot to lot
unitprice = Worksheets(&quot;1&quot;).Range(&quot;d11&quot;) &apos; unit price
designstr = Worksheets(&quot;1&quot;).Range(&quot;d13&quot;) &apos;Design strength
designthck = Worksheets(&quot;1&quot;).Range(&quot;d14&quot;) &apos; Design thickness

Worksheets(&quot;1&quot;).Select
&apos;
&apos; loop over data if existing info is desired
lotrow = lotno + 1
If Worksheets(&quot;lots&quot;).Cells(lotrow, 1) &gt; &quot;&quot; Then
    existlotdata.Show
If Worksheets(&quot;summary&quot;).Range(&quot;r2&quot;) = 1 Then
 GoTo Reset:
Else
    GoTo skipreset:
End If
End If

Reset:
resetspreadsheet

&apos;set initial lot parameters
Worksheets(&quot;1&quot;).Range(&quot;d9&quot;) = lotno
Worksheets(&quot;1&quot;).Range(&quot;d11&quot;) = unitprice
Worksheets(&quot;1&quot;).Range(&quot;d13&quot;) = designstr
Worksheets(&quot;1&quot;).Range(&quot;d14&quot;) = designthck

EnterLotData.Show
movelot
Worksheets(&quot;summary&quot;).Select
GoTo endz

skipreset:
reviewlotsimple
endz:

End Sub

Sub movelot()

lotno = Worksheets(&quot;lots&quot;).Range(&quot;a1&quot;)
&apos;increase lot # by one to find correct row (offset by one)
lotrow = lotno + 1
&apos;lot number
Worksheets(&quot;lots&quot;).Cells(lotrow, 1) = Worksheets(&quot;1&quot;).Range(&quot;d9&quot;)
&apos;date
Worksheets(&quot;lots&quot;).Cells(lotrow, 2) = Worksheets(&quot;1&quot;).Range(&quot;d6&quot;)
&apos;location
Worksheets(&quot;lots&quot;).Cells(lotrow, 3) = Worksheets(&quot;1&quot;).Range(&quot;d7&quot;)
&apos; test report
Worksheets(&quot;lots&quot;).Cells(lotrow, 4) = Worksheets(&quot;1&quot;).Range(&quot;d8&quot;)
&apos;lot number
Worksheets(&quot;lots&quot;).Cells(lotrow, 5) = Worksheets(&quot;1&quot;).Range(&quot;d9&quot;)
&apos;lot quantity
Worksheets(&quot;lots&quot;).Cells(lotrow, 6) = Worksheets(&quot;1&quot;).Range(&quot;d10&quot;)
&apos;unit price
Worksheets(&quot;lots&quot;).Cells(lotrow, 7) = Worksheets(&quot;1&quot;).Range(&quot;d11&quot;)
&apos;design strength
Worksheets(&quot;lots&quot;).Cells(lotrow, 8) = Worksheets(&quot;1&quot;).Range(&quot;d13&quot;)
&apos;design thickness
Worksheets(&quot;lots&quot;).Cells(lotrow, 9) = Worksheets(&quot;1&quot;).Range(&quot;d14&quot;)
&apos;strength sublot1-1
Worksheets(&quot;lots&quot;).Cells(lotrow, 10) = Worksheets(&quot;1&quot;).Range(&quot;b21&quot;)
&apos;strength sublot1-2
Worksheets(&quot;lots&quot;).Cells(lotrow, 11) = Worksheets(&quot;1&quot;).Range(&quot;b22&quot;)
&apos;strength sublot2-1
Worksheets(&quot;lots&quot;).Cells(lotrow, 12) = Worksheets(&quot;1&quot;).Range(&quot;d21&quot;)
