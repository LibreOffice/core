<Project>

  <!--
    Central package version management for the Paperless solution.
    Individual projects use <PackageReference Include="X" /> with no Version attribute.

    LICENSING NOTE - read before adding a dependency to a src/ library:
      Paperless ships as a set of redistributable NuGet libraries, so every
      transitive dependency's licence becomes our users' problem.

      * Safe (permissive):  SkiaSharp (MIT), HarfBuzzSharp (MIT), PdfPig (Apache-2.0),
                            HtmlAgilityPack (MIT), BouncyCastle (MIT),
                            OpenMcdf (MPL-2.0), SharpCompress (MIT).

      * DO NOT USE - Six Labors packages.
                            VERIFIED 2026-07-30 by building against them: both
                            SixLabors.Fonts 3.0.0 and SixLabors.ImageSharp 4.0.0
                            ship an MSBuild target that FAILS THE BUILD outright
                            unless a purchased licence key is supplied
                            ($(SixLaborsLicenseKey) / sixlabors.lic):
                              "No Six Labors license found ...
                               Please obtain a license from https://sixlabors.com/pricing/"
                            This is not merely a licence-text concern - it is a hard
                            build-time gate, and it would be inherited by anyone
                            building from our source. Neither package is referenced
                            by any library in the default build.

                            Consequences, and what we do instead:
                              - Text shaping     -> HarfBuzzSharp, which is what
                                                    LibreOffice itself shapes with.
                              - Font metrics     -> a small hand-rolled OpenType table
                                                    reader in Paperless.Text. Wanted
                                                    anyway: matching LibreOffice's line
                                                    heights needs raw hhea/OS-2 table
                                                    access and our own precedence rules,
                                                    not a library's opinion of them.
                              - Raster encode/decode -> SkiaSharp (MIT).
                            SixLabors.ImageSharp remains available behind the opt-in
                            EnableImageSharpBackend flag for anyone who does hold a
                            licence. It is off by default and nothing depends on it.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Rasterisation and text shaping">
    <PackageVersion Include="SkiaSharp" Version="4.150.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="4.150.1" />
    <PackageVersion Include="SkiaSharp.HarfBuzz" Version="4.150.1" />
    <PackageVersion Include="HarfBuzzSharp" Version="14.2.1.1" />
  </ItemGroup>

  <ItemGroup Label="Opt-in only (EnableImageSharpBackend) - requires a purchased Six Labors licence">
    <PackageVersion Include="SixLabors.ImageSharp" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup Label="Containers and crypto">
    <!-- OLE2 / Compound File Binary. Candidate for replacement by a hand-rolled
         Span-based reader: we need tolerance of malformed real-world files. -->
    <PackageVersion Include="OpenMcdf" Version="3.2.0" />
    <PackageVersion Include="SharpCompress" Version="1.0.0" />
    <!-- Legacy office crypto (RC4, Blowfish CFB for ODF) that the BCL lacks. -->
    <PackageVersion Include="BouncyCastle.Cryptography" Version="2.7.0" />
  </ItemGroup>

  <ItemGroup Label="Markup">
    <PackageVersion Include="HtmlAgilityPack" Version="1.12.4" />
  </ItemGroup>

  <ItemGroup Label="Tooling">
    <PackageVersion Include="System.CommandLine" Version="2.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup Label="Test-only">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <!-- Reading LibreOffice's reference PDFs in the fidelity harness. -->
    <PackageVersion Include="PdfPig" Version="0.1.15" />
    <!-- Rasterising reference PDFs in-process (pdfium) so the fidelity harness
         does not require poppler-utils on the machine. -->
    <PackageVersion Include="PDFtoImage" Version="5.3.0" />
  </ItemGroup>

</Project>
