<Project>

  <!--
    Shared MSBuild settings for every project in the Paperless solution.
    Project-specific overrides belong in the individual .csproj.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- Analysis / correctness -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors></WarningsNotAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Determinism: byte-identical builds matter for golden-image test caching -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- We ship a lot of binary-format parsing; unsafe/Span-heavy code is expected. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: missing XML comment. Re-enable per-project once a lib's API stabilises. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- NuGet package metadata, applied to every shipped library. -->
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix Condition="'$(VersionSuffix)' == ''">alpha</VersionSuffix>
    <Authors>Paperless contributors</Authors>
    <Product>Paperless</Product>
    <PackageProjectUrl>https://github.com/theolivenbaum/libreoffice-core</PackageProjectUrl>
    <RepositoryUrl>https://github.com/theolivenbaum/libreoffice-core</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    <PackageTags>office;document;docx;xlsx;pptx;odf;extraction;rendering</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- Libraries under src/ are packable; tests and tools are not. -->
  <PropertyGroup Condition="$([System.String]::Copy('$(MSBuildProjectDirectory)').Contains('$([System.IO.Path]::DirectorySeparatorChar)src$([System.IO.Path]::DirectorySeparatorChar)'))">
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!--
    Projects that *run* build for this machine's architecture only.

    SkiaSharp and HarfBuzzSharp ship native binaries for twenty-one runtime identifiers, and a
    RID-agnostic build copies every one of them into every output directory: 687 MB per test
    project, of which the host can execute exactly one. Ten such projects, across several
    worktrees, is enough to exhaust a container's whole disk allowance — which it did, repeatedly,
    until this was set.

    Naming the RID is what stops the copy at its source. The alternatives both cost more: linking
    the assets instead of copying them points the output at the NuGet cache, so clearing the cache
    leaves dangling links; deleting them after each build fights the incremental copy, which
    faithfully restores them next time.

    The RID is computed rather than written down, so this stays correct on arm64 and macOS rather
    than pinning linux-x64 and breaking there. Two traps sit in that computation, and both look like
    the setting simply having no effect:

      * $(NETCoreSdkPortableRuntimeIdentifier) is not available here. Directory.Build.props is
        imported by Microsoft.Common.props *before* the SDK defines it, so reading it yields an
        empty string and sets RuntimeIdentifier to nothing at all.
      * RuntimeInformation.RuntimeIdentifier gives the *specific* RID — "ubuntu.24.04-x64". Native
        packages ship portable RIDs ("linux-x64"), and .NET 8 stopped using the RID graph to map one
        onto the other, so a specific RID resolves no native asset whatsoever and the failure shows
        up only when a test tries to load libSkiaSharp.

    Hence the portable RID is assembled from the OS and the process architecture. A musl host would
    need "linux-musl-*" and is not detected; override RuntimeIdentifier on the command line there.

    Deliberately *not* applied to the libraries under src/: a RID-specific build produces a
    RID-specific package, and these are portable libraries. Nothing packs a test or a tool, so
    they are free to be specific.

    Building for another platform still works — `-r win-x64` arrives as a global property and those
    beat anything set here. But it has to be passed to *every* command in the sequence:
    `dotnet build -r win-x64` followed by a bare `dotnet test` silently rebuilds for the host RID
    into a second output directory rather than testing what was just built.
  -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests')) or $(MSBuildProjectName.EndsWith('.Cli'))">
    <_PaperlessHostArch>$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</_PaperlessHostArch>
    <_PaperlessHostOs Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux</_PaperlessHostOs>
    <_PaperlessHostOs Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx</_PaperlessHostOs>
    <_PaperlessHostOs Condition="$([MSBuild]::IsOSPlatform('Windows'))">win</_PaperlessHostOs>
    <RuntimeIdentifier Condition="'$(_PaperlessHostOs)' != ''">$(_PaperlessHostOs)-$(_PaperlessHostArch)</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

</Project>
