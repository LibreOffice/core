<Project>

  <!--
    Shared MSBuild settings for every project in the X-Ray.Office solution (dotnet/XRay.Office.slnx).
    Project-specific overrides belong in the individual .csproj.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- Analysis / correctness -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors></WarningsNotAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Determinism: byte-identical builds matter for golden-image test caching -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' or '$(TF_BUILD)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- We ship a lot of binary-format parsing; unsafe/Span-heavy code is expected. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: missing XML comment. Re-enable per-project once a lib's API stabilises. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!--
    NuGet package metadata, applied to every shipped library.

    The package ids are hyphenated as in the rest of the X-Ray family (X-Ray.Office,
    X-Ray.Office.Core, ...); the assemblies and namespaces are not (X-Ray.Office, XRay.Office.Core),
    because a hyphen is not valid in a C# identifier. PackageId is derived from the project name
    below, so a new library under src/ gets the right id without saying so.

    The version here is the local default. The publishing pipeline
    (.devops/build-x-ray-office-nuget.yml) passes /p:Version with a CalVer number, which wins.

    Licence: MPL-2.0, because the port derives from LibreOffice's MPL-2.0 sources (COPYING.MPL at
    the repository root). XRay.Office.Text overrides it, since it also ships the bundled fonts,
    which carry their own licences; see that project file.
  -->
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix Condition="'$(VersionSuffix)' == ''">alpha</VersionSuffix>
    <Authors>Curiosity GmbH</Authors>
    <Company>Curiosity GmbH</Company>
    <Product>X-Ray.Office</Product>
    <PackageProjectUrl>https://github.com/curiosity-ai/x-ray-office/tree/master/dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/curiosity-ai/x-ray-office</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>logo.png</PackageIcon>
    <PackageTags>x-ray;office;document;docx;xlsx;pptx;doc;xls;ppt;odf;rtf;pdf;rendering;extraction;libreoffice</PackageTags>
    <!-- No .snupkg: a symbol package beside each .nupkg is a second push that can fail the first.
         The symbols are embedded in the assemblies instead, so stepping into the packages still works. -->
    <IncludeSymbols>false</IncludeSymbols>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!--
    Libraries under src/ are packable; everything else (tests, the test kit, the CLI, probes) is
    not. Tested against this file's own directory rather than by looking for "/src/" anywhere in
    the path, so a checkout that happens to live under some ~/src/ does not make every test
    project packable.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup Condition="$(MSBuildProjectDirectory.StartsWith('$(MSBuildThisFileDirectory)src'))">
    <IsPackable>true</IsPackable>
    <PackageId>$(MSBuildProjectName.Replace('XRay.Office', 'X-Ray.Office'))</PackageId>
  </PropertyGroup>

  <!-- One package README and the family icon, shared by every package. -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)assets/README.package.md" Pack="true" PackagePath="/README.md" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)assets/logo.png" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!--
    Projects that *run* build for this machine's architecture only.

    SkiaSharp and HarfBuzzSharp ship native binaries for twenty-one runtime identifiers, and a
    RID-agnostic build copies every one of them into every output directory: 687 MB per test
    project, of which the host can execute exactly one. Ten such projects, across several
    worktrees, is enough to exhaust a container's whole disk allowance — which it did, repeatedly,
    until this was set.

    Naming the RID is what stops the copy at its source. The alternatives both cost more: linking
    the assets instead of copying them points the output at the NuGet cache, so clearing the cache
    leaves dangling links; deleting them after each build fights the incremental copy, which
    faithfully restores them next time.

    The RID is computed rather than written down, so this stays correct on arm64 and macOS rather
    than pinning linux-x64 and breaking there. Two traps sit in that computation, and both look like
    the setting simply having no effect:

      * $(NETCoreSdkPortableRuntimeIdentifier) is not available here. Directory.Build.props is
        imported by Microsoft.Common.props *before* the SDK defines it, so reading it yields an
        empty string and sets RuntimeIdentifier to nothing at all.
      * RuntimeInformation.RuntimeIdentifier gives the *specific* RID — "ubuntu.24.04-x64". Native
        packages ship portable RIDs ("linux-x64"), and .NET 8 stopped using the RID graph to map one
        onto the other, so a specific RID resolves no native asset whatsoever and the failure shows
        up only when a test tries to load libSkiaSharp.

    Hence the portable RID is assembled from the OS and the process architecture. A musl host would
    need "linux-musl-*" and is not detected; override RuntimeIdentifier on the command line there.

    Deliberately *not* applied to the libraries under src/: a RID-specific build produces a
    RID-specific package, and these are portable libraries. Nothing packs a test or a tool, so
    they are free to be specific.

    Building for another platform still works — `-r win-x64` arrives as a global property and those
    beat anything set here. But it has to be passed to *every* command in the sequence:
    `dotnet build -r win-x64` followed by a bare `dotnet test` silently rebuilds for the host RID
    into a second output directory rather than testing what was just built.
  -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests')) or $(MSBuildProjectName.EndsWith('.Cli'))">
    <_XRayOfficeHostArch>$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</_XRayOfficeHostArch>
    <_XRayOfficeHostOs Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux</_XRayOfficeHostOs>
    <_XRayOfficeHostOs Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx</_XRayOfficeHostOs>
    <_XRayOfficeHostOs Condition="$([MSBuild]::IsOSPlatform('Windows'))">win</_XRayOfficeHostOs>
    <RuntimeIdentifier Condition="'$(_XRayOfficeHostOs)' != ''">$(_XRayOfficeHostOs)-$(_XRayOfficeHostArch)</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

</Project>
