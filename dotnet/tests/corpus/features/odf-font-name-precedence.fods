<?xml version="1.0" encoding="UTF-8"?>
<!--
  style:font-name and fo:font-family are two spellings of one item, so the *level* decides.

  LibreOffice imports style:font-name through XMLTextImportPropertyMapper::handleSpecialItem's
  CTF_FONTNAME branch, which hands the office:font-face-decls entry to
  XMLFontStylesContext::FillProperties and fills the CTF_FONTFAMILYNAME slot beside it
  (xmloff/source/text/txtimppr.cxx:58-101). fo:font-family writes that same slot directly. One
  slot, one item: a child style stating either spelling shadows whatever its parent stated.

  A reader resolving the two spellings independently, each through the whole parent chain, gets
  this backwards whenever a parent states fo:font-family and its child states style:font-name —
  and that is the shape LibreOffice writes for every workbook converted to ODF: the named Default
  cell style carries both spellings and the automatic cell styles carry style:font-name alone.

  The cell below asks for Arial and inherits Calibri. LibreOffice 26.2.4.2 renders it in
  LiberationSans; a reader taking the inherited fo:font-family renders it in Carlito.
-->
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.spreadsheet">
 <office:font-face-decls>
  <style:font-face style:name="Arial" svg:font-family="Arial" style:font-family-generic="swiss"/>
  <style:font-face style:name="Calibri" svg:font-family="Calibri" style:font-family-generic="swiss"/>
 </office:font-face-decls>
 <office:styles>
  <style:style style:name="Default" style:family="table-cell"><style:text-properties style:font-name="Calibri" fo:font-family="Calibri" fo:font-size="11pt"/></style:style>
 </office:styles>
 <office:automatic-styles>
  <style:style style:name="co1" style:family="table-column"><style:table-column-properties style:column-width="3in"/></style:style>
  <style:style style:name="ceA" style:family="table-cell" style:parent-style-name="Default"><style:text-properties style:font-name="Arial" fo:font-size="9pt"/></style:style>
  <style:style style:name="pm1" style:family="page-layout"><style:page-layout-properties fo:page-width="8.5in" fo:page-height="11in" fo:margin-top="0.5in" fo:margin-bottom="0.5in" fo:margin-left="0.5in" fo:margin-right="0.5in"/></style:style>
 </office:automatic-styles>
 <office:master-styles><style:master-page style:name="Default" style:page-layout-name="pm1"/></office:master-styles>
 <office:body><office:spreadsheet>
  <table:table table:name="S1">
   <table:table-column table:style-name="co1"/>
   <table:table-row><table:table-cell table:style-name="ceA" office:value-type="string"><text:p>Hamburgefonstiv</text:p></table:table-cell></table:table-row>
  </table:table>
 </office:spreadsheet></office:body>
</office:document>
