<?xml version="1.0" encoding="UTF-8"?>
<!--
  An ODF sheet recalculates its automatic row heights for its first 200 rows only.

  ScXMLTableRowContext::endFastElement adds every row block to the recalculation ranges and then
  takes it straight back out when the block ends past row 200 and its style carries a stored
  height alongside the optimal flag (sc/source/filter/xml/xmlrowi.cxx:215-244 (the test at :228), under the comment
  "recalc only the first 200 row in case of optimal document loading", with
  ScXMLRowImportPropertyMapper::finished at xmlstyli.cxx:245-258 moving the height into the
  optimal property so that FindProperty(CTF_SC_ROWHEIGHT) is null for exactly such a style).

  Every one of these 206 rows states style:row-height="0.3in" — 21.6 pt — with the optimal
  flag, one table:table-row element each, so the block index is the row index. The page is 200 cm
  tall so that all of them are on one page and the pitch can be read straight off it.

  LibreOffice 26.2.4.2's own PDF of this file, baseline to baseline (a cell is bottom-aligned by
  default, so the gap after a row's text is the NEXT row's height):

    r0 .. r200    12.78 pt apart — the recomputed height of 10 pt text
    r200 -> r201  21.60 pt       — the first row past the limit, at its stated height
    r201 .. r205  21.60 pt

  So rows 0 to 200 inclusive are recalculated and row 201 onwards is not, which is
  `nCurrentRow > 200` on a zero-based row index exactly.
-->
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
 xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
 xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
 xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
 xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
 office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.spreadsheet">
 <office:automatic-styles>
  <style:style style:name="co1" style:family="table-column">
   <style:table-column-properties style:column-width="4cm"/>
  </style:style>
  <style:style style:name="ro1" style:family="table-row">
   <style:table-row-properties style:row-height="0.3in" style:use-optimal-row-height="true"/>
  </style:style>
  <style:page-layout style:name="pm1">
   <style:page-layout-properties fo:page-width="21cm" fo:page-height="200cm"
    fo:margin-left="2cm" fo:margin-right="2cm" fo:margin-top="2cm" fo:margin-bottom="2cm"
    style:print-orientation="portrait"/>
  </style:page-layout>
 </office:automatic-styles>
 <office:master-styles>
  <style:master-page style:name="Default" style:page-layout-name="pm1"/>
 </office:master-styles>
 <office:body>
  <office:spreadsheet>
   <table:table table:name="Probe">
