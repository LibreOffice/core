<?xml version="1.0" encoding="UTF-8"?>
<!-- A floating table: a `draw:frame` holding nothing but a table, marked splittable.  The page is
     3 in tall with half-inch margins, so the twelve rows cannot fit on one and LibreOffice breaks
     the fly.  The frame's own style names `Frame` as its parent, without which the importer would
     make a drawing shape of it rather than a Writer fly (#i51726#).  Ground truth is LibreOffice
     26.2.4.2's own PDF of this file. -->
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
 xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
 xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
 xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
 xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0"
 xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
 xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0"
 xmlns:loext="urn:org:documentfoundation:names:experimental:office:xmlns:loext:1.0"
 office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.text">
 <office:styles>
  <style:style style:name="Frame" style:family="graphic">
   <style:graphic-properties style:wrap="parallel" style:vertical-pos="top"
    style:vertical-rel="paragraph" style:horizontal-pos="center" style:horizontal-rel="paragraph"/>
  </style:style>
 </office:styles>
 <office:automatic-styles>
  <style:page-layout style:name="pm1">
   <style:page-layout-properties fo:page-width="8.5in" fo:page-height="3in"
    fo:margin-top="0.5in" fo:margin-bottom="0.5in" fo:margin-left="0.5in" fo:margin-right="0.5in"/>
  </style:page-layout>
  <style:style style:name="fr1" style:family="graphic" style:parent-style-name="Frame">
   <style:graphic-properties fo:margin-left="0in" fo:margin-right="0in" fo:margin-top="0in"
    fo:margin-bottom="0in" style:vertical-pos="from-top" style:vertical-rel="paragraph"
    style:horizontal-pos="from-left" style:horizontal-rel="page" fo:padding="0in" fo:border="none"/>
  </style:style>
  <style:style style:name="Tbl" style:family="table">
   <style:table-properties style:width="3in" fo:margin-left="0in" table:align="left"/>
  </style:style>
  <style:style style:name="Col" style:family="table-column">
   <style:table-column-properties style:column-width="3in"/>
  </style:style>
  <style:style style:name="Cell" style:family="table-cell">
   <style:table-cell-properties fo:padding="0in" fo:border="none"/>
  </style:style>
  <style:style style:name="P1" style:family="paragraph" style:parent-style-name="Standard">
   <style:text-properties style:font-name="Liberation Serif" fo:font-size="12pt"/>
  </style:style>
 </office:automatic-styles>
 <office:master-styles>
  <style:master-page style:name="Standard" style:page-layout-name="pm1"/>
 </office:master-styles>
 <office:body><office:text>
  <text:p text:style-name="P1"><draw:frame draw:style-name="fr1" draw:name="Frame1"
    text:anchor-type="paragraph" svg:x="0.75in" svg:y="0.25in" svg:width="3in" draw:z-index="0"
    loext:may-break-between-pages="true"><draw:text-box fo:min-height="0in"
    ><table:table table:name="Floating" table:style-name="Tbl">
     <table:table-column table:style-name="Col"/>
     <table:table-row><table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="P1">ROWA</text:p></table:table-cell></table:table-row>
     <table:table-row><table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="P1">ROWB</text:p></table:table-cell></table:table-row>
     <table:table-row><table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="P1">ROWC</text:p></table:table-cell></table:table-row>
     <table:table-row><table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="P1">ROWD</text:p></table:table-cell></table:table-row>
     <table:table-row><table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="P1">ROWE</text:p></table:table-cell></table:table-row>
     <table:table-row><table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="P1">ROWF</text:p></table:table-cell></table:table-row>
     <table:table-row><table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="P1">ROWG</text:p></table:table-cell></table:table-row>
     <table:table-row><table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="P1">ROWH</text:p></table:table-cell></table:table-row>
     <table:table-row><table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="P1">ROWI</text:p></table:table-cell></table:table-row>
     <table:table-row><table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="P1">ROWJ</text:p></table:table-cell></table:table-row>
     <table:table-row><table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="P1">ROWK</text:p></table:table-cell></table:table-row>
     <table:table-row><table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="P1">ROWL</text:p></table:table-cell></table:table-row>
    </table:table></draw:text-box></draw:frame>ANCHOR</text:p>
 </office:text></office:body>
</office:document>
