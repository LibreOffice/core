<?xml version="1.0" encoding="UTF-8"?>
<!--
  What an overflowing cell is measured by, when the importer made several paragraphs of it.

  A string too wide for its column spills into the empty cells beside it and Calc widens the
  print area to cover all of it (ScTable::ExtendPrintArea, sc/source/core/data/table1.cxx:2127,
  per cell in MaybeAddExtraColumn at :2218). How wide "all of it" is comes from
  ScColumn::GetNeededSize, which sends an EditTextObject cell through the EditEngine
  (column2.cxx:297-300), formats it against a paper 1000000 units wide so that nothing breaks
  (:447), and reads pEngine->CalcTextWidth() (:565) — a maximum over the paragraphs
  (editeng/source/editeng/impedit2.cxx:3507-3525), not the length of the string.

  Calc's ODF filter makes a paragraph of every hard break, so both sheets below hold the same
  sixty M's in a 2 cm no-wrap column on a 10 cm body, differing only in whether the separators
  are newlines or spaces.

  LibreOffice 26.2.4.2's own PDF of this file is FOUR pages:

    Broken   6 paragraphs of MMMMMMMMMM   1 page  — as wide as one of them
    Joined   one line of the same 65 characters   3 pages

  Measured on its own, the Broken sheet alone is 1 page and the Joined sheet alone is 3.
-->
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
 xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
 xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
 xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
 xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
 office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.spreadsheet">
 <office:automatic-styles>
  <style:style style:name="co1" style:family="table-column">
   <style:table-column-properties style:column-width="2cm"/>
  </style:style>
  <style:style style:name="ceFlat" style:family="table-cell">
   <style:table-cell-properties fo:wrap-option="no-wrap"/>
  </style:style>
  <style:page-layout style:name="pm1">
   <style:page-layout-properties fo:page-width="12cm" fo:page-height="12cm"
    fo:margin-left="1cm" fo:margin-right="1cm" fo:margin-top="1cm" fo:margin-bottom="1cm"
    style:print-orientation="portrait"/>
  </style:page-layout>
 </office:automatic-styles>
 <office:master-styles>
  <style:master-page style:name="Default" style:page-layout-name="pm1"/>
 </office:master-styles>
 <office:body>
  <office:spreadsheet>
   <table:table table:name="Broken">
    <table:table-column table:style-name="co1" table:number-columns-repeated="40"/>
    <table:table-row>
     <table:table-cell table:style-name="ceFlat" office:value-type="string"><text:p>MMMMMMMMMM
MMMMMMMMMM
MMMMMMMMMM
MMMMMMMMMM
MMMMMMMMMM
MMMMMMMMMM</text:p></table:table-cell>
    </table:table-row>
   </table:table>
   <table:table table:name="Joined">
    <table:table-column table:style-name="co1" table:number-columns-repeated="40"/>
    <table:table-row>
     <table:table-cell table:style-name="ceFlat" office:value-type="string"><text:p>MMMMMMMMMM MMMMMMMMMM MMMMMMMMMM MMMMMMMMMM MMMMMMMMMM MMMMMMMMMM</text:p></table:table-cell>
    </table:table-row>
   </table:table>
  </office:spreadsheet>
 </office:body>
</office:document>
