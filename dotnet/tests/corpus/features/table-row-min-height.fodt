<?xml version="1.0" encoding="UTF-8"?>
<office:document
    xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
    xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
    xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
    xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
    xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
    xmlns:dc="http://purl.org/dc/elements/1.1/"
    office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.text">
 <office:meta>
  <dc:title>Paperless table row minimum height and the page break</dc:title>
  <dc:subject>A row whose stated minimum height does not fit is moved whole rather than broken</dc:subject>
 </office:meta>
 <office:automatic-styles>
  <style:page-layout style:name="PL">
   <style:page-layout-properties fo:page-width="21cm" fo:page-height="10cm"
       fo:margin-left="2cm" fo:margin-right="2cm" fo:margin-top="1cm" fo:margin-bottom="1cm"/>
  </style:page-layout>
  <style:style style:name="Grid" style:family="table">
   <style:table-properties style:width="17cm" fo:margin-left="0cm"
       fo:margin-top="0cm" fo:margin-bottom="0cm" table:align="left"/>
  </style:style>
  <style:style style:name="Half" style:family="table-column">
   <style:table-column-properties style:column-width="8.5cm"/>
  </style:style>
  <style:style style:name="Cell" style:family="table-cell">
   <style:table-cell-properties fo:padding="0.1cm" style:vertical-align="top"/>
  </style:style>
  <style:style style:name="Plain" style:family="table-row">
   <style:table-row-properties style:min-row-height="0cm"/>
  </style:style>
  <style:style style:name="Floored" style:family="table-row">
   <style:table-row-properties style:min-row-height="5.2cm"/>
  </style:style>
 </office:automatic-styles>
 <office:styles>
  <style:style style:name="Body" style:family="paragraph">
   <style:paragraph-properties fo:text-align="start" fo:text-indent="0cm" fo:hyphenate="false"
       fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"
       fo:orphans="0" fo:widows="0"/>
   <style:text-properties style:font-name="Carlito" fo:font-family="Carlito" fo:font-size="11pt"
       fo:language="en" fo:country="GB"/>
  </style:style>
 </office:styles>
 <office:master-styles>
  <style:master-page style:name="Standard" style:page-layout-name="PL"/>
 </office:master-styles>
 <office:body><office:text>
   <text:p text:style-name="Body">Preamble before the floored table.</text:p>
   <table:table table:name="Grid" table:style-name="Grid">
    <table:table-column table:style-name="Half" table:number-columns-repeated="2"/>
    <table:table-row table:style-name="Plain">
     <table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="Body">Head row left one</text:p><text:p text:style-name="Body">Head row left two</text:p><text:p text:style-name="Body">Head row left three</text:p><text:p text:style-name="Body">Head row left four</text:p><text:p text:style-name="Body">Head row left five</text:p><text:p text:style-name="Body">Head row left six</text:p><text:p text:style-name="Body">Head row left seven</text:p><text:p text:style-name="Body">Head row left eight</text:p></table:table-cell>
     <table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="Body">Head row right one</text:p><text:p text:style-name="Body">Head row right two</text:p><text:p text:style-name="Body">Head row right three</text:p><text:p text:style-name="Body">Head row right four</text:p><text:p text:style-name="Body">Head row right five</text:p><text:p text:style-name="Body">Head row right six</text:p><text:p text:style-name="Body">Head row right seven</text:p><text:p text:style-name="Body">Head row right eight</text:p></table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Floored">
     <table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="Body">Floored row left one</text:p><text:p text:style-name="Body">Floored row left two</text:p><text:p text:style-name="Body">Floored row left three</text:p><text:p text:style-name="Body">Floored row left four</text:p><text:p text:style-name="Body">Floored row left five</text:p><text:p text:style-name="Body">Floored row left six</text:p><text:p text:style-name="Body">Floored row left seven</text:p><text:p text:style-name="Body">Floored row left eight</text:p><text:p text:style-name="Body">Floored row left nine</text:p><text:p text:style-name="Body">Floored row left ten</text:p><text:p text:style-name="Body">Floored row left eleven</text:p><text:p text:style-name="Body">Floored row left twelve</text:p></table:table-cell>
     <table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="Body">Floored row right one</text:p><text:p text:style-name="Body">Floored row right two</text:p><text:p text:style-name="Body">Floored row right three</text:p><text:p text:style-name="Body">Floored row right four</text:p><text:p text:style-name="Body">Floored row right five</text:p><text:p text:style-name="Body">Floored row right six</text:p><text:p text:style-name="Body">Floored row right seven</text:p><text:p text:style-name="Body">Floored row right eight</text:p><text:p text:style-name="Body">Floored row right nine</text:p><text:p text:style-name="Body">Floored row right ten</text:p><text:p text:style-name="Body">Floored row right eleven</text:p><text:p text:style-name="Body">Floored row right twelve</text:p></table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Plain">
     <table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="Body">Tail row left one</text:p><text:p text:style-name="Body">Tail row left two</text:p></table:table-cell>
     <table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="Body">Tail row right one</text:p><text:p text:style-name="Body">Tail row right two</text:p></table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="Body">Coda after the floored table.</text:p>
  </office:text></office:body>
</office:document>
