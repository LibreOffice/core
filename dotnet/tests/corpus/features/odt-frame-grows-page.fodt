<?xml version="1.0" encoding="UTF-8"?>
<!--
  A draw:frame taller than what is left of its page, grown to its own text.

  Same rule as odt-frame-grows.fodt: fo:min-height on the draw:text-box is
  SwFrameSize::Minimum, so SwFlyFrame::Format makes the fly as tall as its content
  (sw/source/core/layout/fly.cxx:1549-1570).  Here the twelve lines it holds are
  taller than the 10 cm page, and the frame states no loext:may-break-between-pages,
  so the fly cannot be split (SwFlyFrame::IsFlySplitAllowed, fly.cxx:689-733, whose
  last line reads the flag).  The text the frame pushes down therefore begins a page,
  which a frame that is placed but never grown cannot do.

  Ground truth is 26.2.4.2's own PDF of this file; the numbers are in
  OdtFrameGrowthTests.
-->
<office:document
    xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
    xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
    xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
    xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0"
    xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0"
    xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
    xmlns:dc="http://purl.org/dc/elements/1.1/"
    office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.text">
 <office:meta>
  <dc:title>Paperless frame grown onto a second page</dc:title>
  <dc:subject>A frame grown past the page bottom begins a page</dc:subject>
 </office:meta>
 <office:styles>
  <style:style style:name="Body" style:family="paragraph">
   <style:paragraph-properties fo:text-align="start" fo:text-indent="0cm" fo:hyphenate="false"
       fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"
       fo:orphans="0" fo:widows="0"/>
   <style:text-properties style:font-name="Carlito" fo:font-family="Carlito" fo:font-size="11pt"
       fo:language="en" fo:country="GB"/>
  </style:style>
  <style:style style:name="Frame" style:family="graphic">
   <style:graphic-properties text:anchor-type="paragraph" svg:x="0cm" svg:y="0cm"
       fo:margin-left="0cm" fo:margin-right="0cm" fo:margin-top="0cm" fo:margin-bottom="0cm"
       style:wrap="none" style:vertical-pos="top" style:vertical-rel="paragraph"
       style:horizontal-pos="from-left" style:horizontal-rel="paragraph"
       draw:fill="none" fo:padding="0cm" fo:border="none"/>
  </style:style>
 </office:styles>
 <office:automatic-styles>
  <style:page-layout style:name="PL">
   <style:page-layout-properties fo:page-width="21cm" fo:page-height="10cm"
       fo:margin-left="2cm" fo:margin-right="2cm" fo:margin-top="2cm" fo:margin-bottom="2cm"/>
  </style:page-layout>
  <style:style style:name="fr1" style:family="graphic" style:parent-style-name="Frame">
   <style:graphic-properties style:wrap="none" style:vertical-pos="from-top"
       style:vertical-rel="paragraph" style:horizontal-pos="from-left"
       style:horizontal-rel="paragraph" fo:padding="0cm" fo:border="none"/>
  </style:style>
 </office:automatic-styles>
 <office:master-styles>
  <style:master-page style:name="Standard" style:page-layout-name="PL"/>
 </office:master-styles>
 <office:body><office:text>
   <text:p text:style-name="Body"><draw:frame draw:style-name="fr1" draw:name="TallBox"
       text:anchor-type="paragraph" svg:x="0cm" svg:y="0cm" svg:width="8cm" draw:z-index="0">
     <draw:text-box fo:min-height="0cm"><text:p text:style-name="Body">GROWS01</text:p><text:p text:style-name="Body">GROWS02</text:p><text:p text:style-name="Body">GROWS03</text:p><text:p text:style-name="Body">GROWS04</text:p><text:p text:style-name="Body">GROWS05</text:p><text:p text:style-name="Body">GROWS06</text:p><text:p text:style-name="Body">GROWS07</text:p><text:p text:style-name="Body">GROWS08</text:p><text:p text:style-name="Body">GROWS09</text:p><text:p text:style-name="Body">GROWS10</text:p></draw:text-box>
    </draw:frame>ANCHOR</text:p>
   <text:p text:style-name="Body">AFTER1</text:p><text:p text:style-name="Body">AFTER2</text:p><text:p text:style-name="Body">AFTER3</text:p><text:p text:style-name="Body">AFTER4</text:p>
 </office:text></office:body>
</office:document>
