<?xml version="1.0" encoding="UTF-8"?>
<!--
  A merged heading that straddles a horizontal page break.

  Six columns of 5 cm each on a 21 cm page with 2 cm margins: three fit, so the sheet takes two
  pages side by side and the break falls between column C and column D. Row 1 is a single merge
  across all six, and its own cell — the only one that carries the text — is on the first page.

  The second page therefore holds nothing but covered cells, and Calc still draws the heading on
  it: the block's first *visible* column asks GetMergeOrigin for the block's anchor and the walk
  runs back past the page boundary (bIsLeft, sc/source/ui/view/output2.cxx:957). The heading is
  drawn from its true position, so most of it falls off the left of the second page and the tail
  lands on the paper — which is what makes a wide merged title read continuously across a break.

  Row 3 is the negative half and is why the fixture has two rows rather than one: an ordinary
  string in A3 is not part of any merge, so nothing on the second page may reach back for it.
  A renderer that walked left from the second page's first column unconditionally would draw
  both, and one that never walked left would draw neither.

  Taken from P1636e.xls, whose title and eight footnotes are each merged across all six of its
  columns while its page break falls after the third.
-->
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
 xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
 xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
 xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
 xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
 office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.spreadsheet">
 <office:automatic-styles>
  <style:style style:name="co1" style:family="table-column">
   <style:table-column-properties style:column-width="5cm"/>
  </style:style>
  <style:page-layout style:name="pm1">
   <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm"
    fo:margin-left="2cm" fo:margin-right="2cm" fo:margin-top="2cm" fo:margin-bottom="2cm"
    style:print-orientation="portrait"/>
  </style:page-layout>
 </office:automatic-styles>
 <office:master-styles>
  <style:master-page style:name="Default" style:page-layout-name="pm1"/>
 </office:master-styles>
 <office:body>
  <office:spreadsheet>
   <table:table table:name="Probe">
    <table:table-column table:style-name="co1" table:number-columns-repeated="6"/>
    <table:table-row>
     <table:table-cell table:number-columns-spanned="6" table:number-rows-spanned="1"
      office:value-type="string"><text:p>Straddling heading that runs across all six of the columns this sheet has and keeps going far enough that its tail lands on the second page BEYONDTHEBREAK</text:p></table:table-cell>
     <table:covered-table-cell table:number-columns-repeated="5"/>
    </table:table-row>
    <table:table-row>
     <table:table-cell office:value-type="string"><text:p>Alpha</text:p></table:table-cell>
     <table:table-cell office:value-type="string"><text:p>Bravo</text:p></table:table-cell>
     <table:table-cell office:value-type="string"><text:p>Charlie</text:p></table:table-cell>
     <table:table-cell office:value-type="string"><text:p>Delta</text:p></table:table-cell>
     <table:table-cell office:value-type="string"><text:p>Echo</text:p></table:table-cell>
     <table:table-cell office:value-type="string"><text:p>Foxtrot</text:p></table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell office:value-type="string"><text:p>Unmerged</text:p></table:table-cell>
    </table:table-row>
   </table:table>
  </office:spreadsheet>
 </office:body>
</office:document>
