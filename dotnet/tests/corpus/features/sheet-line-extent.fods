<?xml version="1.0" encoding="UTF-8"?>
<!-- A `draw:connector` states no rectangle: its geometry is `svg:x1`,`svg:y1`,`svg:x2`,`svg:y2`
     (SdXMLConnectorShapeContext, xmloff/source/draw/ximpshap.cxx:1963-2035), and every object on
     Calc's draw page widens the printed block (ScDrawLayer::GetPrintArea, drwlayer.cxx:1397-1414,
     maxed in by ScDocument::GetPrintArea, documen2.cxx:644-664).  The line here runs from 0.5in to
     14in below A1 on a sheet whose three rows of cells are under half an inch tall, so it reaches
     a second page on its own.  Its `table:end-cell-address` is the anchor cell, as Calc writes it
     for a connector, and taking that instead of the endpoints collapses the line to a point.
     26.2.4.2 prints TWO pages of this file, the second carrying the line's tail and no text; with
     the `draw:connector` element deleted it prints ONE.  See probes/ods-residue-r95/results.md §3. -->
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" xmlns:calcext="urn:org:documentfoundation:names:experimental:calc:xmlns:calcext:1.0" office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.spreadsheet">
 <office:styles>
  <style:style style:name="Default" style:family="table-cell">
   <style:text-properties style:font-name="Calibri" fo:font-family="Calibri" fo:font-size="11pt" style:font-size-asian="11pt" style:font-size-complex="11pt"/>
  </style:style>
  <style:style style:name="grDefault" style:family="graphic">
   <style:graphic-properties draw:stroke="solid" svg:stroke-width="0.02in" svg:stroke-color="#000000" draw:fill="none"/>
  </style:style>
 </office:styles>
 <office:automatic-styles>
  <style:style style:name="co1" style:family="table-column"><style:table-column-properties style:column-width="2in"/></style:style>
  <style:style style:name="ro1" style:family="table-row"><style:table-row-properties style:row-height="0.15in" fo:break-before="auto" style:use-optimal-row-height="false"/></style:style>
  <style:style style:name="gr1" style:family="graphic" style:parent-style-name="grDefault"><style:graphic-properties draw:stroke="solid" svg:stroke-width="0.02in" svg:stroke-color="#000000"/></style:style>
  <style:style style:name="pm1" style:family="page-layout"><style:page-layout-properties fo:page-width="8.5in" fo:page-height="11in" fo:margin-top="0.5in" fo:margin-bottom="0.5in" fo:margin-left="0.5in" fo:margin-right="0.5in" style:print-orientation="portrait"/></style:style>
 </office:automatic-styles>
 <office:master-styles>
  <style:master-page style:name="Default" style:page-layout-name="pm1"/>
 </office:master-styles>
 <office:body><office:spreadsheet>
  <table:table table:name="Probe">
   <table:table-column table:style-name="co1"/>
   <table:table-row table:style-name="ro1"><table:table-cell office:value-type="string" calcext:value-type="string"><text:p>one</text:p>
    <draw:connector draw:name="Spine" draw:style-name="gr1" draw:type="line" table:end-cell-address="Probe.A1" table:end-x="0.02in" table:end-y="0.02in" svg:x1="0.5in" svg:y1="0.5in" svg:x2="0.5in" svg:y2="14in"><text:p/></draw:connector>
   </table:table-cell></table:table-row>
   <table:table-row table:style-name="ro1"><table:table-cell office:value-type="string" calcext:value-type="string"><text:p>two</text:p></table:table-cell></table:table-row>
   <table:table-row table:style-name="ro1"><table:table-cell office:value-type="string" calcext:value-type="string"><text:p>three</text:p></table:table-cell></table:table-row>
  </table:table>
 </office:spreadsheet></office:body></office:document>
