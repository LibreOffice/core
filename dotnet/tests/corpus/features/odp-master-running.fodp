<?xml version="1.0" encoding="UTF-8"?>
<!-- Hand-authored. One master carrying all four of Impress's running objects, and five slides
     that switch them on and off differently, so that one deck separates every rule about
     which of a master's presentation objects reach a slide and what they say there.

     The master holds:
       * "Global Widget Corporation" - an ordinary background object, drawn under every slide.
       * a presentation:class="footer" frame holding a <presentation:footer/> FIELD, so what it
         draws is the declaration each slide names rather than anything in the frame.
       * a presentation:class="date-time" frame holding the CHARACTERS "Spring 2026". Both
         shapes are common in LibreOffice's own export and they behave differently: characters
         are drawn as they stand, a field resolves against the slide.
       * a presentation:class="page-number" frame holding <text:page-number>, which draws the
         slide's own number and NOT the "<number>" placeholder stored against it.
       * "Click to edit the title style of the master" - the master's title presentation object,
         which is never drawn on a slide.

     The slides:
       1  everything on, naming footer declaration ftr1.
       2  everything off.
       3  footer on naming ftr2, date-time and slide number off - the same master frame, a
          different declaration.
       4  states nothing at all, so HeaderFooterSettings()'s own defaults decide
          (sd/source/core/sdpage.cxx:3222-3230): footer and date-time visible, slide number NOT.
       5  everything on, like the first, but naming no footer declaration at all - so the
          field has nothing to say and draws nothing while its frame is still there, and the
          two running objects beside it are unaffected.

     Verified against LibreOffice 26.2.4.2, whose PDF of this file reads, page by page:
       1  Global Widget Corporation | First slide of its own  | Head Office | Spring 2026 | 1
       2  Global Widget Corporation | Second slide of its own
       3  Global Widget Corporation | Third slide of its own  | Branch Office
       4  Global Widget Corporation | Fourth slide of its own | Spring 2026
       5  Global Widget Corporation | Fifth slide of its own  | Spring 2026 | 5
     and nothing else: no "<number>" anywhere, no slide number on page 4, no footer on page 5,
     and not the title prompt.

     Two things this file needs that a reader would not guess, both established by rendering it
     through 26.2.4.2 and watching them fail - the same two odp-master-background.fodp records:
       * office:styles must declare a draw:layer-set, or LibreOffice discards every shape on
         the master page and substitutes the stock layout.
       * a presentation frame must name a *presentation*-family style. Given draw:style-name
         instead, the importer demotes it to an ordinary text frame. -->
<office:document
  xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
  xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
  xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
  xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0"
  xmlns:presentation="urn:oasis:names:tc:opendocument:xmlns:presentation:1.0"
  xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
  xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0"
  office:version="1.3"
  office:mimetype="application/vnd.oasis.opendocument.presentation">
 <office:styles>
  <draw:layer-set>
   <draw:layer draw:name="layout"/>
   <draw:layer draw:name="background"/>
   <draw:layer draw:name="backgroundobjects"/>
   <draw:layer draw:name="controls"/>
   <draw:layer draw:name="measurelines"/>
  </draw:layer-set>
 </office:styles>
 <office:automatic-styles>
  <style:page-layout style:name="PL1">
   <style:page-layout-properties fo:page-width="25.4cm" fo:page-height="19.05cm"
       style:print-orientation="landscape" fo:margin-top="0cm" fo:margin-bottom="0cm"
       fo:margin-left="0cm" fo:margin-right="0cm"/>
  </style:page-layout>
  <style:style style:name="dpAll" style:family="drawing-page">
   <style:drawing-page-properties draw:fill="none" presentation:display-footer="true"
       presentation:display-date-time="true" presentation:display-page-number="true"/>
  </style:style>
  <style:style style:name="dpNone" style:family="drawing-page">
   <style:drawing-page-properties draw:fill="none" presentation:display-footer="false"
       presentation:display-date-time="false" presentation:display-page-number="false"/>
  </style:style>
  <style:style style:name="dpFooter" style:family="drawing-page">
   <style:drawing-page-properties draw:fill="none" presentation:display-footer="true"
       presentation:display-date-time="false" presentation:display-page-number="false"/>
  </style:style>
  <style:style style:name="dpUnstated" style:family="drawing-page">
   <style:drawing-page-properties draw:fill="none"/>
  </style:style>
  <style:style style:name="gr1" style:family="graphic">
   <style:graphic-properties draw:stroke="none" draw:fill="none"/>
  </style:style>
  <style:style style:name="pr1" style:family="presentation">
   <style:graphic-properties draw:stroke="none" draw:fill="none"/>
  </style:style>
  <style:style style:name="P1" style:family="paragraph">
   <style:text-properties fo:font-size="18pt"/>
  </style:style>
 </office:automatic-styles>
 <office:master-styles>
  <style:master-page style:name="Default" style:page-layout-name="PL1" draw:style-name="dpAll">
   <draw:frame draw:style-name="gr1" draw:name="strapline" draw:layer="backgroundobjects"
       svg:x="1cm" svg:y="1cm" svg:width="20cm" svg:height="1.5cm">
    <draw:text-box><text:p text:style-name="P1">Global Widget Corporation</text:p></draw:text-box>
   </draw:frame>
   <draw:frame presentation:style-name="pr1" draw:layer="backgroundobjects"
       svg:x="1cm" svg:y="3cm" svg:width="20cm" svg:height="3cm"
       presentation:class="title" presentation:user-transformed="true">
    <draw:text-box><text:p>Click to edit the title style of the master</text:p></draw:text-box>
   </draw:frame>
   <draw:frame presentation:style-name="pr1" draw:name="master footer"
       draw:layer="backgroundobjects" presentation:class="footer"
       svg:x="1cm" svg:y="14cm" svg:width="9cm" svg:height="1.5cm">
    <draw:text-box><text:p text:style-name="P1"><presentation:footer/></text:p></draw:text-box>
   </draw:frame>
   <draw:frame presentation:style-name="pr1" draw:name="master date"
       draw:layer="backgroundobjects" presentation:class="date-time"
       svg:x="11cm" svg:y="14cm" svg:width="6cm" svg:height="1.5cm">
    <draw:text-box><text:p text:style-name="P1">Spring 2026</text:p></draw:text-box>
   </draw:frame>
   <draw:frame presentation:style-name="pr1" draw:name="master number"
       draw:layer="backgroundobjects" presentation:class="page-number"
       svg:x="18cm" svg:y="14cm" svg:width="4cm" svg:height="1.5cm">
    <draw:text-box><text:p text:style-name="P1"><text:page-number>&lt;number&gt;</text:page-number></text:p></draw:text-box>
   </draw:frame>
  </style:master-page>
 </office:master-styles>
 <office:body>
  <office:presentation>
   <presentation:footer-decl presentation:name="ftr1">Head Office</presentation:footer-decl>
   <presentation:footer-decl presentation:name="ftr2">Branch Office</presentation:footer-decl>
   <draw:page draw:name="first" draw:style-name="dpAll" draw:master-page-name="Default"
       presentation:use-footer-name="ftr1">
    <draw:frame draw:style-name="gr1" draw:name="body one" draw:layer="layout"
        svg:x="2cm" svg:y="8cm" svg:width="20cm" svg:height="3cm">
     <draw:text-box><text:p text:style-name="P1">First slide of its own</text:p></draw:text-box>
    </draw:frame>
   </draw:page>
   <draw:page draw:name="second" draw:style-name="dpNone" draw:master-page-name="Default"
       presentation:use-footer-name="ftr1">
    <draw:frame draw:style-name="gr1" draw:name="body two" draw:layer="layout"
        svg:x="2cm" svg:y="8cm" svg:width="20cm" svg:height="3cm">
     <draw:text-box><text:p text:style-name="P1">Second slide of its own</text:p></draw:text-box>
    </draw:frame>
   </draw:page>
   <draw:page draw:name="third" draw:style-name="dpFooter" draw:master-page-name="Default"
       presentation:use-footer-name="ftr2">
    <draw:frame draw:style-name="gr1" draw:name="body three" draw:layer="layout"
        svg:x="2cm" svg:y="8cm" svg:width="20cm" svg:height="3cm">
     <draw:text-box><text:p text:style-name="P1">Third slide of its own</text:p></draw:text-box>
    </draw:frame>
   </draw:page>
   <draw:page draw:name="fourth" draw:style-name="dpUnstated" draw:master-page-name="Default">
    <draw:frame draw:style-name="gr1" draw:name="body four" draw:layer="layout"
        svg:x="2cm" svg:y="8cm" svg:width="20cm" svg:height="3cm">
     <draw:text-box><text:p text:style-name="P1">Fourth slide of its own</text:p></draw:text-box>
    </draw:frame>
   </draw:page>
   <draw:page draw:name="fifth" draw:style-name="dpAll" draw:master-page-name="Default">
    <draw:frame draw:style-name="gr1" draw:name="body five" draw:layer="layout"
        svg:x="2cm" svg:y="8cm" svg:width="20cm" svg:height="3cm">
     <draw:text-box><text:p text:style-name="P1">Fifth slide of its own</text:p></draw:text-box>
    </draw:frame>
   </draw:page>
  </office:presentation>
 </office:body>
</office:document>
