<?xml version="1.0" encoding="UTF-8"?>
<office:document
    xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
    xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
    xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
    xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
    xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0"
    xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0"
    xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
    xmlns:dc="http://purl.org/dc/elements/1.1/"
    office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.text">
 <office:meta>
  <dc:title>Paperless floating frame anchored in a table cell</dc:title>
  <dc:subject>A frame anchored in the first paragraph of a table cell, which the body's own resolution pass cannot reach</dc:subject>
 </office:meta>
 <office:automatic-styles>
  <style:page-layout style:name="PL">
   <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm"
       fo:margin-left="2cm" fo:margin-right="2cm" fo:margin-top="2cm" fo:margin-bottom="2cm"/>
   <style:header-style>
    <style:header-footer-properties svg:height="1.5cm" fo:margin-bottom="0.3cm"/>
   </style:header-style>
  </style:page-layout>
  <style:style style:name="Fr" style:family="graphic">
   <style:graphic-properties style:wrap="parallel" style:number-wrapped-paragraphs="no-limit"
       style:vertical-pos="from-top" style:vertical-rel="paragraph"
       style:horizontal-pos="from-left" style:horizontal-rel="paragraph"
       fo:margin-left="0cm" fo:margin-right="0cm" fo:margin-top="0cm" fo:margin-bottom="0cm"
       fo:padding="0cm" fo:border="none" draw:fill="none"/>
  </style:style>
  <style:style style:name="FrameText" style:family="paragraph">
   <style:paragraph-properties fo:text-align="start" fo:text-indent="0cm" fo:hyphenate="false"
       fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"/>
   <style:text-properties style:font-name="Carlito" fo:font-family="Carlito" fo:font-size="9pt"
       fo:language="en" fo:country="GB"/>
  </style:style>
  <style:style style:name="T1" style:family="table">
   <style:table-properties style:width="17cm" table:align="left"/>
  </style:style>
  <style:style style:name="T1A" style:family="table-column">
   <style:table-column-properties style:column-width="8.5cm"/>
  </style:style>
  <style:style style:name="T1Cell" style:family="table-cell">
   <style:table-cell-properties fo:padding="0.1cm" fo:border="none"/>
  </style:style>
 </office:automatic-styles>
 <office:styles>
  <style:style style:name="Body" style:family="paragraph">
   <style:paragraph-properties fo:text-align="start" fo:text-indent="0cm" fo:hyphenate="false"
       fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"
       fo:orphans="0" fo:widows="0"/>
   <style:text-properties style:font-name="Carlito" fo:font-family="Carlito" fo:font-size="11pt"
       fo:language="en" fo:country="GB"/>
  </style:style>
 </office:styles>
 <office:master-styles>
  <style:master-page style:name="Standard" style:page-layout-name="PL">
  </style:master-page>
 </office:master-styles>
 <office:body><office:text>
   <text:p text:style-name="Body">Paragraph 01. kerning advance rasteriser layout ligature common separate margin extraction library paths arithmetic rendering together baseline filling compounds measurement pagination glyph kerning advance rasteriser layout ligature common separate margin extraction library paths arithmetic rendering together baseline filling compounds measurement pagination glyph.</text:p>
   <table:table table:name="Grid" table:style-name="T1">
    <table:table-column table:style-name="T1A" table:number-columns-repeated="2"/>
    <table:table-row>
     <table:table-cell table:style-name="T1Cell" office:value-type="string">
      <text:p text:style-name="Body"><draw:frame draw:style-name="Fr" draw:name="InCell" text:anchor-type="paragraph" svg:x="0.5cm" svg:y="0.2cm" svg:width="3cm" svg:height="2cm" draw:z-index="1"><draw:text-box><text:p text:style-name="FrameText">Cell frame.</text:p></draw:text-box></draw:frame>Cell one. kerning advance rasteriser layout ligature common separate margin extraction library paths arithmetic rendering together baseline filling compounds measurement pagination glyph.</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="T1Cell" office:value-type="string">
      <text:p text:style-name="Body">Cell two. kerning advance rasteriser layout ligature common separate margin extraction library paths arithmetic rendering together baseline filling compounds measurement pagination glyph.</text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="Body">Paragraph 02. kerning advance rasteriser layout ligature common separate margin extraction library paths arithmetic rendering together baseline filling compounds measurement pagination glyph kerning advance rasteriser layout ligature common separate margin extraction library paths arithmetic rendering together baseline filling compounds measurement pagination glyph.</text:p>
  </office:text></office:body>
</office:document>
