<?xml version="1.0" encoding="UTF-8"?>
<!--
  A sheet whose columns do not fit one page, so that the two vertical edges at a page's column
  band can each be asked which of the two cells meeting there states them.

  Three 10cm columns on a 17cm printable width put one column on each page, so column A's right
  edge and column B's left edge are the *same* sheet edge printed on two different pages: the
  trailing edge of page 1's band and the leading edge of page 2's.

  Row 1 states the edge from the left: A1 has a red right border, B1 has none.
  Row 2 states it from the right: B2 has a blue left border, A2 has none.

  Inside a band Calc takes the heavier of the two neighbours, so a renderer that applies that
  rule at the band's edges too paints row 2's blue on page 1 and row 1's red on page 2 — a
  border belonging to a column the page is not printing. Array::GetCellStyleLeft
  (svx/source/dialog/framelinkarray.cxx:782-799) special-cases both ends of the clip range,
  which ScOutputData::DrawFrame sets to the printed band whenever it draws in page mode
  (sc/source/ui/view/output.cxx:1567, and ScPrintFunc::PrintPage passes bPageMode true at
  sc/source/ui/view/printfun.cxx:1612-1614). So each page paints only what its own column says.
-->
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
 xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
 xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
 xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
 xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
 office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.spreadsheet">
 <office:automatic-styles>
  <style:style style:name="co1" style:family="table-column">
   <style:table-column-properties style:column-width="10cm"/>
  </style:style>
  <style:style style:name="ceRight" style:family="table-cell">
   <style:table-cell-properties fo:border-right="0.06cm solid #ff0000"/>
  </style:style>
  <style:style style:name="ceLeft" style:family="table-cell">
   <style:table-cell-properties fo:border-left="0.06cm solid #0000ff"/>
  </style:style>
  <style:page-layout style:name="pm1">
   <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm"
    fo:margin-left="2cm" fo:margin-right="2cm" fo:margin-top="2cm" fo:margin-bottom="2cm"
    style:print-orientation="portrait"/>
  </style:page-layout>
 </office:automatic-styles>
 <office:master-styles>
  <style:master-page style:name="Default" style:page-layout-name="pm1"/>
 </office:master-styles>
 <office:body>
  <office:spreadsheet>
   <table:table table:name="Bands">
    <table:table-column table:style-name="co1"/>
    <table:table-column table:style-name="co1"/>
    <table:table-column table:style-name="co1"/>
    <table:table-row>
     <table:table-cell table:style-name="ceRight" office:value-type="string">
      <text:p>A1</text:p></table:table-cell>
     <table:table-cell office:value-type="string"><text:p>B1</text:p></table:table-cell>
     <table:table-cell office:value-type="string"><text:p>C1</text:p></table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell office:value-type="string"><text:p>A2</text:p></table:table-cell>
     <table:table-cell table:style-name="ceLeft" office:value-type="string">
      <text:p>B2</text:p></table:table-cell>
     <table:table-cell office:value-type="string"><text:p>C2</text:p></table:table-cell>
    </table:table-row>
   </table:table>
  </office:spreadsheet>
 </office:body>
</office:document>
