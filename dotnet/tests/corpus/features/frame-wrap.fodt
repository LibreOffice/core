       fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"
       fo:orphans="0" fo:widows="0"/>
   <style:text-properties style:font-name="Carlito" fo:font-family="Carlito" fo:font-size="11pt"
       fo:language="en" fo:country="GB"/>
  </style:style>
 </office:styles>
 <office:master-styles>
  <style:master-page style:name="Standard" style:page-layout-name="PL"/>
 </office:master-styles>
 <office:body><office:text>
   <text:p text:style-name="Body">Paragraph 01. kerning advance rasteriser layout ligature common separate margin extraction library paths arithmetic rendering together baseline filling compounds measurement pagination glyph kerning advance rasteriser layout ligature common separate margin extraction library paths arithmetic rendering together baseline filling compounds measurement pagination glyph.</text:p>
