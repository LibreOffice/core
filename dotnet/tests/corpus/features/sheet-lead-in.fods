<?xml version="1.0" encoding="UTF-8"?>
<!--
  A sheet whose columns do not fit one page, so that the cell immediately left of the second
  page's column band can be asked what it draws there. The answer is NOTHING, and that is the
  point of the fixture.

  Row 2 holds a short string in column C and row 3 a long one. Both are drawn on page 1 and
  neither is drawn on page 2 — the long string is shortened at column C's own right edge and
  its continuation is simply not painted, however far its output area reaches.

  This was measured, not inferred, because it is not what the source suggests. LayoutStrings
  starts its column loop one before the block so that a long string reaching in from the left
  is drawn (output2.cxx:1541-1543) — but only `if (mnX1 > 0 && !bTaggedPDF)`, and UseTaggedPDF
  defaults to true, so every PDF soffice writes takes the other branch. Rendered through
  26.2.4.2: three pages, page 1 ending "...that definitely r", page 2 holding DDDD alone and
  page 3 holding no text at all.

  Page 3 still exists. Which pages are printed is IsPrintEmpty's question and is answered from
  the print area's overflow extension rather than from the paint, so the spill that is never
  drawn still buys the paper it would have been drawn on. See sheet-trail-in.fods for the
  direction that IS painted across the break.
-->
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
 xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
 xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
 xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
 xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
 office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.spreadsheet">
 <office:automatic-styles>
  <style:style style:name="co1" style:family="table-column">
   <style:table-column-properties style:column-width="6cm"/>
  </style:style>
  <style:style style:name="co2" style:family="table-column">
   <style:table-column-properties style:column-width="2cm"/>
  </style:style>
  <style:page-layout style:name="pm1">
   <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm"
    fo:margin-left="2cm" fo:margin-right="2cm" fo:margin-top="2cm" fo:margin-bottom="2cm"
    style:print-orientation="portrait"/>
  </style:page-layout>
 </office:automatic-styles>
 <office:master-styles>
  <style:master-page style:name="Default" style:page-layout-name="pm1"/>
 </office:master-styles>
 <office:body>
  <office:spreadsheet>
   <table:table table:name="Probe">
    <table:table-column table:style-name="co1"/>
    <table:table-column table:style-name="co1"/>
    <table:table-column table:style-name="co2"/>
    <table:table-column table:style-name="co1"/>
    <table:table-row>
     <table:table-cell office:value-type="string"><text:p>AAAA</text:p></table:table-cell>
     <table:table-cell office:value-type="string"><text:p>BBBB</text:p></table:table-cell>
     <table:table-cell office:value-type="string"><text:p>SHORTC</text:p></table:table-cell>
     <table:table-cell office:value-type="string"><text:p>DDDD</text:p></table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell office:value-type="string"><text:p>AAA2</text:p></table:table-cell>
     <table:table-cell office:value-type="string"><text:p>BBB2</text:p></table:table-cell>
     <table:table-cell office:value-type="string"><text:p>SHORTC2</text:p></table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell office:value-type="string"><text:p>AAA3</text:p></table:table-cell>
     <table:table-cell office:value-type="string"><text:p>BBB3</text:p></table:table-cell>
     <table:table-cell office:value-type="string"><text:p>A very long string in column C that definitely runs a long way past the end of column C and into whatever lies beyond it</text:p></table:table-cell>
    </table:table-row>
   </table:table>
  </office:spreadsheet>
 </office:body>
</office:document>
