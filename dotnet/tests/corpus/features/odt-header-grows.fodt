<?xml version="1.0" encoding="UTF-8"?>
<!--
  A header whose height is a floor is as tall as its own content.

  fo:min-height on style:header-style is SwFrameSize::Minimum, and SwHeadFootFrame::FormatPrt
  takes nHeight = lcl_CalcContentHeight(*this) whenever !HasFixSize(), raising it to the
  stated minimum only if it falls short (sw/source/core/layout/hffrm.cxx:114-145).  With
  style:dynamic-spacing set the frame eats the gap below it rather than adding it, so

      total = max(min-height, content + (dynamic-spacing ? 0 : gap))

  LibreOffice's own exporter writes fo:min-height="0.0398in" - two and a half points - for a
  running head of any height, so reading the floor as the height puts the body a whole header
  too high on every page of every such document.

  HEADA..HEADD are four header lines under a floor of one line.  BODY is the first body line,
  and the distance between the two is the header's real height.  ROOF is the twin master's
  header, one line under a floor of three centimetres, which is the control that the floor
  still binds when the content is smaller than it.

  Ground truth is 26.2.4.2's own PDF of this file, read with pdftotext -bbox; the numbers are
  in OdtHeaderGrowthTests.
-->
<office:document
    xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
    xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
    xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
    xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
    xmlns:dc="http://purl.org/dc/elements/1.1/"
    office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.text">
 <office:meta>
  <dc:title>Paperless header grown to its content</dc:title>
 </office:meta>
 <office:styles>
  <style:style style:name="Body" style:family="paragraph">
   <style:paragraph-properties fo:text-align="start" fo:text-indent="0cm" fo:hyphenate="false"
       fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"
       fo:orphans="0" fo:widows="0"/>
   <style:text-properties style:font-name="Carlito" fo:font-family="Carlito" fo:font-size="11pt"
       fo:language="en" fo:country="GB"/>
  </style:style>
  <style:style style:name="Second" style:family="paragraph" style:parent-style-name="Body"
      style:master-page-name="Floored"/>
 </office:styles>
 <office:automatic-styles>
  <style:page-layout style:name="PL">
   <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm"
       fo:margin-left="2cm" fo:margin-right="2cm" fo:margin-top="2cm" fo:margin-bottom="2cm"/>
   <style:header-style>
    <style:header-footer-properties fo:min-height="0.4cm" fo:margin-bottom="0cm"
        style:dynamic-spacing="true"/>
   </style:header-style>
  </style:page-layout>
  <style:page-layout style:name="PM">
   <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm"
       fo:margin-left="2cm" fo:margin-right="2cm" fo:margin-top="2cm" fo:margin-bottom="2cm"/>
   <style:header-style>
    <style:header-footer-properties fo:min-height="3cm" fo:margin-bottom="0cm"
        style:dynamic-spacing="true"/>
   </style:header-style>
  </style:page-layout>
 </office:automatic-styles>
 <office:master-styles>
  <style:master-page style:name="Standard" style:page-layout-name="PL">
   <style:header>
    <text:p text:style-name="Body">HEADA</text:p>
    <text:p text:style-name="Body">HEADB</text:p>
    <text:p text:style-name="Body">HEADC</text:p>
    <text:p text:style-name="Body">HEADD</text:p>
   </style:header>
  </style:master-page>
  <style:master-page style:name="Floored" style:page-layout-name="PM">
   <style:header>
    <text:p text:style-name="Body">ROOF</text:p>
   </style:header>
  </style:master-page>
 </office:master-styles>
 <office:body>
  <office:text>
   <text:p text:style-name="Body">BODY</text:p>
   <text:p text:style-name="Second">ROOFED</text:p>
  </office:text>
 </office:body>
</office:document>
