<?xml version="1.0" encoding="UTF-8"?>
<!--
  A table inside a drawing shape's text is spelled loext:table, not table:table.

  ODF 1.3 does not allow a table everywhere LibreOffice can put one, so LibreOffice writes
  such a table in its own extension namespace and reads the two spellings as one thing:
  XMLTextImportHelper::CreateTextChildContext falls
    case XML_ELEMENT(TABLE, XML_TABLE): case XML_ELEMENT(LO_EXT, XML_TABLE):
  through to the same CreateTableChildContext (xmloff/source/text/txtimp.cxx:1787-1795).
  The ATTRIBUTES stay in table: - a loext:table-cell carries table:style-name - so only the
  element names move.

  Seven of the 338 converted .odt hold one, and one of them drew 41 of its 1099 characters
  without this, because every table of its roadmap diagram is a loext:table.

  LOEXTA and LOEXTB are the two cells of a shape's table; PLAIN is the same table written the
  ordinary way, as the control that both spellings reach the same place.

  Ground truth is 26.2.4.2's own PDF of this file, read with pdftotext -bbox; the numbers are
  in OdtShapeTableTests.
-->
<office:document
    xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
    xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
    xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
    xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
    xmlns:loext="urn:org:documentfoundation:names:experimental:office:xmlns:loext:1.0"
    xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0"
    xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0"
    xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
    xmlns:dc="http://purl.org/dc/elements/1.1/"
    office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.text">
 <office:meta>
  <dc:title>Paperless loext table in a shape</dc:title>
 </office:meta>
 <office:styles>
  <style:style style:name="Body" style:family="paragraph">
   <style:paragraph-properties fo:text-align="start" fo:text-indent="0cm" fo:hyphenate="false"
       fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="100%"
       fo:orphans="0" fo:widows="0"/>
   <style:text-properties style:font-name="Carlito" fo:font-family="Carlito" fo:font-size="11pt"
       fo:language="en" fo:country="GB"/>
  </style:style>
  <style:style style:name="Frame" style:family="graphic">
   <style:graphic-properties text:anchor-type="paragraph" svg:x="0cm" svg:y="0cm"
       fo:margin-left="0cm" fo:margin-right="0cm" fo:margin-top="0cm" fo:margin-bottom="0cm"
       style:wrap="none" style:vertical-pos="top" style:vertical-rel="paragraph"
       style:horizontal-pos="from-left" style:horizontal-rel="paragraph"
       draw:fill="none" fo:padding="0cm" fo:border="none"/>
  </style:style>
 </office:styles>
 <office:automatic-styles>
  <style:page-layout style:name="PL">
   <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm"
       fo:margin-left="2cm" fo:margin-right="2cm" fo:margin-top="2cm" fo:margin-bottom="2cm"/>
  </style:page-layout>
  <style:style style:name="gr1" style:family="graphic" style:parent-style-name="Frame">
   <style:graphic-properties style:wrap="run-through" style:run-through="foreground"
       style:vertical-pos="from-top" style:vertical-rel="paragraph"
       style:horizontal-pos="from-left" style:horizontal-rel="paragraph"
       draw:auto-grow-height="false" fo:padding="0cm" fo:border="none"/>
  </style:style>
  <style:style style:name="Inner" style:family="table">
   <style:table-properties style:width="6cm" table:align="left"/>
  </style:style>
  <style:style style:name="ColA" style:family="table-column">
   <style:table-column-properties style:column-width="3cm"/>
  </style:style>
  <style:style style:name="Cell" style:family="table-cell">
   <style:table-cell-properties fo:padding="0cm" fo:border="none"/>
  </style:style>
 </office:automatic-styles>
 <office:master-styles>
  <style:master-page style:name="Standard" style:page-layout-name="PL"/>
 </office:master-styles>
 <office:body>
  <office:text>
   <text:p text:style-name="Body">ANCHOR<draw:custom-shape draw:style-name="gr1"
       draw:name="Boxed" text:anchor-type="char" draw:z-index="1"
       svg:x="1cm" svg:y="2cm" svg:width="7cm" svg:height="3cm"
       draw:text-style-name="Body">
     <loext:table table:name="Inner" table:style-name="Inner">
      <loext:table-column table:style-name="ColA"/>
      <loext:table-column table:style-name="ColA"/>
      <loext:table-row>
       <loext:table-cell table:style-name="Cell" office:value-type="string">
        <text:p text:style-name="Body">LOEXTA</text:p>
       </loext:table-cell>
       <loext:table-cell table:style-name="Cell" office:value-type="string">
        <text:p text:style-name="Body">LOEXTB</text:p>
       </loext:table-cell>
      </loext:table-row>
     </loext:table>
    </draw:custom-shape></text:p>
   <text:p text:style-name="Body">PLAIN</text:p>
  </office:text>
 </office:body>
</office:document>
