     <table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="Body">Row 60 right</text:p></table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="Body">Afterword following the long table.</text:p>
  </office:text></office:body>
</office:document>
