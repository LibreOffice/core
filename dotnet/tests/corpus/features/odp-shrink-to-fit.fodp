<?xml version="1.0" encoding="UTF-8"?>
<!-- Hand-authored. Two slides carrying the SAME six paragraphs at the same stated size in the
     same 6 x 4 cm box. They differ in one attribute pair:

       1  draw:fit-to-size="false" style:shrink-to-fit="true"  - Impress's autofit, so the
          text is re-formatted at a smaller size until it fits and every word is drawn.
       2  draw:fit-to-size="false" style:shrink-to-fit="false" - no autofit, so the text is
          formatted at 28pt and overflows the box.

     The point of the pair is the spelling, which is the trap. ODF states ONE property two
     ways: drawing::TextFitToSizeType is mapped from both draw:fit-to-size and
     style:shrink-to-fit, with MID_FLAG_MERGE_PROPERTY (xmloff/source/draw/sdpropls.cxx:143-144),
     because draw:fit-to-size="true" means *stretch* to older consumers. LibreOffice therefore
     writes an autofitted shape as draw:fit-to-size="false" style:shrink-to-fit="true", and a
     reader that consults only the first attribute concludes the shape does not autofit. It
     appears 3515 times, in all 302 of the converted corpus's .odp.

     Verified against LibreOffice 26.2.4.2, whose PDF of this file carries, on the autofitted
     slide, all six lines down to "Sixth line of the block", and on the plain one only the
     lines that fit at the stated size. Both counts are read out of the PDF; the assertions
     compare the two slides against each other rather than pinning a font size, because the
     size the fit lands on is constScaleLevels' business and is tested there. -->
<office:document
  xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
  xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
  xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
  xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0"
  xmlns:presentation="urn:oasis:names:tc:opendocument:xmlns:presentation:1.0"
  xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
  xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0"
  office:version="1.3"
  office:mimetype="application/vnd.oasis.opendocument.presentation">
 <office:styles>
  <draw:layer-set>
   <draw:layer draw:name="layout"/>
   <draw:layer draw:name="background"/>
   <draw:layer draw:name="backgroundobjects"/>
   <draw:layer draw:name="controls"/>
   <draw:layer draw:name="measurelines"/>
  </draw:layer-set>
 </office:styles>
 <office:automatic-styles>
  <style:page-layout style:name="PL1">
   <style:page-layout-properties fo:page-width="25.4cm" fo:page-height="19.05cm"
       style:print-orientation="landscape" fo:margin-top="0cm" fo:margin-bottom="0cm"
       fo:margin-left="0cm" fo:margin-right="0cm"/>
  </style:page-layout>
  <style:style style:name="dp1" style:family="drawing-page">
   <style:drawing-page-properties draw:fill="none"/>
  </style:style>
  <style:style style:name="grFit" style:family="graphic">
   <style:graphic-properties draw:stroke="none" draw:fill="none"
       draw:auto-grow-height="false" draw:auto-grow-width="false"
       draw:textarea-vertical-align="top" fo:wrap-option="wrap"
       draw:fit-to-size="false" style:shrink-to-fit="true"
       fo:padding-top="0cm" fo:padding-bottom="0cm"
       fo:padding-left="0cm" fo:padding-right="0cm"/>
  </style:style>
  <style:style style:name="grPlain" style:family="graphic">
   <style:graphic-properties draw:stroke="none" draw:fill="none"
       draw:auto-grow-height="false" draw:auto-grow-width="false"
       draw:textarea-vertical-align="top" fo:wrap-option="wrap"
       draw:fit-to-size="false" style:shrink-to-fit="false"
       fo:padding-top="0cm" fo:padding-bottom="0cm"
       fo:padding-left="0cm" fo:padding-right="0cm"/>
  </style:style>
  <style:style style:name="P1" style:family="paragraph">
   <style:paragraph-properties fo:line-height="100%"/>
   <style:text-properties fo:font-size="28pt" style:font-name="Liberation Sans"/>
  </style:style>
 </office:automatic-styles>
 <office:master-styles>
  <style:master-page style:name="Default" style:page-layout-name="PL1" draw:style-name="dp1"/>
 </office:master-styles>
 <office:body>
  <office:presentation>
   <draw:page draw:name="fitted" draw:style-name="dp1" draw:master-page-name="Default">
    <draw:frame draw:style-name="grFit" draw:name="fitted box" draw:layer="layout"
        svg:x="2cm" svg:y="2cm" svg:width="6cm" svg:height="4cm">
     <draw:text-box>
      <text:p text:style-name="P1">First line of the block</text:p>
      <text:p text:style-name="P1">Second line of the block</text:p>
      <text:p text:style-name="P1">Third line of the block</text:p>
      <text:p text:style-name="P1">Fourth line of the block</text:p>
      <text:p text:style-name="P1">Fifth line of the block</text:p>
      <text:p text:style-name="P1">Sixth line of the block</text:p>
     </draw:text-box>
    </draw:frame>
   </draw:page>
   <draw:page draw:name="plain" draw:style-name="dp1" draw:master-page-name="Default">
    <draw:frame draw:style-name="grPlain" draw:name="plain box" draw:layer="layout"
        svg:x="2cm" svg:y="2cm" svg:width="6cm" svg:height="4cm">
     <draw:text-box>
      <text:p text:style-name="P1">First line of the block</text:p>
      <text:p text:style-name="P1">Second line of the block</text:p>
      <text:p text:style-name="P1">Third line of the block</text:p>
      <text:p text:style-name="P1">Fourth line of the block</text:p>
      <text:p text:style-name="P1">Fifth line of the block</text:p>
      <text:p text:style-name="P1">Sixth line of the block</text:p>
     </draw:text-box>
    </draw:frame>
   </draw:page>
  </office:presentation>
 </office:body>
</office:document>
