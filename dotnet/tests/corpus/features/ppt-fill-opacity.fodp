<?xml version="1.0" encoding="UTF-8"?>
<office:document
  xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
  xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
  xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
  xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0"
  xmlns:presentation="urn:oasis:names:tc:opendocument:xmlns:presentation:1.0"
  xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
  xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0"
  xmlns:xlink="http://www.w3.org/1999/xlink"
  office:version="1.3"
  office:mimetype="application/vnd.oasis.opendocument.presentation">
 <office:styles>
  <draw:gradient draw:name="shadegrad" draw:style="linear"
      draw:start-color="#ff0000" draw:end-color="#00ff00"
      draw:start-intensity="100%" draw:end-intensity="100%"
      draw:angle="0deg" draw:border="0%"/>
  <draw:opacity draw:name="shadeopac" draw:style="linear"
      draw:start="25%" draw:end="75%" draw:angle="0deg" draw:border="0%"/>
 </office:styles>
 <office:automatic-styles>
  <style:page-layout style:name="PL1">
   <style:page-layout-properties fo:page-width="25.4cm" fo:page-height="19.05cm"
       style:print-orientation="landscape" fo:margin-top="0cm" fo:margin-bottom="0cm"
       fo:margin-left="0cm" fo:margin-right="0cm"/>
  </style:page-layout>
  <style:style style:name="dp1" style:family="drawing-page">
   <style:drawing-page-properties draw:fill="solid" draw:fill-color="#ffffff"/>
  </style:style>
  <style:style style:name="grHalf" style:family="graphic">
   <style:graphic-properties draw:stroke="none"
       draw:fill="solid" draw:fill-color="#0066ff" draw:opacity="50%"/>
  </style:style>
  <style:style style:name="grOpaque" style:family="graphic">
   <style:graphic-properties draw:stroke="none"
       draw:fill="solid" draw:fill-color="#0066ff"/>
  </style:style>
  <style:style style:name="grShade" style:family="graphic">
   <style:graphic-properties draw:stroke="none"
       draw:fill="gradient" draw:fill-gradient-name="shadegrad"
       draw:opacity-name="shadeopac"/>
  </style:style>
 </office:automatic-styles>
 <office:master-styles>
  <style:master-page style:name="MP1" style:page-layout-name="PL1"
      draw:style-name="dp1"/>
 </office:master-styles>
 <office:body>
  <office:presentation>
   <draw:page draw:name="page1" draw:master-page-name="MP1" draw:style-name="dp1">
    <draw:rect draw:style-name="grHalf"
        svg:x="1cm" svg:y="1cm" svg:width="6cm" svg:height="4cm"/>
    <draw:rect draw:style-name="grOpaque"
        svg:x="9cm" svg:y="1cm" svg:width="6cm" svg:height="4cm"/>
    <draw:rect draw:style-name="grShade"
        svg:x="1cm" svg:y="7cm" svg:width="14cm" svg:height="4cm"/>
   </draw:page>
  </office:presentation>
 </office:body>
</office:document>
