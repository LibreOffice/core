<?xml version="1.0" encoding="UTF-8"?>
<office:document
    xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
    xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
    xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
    xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0"
    xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0"
    xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
    xmlns:dc="http://purl.org/dc/elements/1.1/"
    office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.text">
 <office:meta>
  <dc:title>Paperless picture and shape anchors</dc:title>
 </office:meta>
 <office:body><office:text>
   <text:p>An inline picture follows: <draw:frame draw:name="Pic1" text:anchor-type="as-char" svg:width="1cm" svg:height="1cm"><draw:image><office:binary-data>iVBORw0KGgoAAAANSUhEUgAAAAIAAAACCAIAAAD91JpzAAAAEElEQVR4nGO4oKAARAwQCgAgjgRBUcmqiQAAAABJRU5ErkJggg==</office:binary-data></draw:image></draw:frame> and that was it.</text:p>
   <text:p>A text box follows: <draw:frame draw:name="Box1" text:anchor-type="paragraph" svg:x="8cm" svg:y="0cm" svg:width="4cm" svg:height="1cm"><draw:text-box><text:p>Shape text.</text:p></draw:text-box></draw:frame>and that was it too.</text:p>
 </office:text></office:body>
</office:document>
