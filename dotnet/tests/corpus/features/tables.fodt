<?xml version="1.0" encoding="UTF-8"?>
<office:document
    xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
    xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
    xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
    xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
    xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
    xmlns:dc="http://purl.org/dc/elements/1.1/"
    xmlns:meta="urn:oasis:names:tc:opendocument:xmlns:meta:1.0"
    office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.text">
 <office:meta>
  <dc:title>Paperless table document</dc:title>
  <dc:subject>Nested tables and header rows</dc:subject>
 </office:meta>
 <office:automatic-styles>
  <style:style style:name="Outer" style:family="table">
   <style:table-properties style:width="16cm" table:align="margins"/>
  </style:style>
  <style:style style:name="Outer.A" style:family="table-column">
   <style:table-column-properties style:column-width="8cm"/>
  </style:style>
  <style:style style:name="Inner" style:family="table">
   <style:table-properties style:width="7cm" table:align="left"/>
  </style:style>
  <style:style style:name="Inner.A" style:family="table-column">
   <style:table-column-properties style:column-width="3.5cm"/>
  </style:style>
 </office:automatic-styles>
 <office:body>
  <office:text>
   <text:p>Before the tables.</text:p>
   <table:table table:name="Outer" table:style-name="Outer">
    <table:table-column table:style-name="Outer.A" table:number-columns-repeated="2"/>
    <table:table-header-rows>
     <table:table-row>
      <table:table-cell office:value-type="string"><text:p>Outer head left</text:p></table:table-cell>
      <table:table-cell office:value-type="string"><text:p>Outer head right</text:p></table:table-cell>
     </table:table-row>
    </table:table-header-rows>
    <table:table-row>
     <table:table-cell office:value-type="string">
      <text:p>Outer body left</text:p>
      <table:table table:name="Inner" table:style-name="Inner">
       <table:table-column table:style-name="Inner.A" table:number-columns-repeated="2"/>
       <table:table-row>
        <table:table-cell office:value-type="string"><text:p>Inner one</text:p></table:table-cell>
        <table:table-cell office:value-type="string"><text:p>Inner two</text:p></table:table-cell>
       </table:table-row>
       <table:table-row>
        <table:table-cell office:value-type="string"><text:p>Inner three</text:p></table:table-cell>
        <table:table-cell office:value-type="string"><text:p>Inner four</text:p></table:table-cell>
       </table:table-row>
      </table:table>
      <text:p>After the inner table.</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string"><text:p>Outer body right</text:p></table:table-cell>
    </table:table-row>
   </table:table>
   <text:p>Between the tables.</text:p>
   <table:table table:name="Spans" table:style-name="Outer">
    <table:table-column table:style-name="Outer.A" table:number-columns-repeated="3"/>
    <table:table-row>
     <table:table-cell table:number-columns-spanned="2" table:number-rows-spanned="1" office:value-type="string"><text:p>Wide cell</text:p></table:table-cell>
     <table:covered-table-cell/>
     <table:table-cell table:number-rows-spanned="2" table:number-columns-spanned="1" office:value-type="string"><text:p>Tall cell</text:p></table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell office:value-type="string"><text:p>Plain a</text:p></table:table-cell>
     <table:table-cell office:value-type="string"><text:p>Plain b</text:p></table:table-cell>
     <table:covered-table-cell/>
    </table:table-row>
   </table:table>
   <text:p>After the tables.</text:p>
  </office:text>
 </office:body>
</office:document>
