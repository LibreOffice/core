<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Spreadsheet documents (the LibreOffice Calc equivalent): XLSX/XLSM/XLTX/XLTM/XLSB, XLS/XLT, ODS/OTS/FODS, CSV. Includes the formula engine and cell rendering.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The width-dependent General rendering and the two device-unit roundings are decisions no
         document demonstrates one at a time — a cell shows one string, and the roundings differ
         by a hundredth of a millimetre each — so the tests reach them directly. -->
    <InternalsVisibleTo Include="Paperless.Spreadsheets.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Paperless.Core\Paperless.Core.csproj" />
    <ProjectReference Include="..\Paperless.Containers\Paperless.Containers.csproj" />
    <ProjectReference Include="..\Paperless.Text\Paperless.Text.csproj" />
    <ProjectReference Include="..\Paperless.Vector\Paperless.Vector.csproj" />
    <ProjectReference Include="..\Paperless.Ooxml\Paperless.Ooxml.csproj" />
    <ProjectReference Include="..\Paperless.OpenDocument\Paperless.OpenDocument.csproj" />
    <ProjectReference Include="..\Paperless.MsBinary\Paperless.MsBinary.csproj" />
  </ItemGroup>

</Project>
