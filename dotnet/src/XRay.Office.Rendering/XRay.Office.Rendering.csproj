<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Rendering backends that consume the X-Ray.Office display list: a SkiaSharp rasteriser (PNG, JPEG) and a PDF writer with embedded subset fonts and real text. Part of X-Ray.Office, a pure C# port of LibreOffice's document import and rendering; install the X-Ray.Office package for the whole set.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
    <PackageReference Include="SkiaSharp.HarfBuzz" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XRay.Office.Core\XRay.Office.Core.csproj" />
    <ProjectReference Include="..\XRay.Office.Text\XRay.Office.Text.csproj" />
  </ItemGroup>

</Project>
