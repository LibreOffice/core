<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Paperless.Cli</RootNamespace>
    <!--
      Note: the assembly is deliberately NOT named "paperless". A lowercase
      "paperless" assembly collides case-insensitively with the Paperless library
      project and breaks restore with "Ambiguous project name". The user-facing
      command name comes from ToolCommandName below, which is what matters.
    -->
    <Description>Command-line front end for Paperless. Used by humans and by the LibreOffice fidelity-comparison skills.</Description>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>paperless</ToolCommandName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Paperless\Paperless.csproj" />
    <ProjectReference Include="..\..\src\Paperless.Containers\Paperless.Containers.csproj" />
    <!-- The structured-text writers, for the xhtml and markdown output formats of `extract`.
         They depend on Paperless.Core alone, so this adds nothing to the tool's footprint. -->
    <ProjectReference Include="..\..\src\Paperless.Markup\Paperless.Markup.csproj" />

    <!-- The rendering backends, for `render`'s pdf, png and jpeg output. -->
    <ProjectReference Include="..\..\src\Paperless.Rendering\Paperless.Rendering.csproj" />
  </ItemGroup>

</Project>
