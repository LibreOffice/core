                    ]
                },
                {
                    "id": "logoTurtle",
                    "label": "Turtle",
                    "items": [
                        { "type": "button", "command": "forward" },
                        { "type": "button", "command": "back" },
                        { "type": "separator" },
                        { "type": "button", "command": "left" },
                        { "type": "button", "command": "right" }
                    ]
                },
                {
                    "id": "logoCanvas",
                    "label": "Canvas",
                    "items": [
                        { "type": "button", "command": "home" },
                        { "type": "button", "command": "clearscreen" }
                    ]
                }
            ]
