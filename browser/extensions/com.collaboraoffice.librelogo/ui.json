{
    "commands": [
        { "id": "run", "title": "Run Logo Program", "icon": "icons/run.svg", "panel": true },
        { "id": "stop", "title": "Stop", "icon": "icons/stop.svg", "panel": true },
        { "id": "home", "title": "Home", "icon": "icons/home.svg", "panel": true },
        { "id": "clearscreen", "title": "Clear Screen", "icon": "icons/clearscreen.svg", "panel": true },
        { "id": "forward", "title": "Forward", "icon": "icons/forward.svg", "panel": true },
        { "id": "back", "title": "Back", "icon": "icons/back.svg", "panel": true },
        { "id": "left", "title": "Left", "icon": "icons/left.svg", "panel": true },
        { "id": "right", "title": "Right", "icon": "icons/right.svg", "panel": true }
    ],
    "menus": {
        "tools": ["run", "stop", "home", "clearscreen"]
    },
    "notebookbar": [
        {
            "tab": "Logo",
            "insertAfter": "Insert",
            "groups": [
                {
                    "id": "logoProgram",
