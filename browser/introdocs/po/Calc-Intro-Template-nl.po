msgid "5"
msgstr "5"

#. content.xml (sheet '✚ Formulas & Functions')
msgid "<1>2. Type the formula </1><2>=SUM(E9:E11)</2>"
msgstr "<1>2. Typ de formule </1><2>=SUM(E9:E11)</2>"

#. content.xml (sheet '✚ Formulas & Functions'); content.xml (sheet '📋
#. Tables'); content.xml (sheet '🎨 Conditional Formatting'); content.xml
