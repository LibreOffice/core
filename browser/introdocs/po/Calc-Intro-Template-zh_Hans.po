msgid ""
"1. Select the range of cells that contains your data (including headers)"
msgstr "1. 选择包含数据的单元格区域（包含标题列）"

#. content.xml (sheet '📋 Tables')
msgid "Electronics"
msgstr "电子产品"

#. content.xml (sheet '📋 Tables')
msgid "Dell"
msgstr "戴尔"

#. content.xml (sheet '📋 Tables')
msgid "<1>2. Open the </1><2>Insert tab</2><3> in the toolbar</3>"
msgstr "<1>2. 打开工具栏中的 </1><2>插入选项卡</2><3></3>"

#. content.xml (sheet '📋 Tables')
msgid "Logitech"
msgstr "罗技"

