msgstr ""
"Rossz vagy hiányzó WOPISrc paraméter, lépjen kapcsolatba az "
"ügyfélszolgálattal."

#: src/errormessages.ts:39
msgid "Your session will end in {time}. Refresh the page to continue."
msgstr "A munkamenet {time} múlva lejár. A folytatáshoz frissítse az oldalt."

#: src/errormessages.ts:42
msgid ""
"Your session has ended. Further changes to the document might not be saved. "
"Refresh the page to continue."
msgstr ""
"A munkamenet lejárt. A dokumentum további módosításai lehet, hogy nem "
"kerülnek mentésre. A folytatáshoz frissítse az oldalt."

#: src/errormessages.ts:45
msgid ""
"Failed to load the document. Please ensure the file type is supported and "
"not corrupted, and try again."
msgstr ""
"A dokumentum betöltése sikertelen. Ellenőrizze, hogy a fájltípus támogatott "
"és a fájl nem sérült, majd próbálkozzon újra."

#: src/errormessages.ts:47
msgid "Invalid link: '{url}'"
msgstr "Érvénytelen hivatkozás: „{url}”"

