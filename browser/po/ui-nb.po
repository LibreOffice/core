#: src/control/onboarding/OnboardingSteps.ts:25
msgid "Welcome to Collabora Online"
msgstr "Velkommen til Collabora Online"

#: src/control/onboarding/OnboardingSteps.ts:27
msgid "This short tour points out the parts of the screen you will use most."
msgstr "Denne korte omvisningen peker ut delene av skjermen du vil bruke mest."

#: src/control/onboarding/OnboardingSteps.ts:32
msgid "The document name"
msgstr "Navnet på dokumentet"

#: src/control/onboarding/OnboardingSteps.ts:34
msgid ""
"Select the name to rename the document. Every change is saved as you work."
msgstr ""
"Velg navnet for å gi dokumentet nytt navn. Hver endring lagres mens du "
"arbeider."

#: src/control/onboarding/OnboardingSteps.ts:41
msgid "The tabs"
msgstr "Fanene"

#: src/control/onboarding/OnboardingSteps.ts:43
msgid ""
"Each tab gathers the tools for one kind of work, such as inserting or "
"reviewing."
msgstr ""
"Hver fane samler verktøyene for én type arbeid, for eksempel å sette inn "
"eller å gå gjennom."

#: src/control/onboarding/OnboardingSteps.ts:50
msgid "The menus"
msgstr "Menyene"

#: src/control/onboarding/OnboardingSteps.ts:51
msgid "Every command of the editor is in one of these menus."
msgstr "Hver kommando i redigeringsprogrammet finnes i en av disse menyene."

#: src/control/onboarding/OnboardingSteps.ts:57
msgid "The tools"
msgstr "Verktøyene"

#: src/control/onboarding/OnboardingSteps.ts:58
msgid "The buttons of the tab you selected appear along this row."
msgstr "Knappene for fanen du valgte vises langs denne raden."

#: src/control/onboarding/OnboardingSteps.ts:64
msgid "The toolbar"
msgstr "Verktøylinjen"

#: src/control/onboarding/OnboardingSteps.ts:65
msgid "The buttons you need most often sit here, under the menus."
msgstr "Knappene du trenger oftest, står her, under menyene."

#: src/control/onboarding/OnboardingSteps.ts:71
msgid "The formula bar"
msgstr "Formellinjen"

#: src/control/onboarding/OnboardingSteps.ts:73
msgid ""
"The contents of the selected cell appear here. Type an equals sign to start "
"a formula."
msgstr ""
"Innholdet i den valgte cellen vises her. Skriv et likhetstegn for å starte "
"en formel."

#: src/control/onboarding/OnboardingSteps.ts:80
msgid "The slide panel"
msgstr "Lysbildepanelet"

#: src/control/onboarding/OnboardingSteps.ts:82
msgid ""
"Every slide or page of the document is listed here. Select one to work on "
"it."
msgstr ""
"Hvert lysbilde eller hver side i dokumentet er oppført her. Velg ett for å "
"arbeide med det."

#: src/control/onboarding/OnboardingSteps.ts:90
msgid "The sidebar"
msgstr "Sidefeltet"

#: src/control/onboarding/OnboardingSteps.ts:92
msgid ""
"The sidebar holds the settings for whatever you have selected, such as "
"text, a shape or a cell."
msgstr ""
"Sidefeltet inneholder innstillingene for det du har valgt, for eksempel "
"tekst, en form eller en celle."

#: src/control/onboarding/OnboardingSteps.ts:99
msgid "The people in the document"
msgstr "Personene i dokumentet"

#: src/control/onboarding/OnboardingSteps.ts:100
msgid "See who else is editing and share the document."
msgstr "Se hvem andre som redigerer, og del dokumentet."

#: src/control/onboarding/OnboardingSteps.ts:110
msgid "The status bar"
msgstr "Statuslinjen"

#: src/control/onboarding/OnboardingSteps.ts:112
msgid ""
"The state of the document, the language of the text and the zoom level are "
"along the bottom."
msgstr "Status for dokumentet, språket i teksten og zoomnivået står nederst."

#: src/control/onboarding/OnboardingSteps.ts:119
msgid "You are ready to work"
msgstr "Du er klar til å arbeide"

#: src/control/onboarding/OnboardingSteps.ts:120
msgid "You can walk through this tour again from the Help menu."
msgstr "Du kan gå gjennom denne omvisningen igjen fra Hjelp-menyen."

