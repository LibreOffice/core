msgstr ""
"Document kan niet worden opgeslagen vanwege verlopen sessie, laad de pagina "
"opnieuw om verder te gaan."

#: src/errormessages.js:57
msgid "Document cannot be saved, please check your permissions."
msgstr "Document kan niet worden opgeslagen, controleer uw rechten."

#: src/errormessages.js:58
msgid "Document cannot be renamed, please check your permissions."
msgstr "Document kan niet hernoemd worden, controleer uw rechten."

#: src/errormessages.js:59
