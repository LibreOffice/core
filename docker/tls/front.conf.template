# The HTTPS front of a writing aid service, for the nginx image, which fills
# in TLS_HOST, TLS_UPSTREAM and TLS_PATHS from its environment when it
# starts. Collabora Office talks to https://${TLS_HOST}, and the requests go
# on to the service at http://${TLS_UPSTREAM}, which nothing but this front
# can reach. Only the paths Collabora Office asks for, the alternatives of
# the regular expression TLS_PATHS, are passed on; any other path is
# answered with 404 here, so the rest of the service's API stays out of
# reach.

server {
    listen 443 ssl;
    server_name ${TLS_HOST};

    ssl_certificate /certs/${TLS_HOST}.crt;
    ssl_certificate_key /certs/${TLS_HOST}.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 16m;

    location ~ ^(?:${TLS_PATHS})$ {
        proxy_pass http://${TLS_UPSTREAM};
        proxy_read_timeout 60s;
    }

    location / {
        return 404;
    }
}
