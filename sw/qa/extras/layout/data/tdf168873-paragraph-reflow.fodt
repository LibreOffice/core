      <text:p text:style-name="P9"><text:span text:style-name="T24">Altix I </text:span><text:span text:style-name="T25">mit Pololyt 3,5/35 Nr. 415484</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T27">als</text:span><text:span text:style-name="T25"> Fixfokus-Objektiv, </text:span><text:span text:style-name="T24">frühe</text:span><text:span text:style-name="T28">s</text:span><text:span text:style-name="T24"> </text:span><text:span text:style-name="T28">Exemplar</text:span><text:span text:style-name="T24"> </text:span><text:span text:style-name="T26">von 1939:</text:span><text:span text:style-name="T24"> fein </text:span><text:span text:style-name="T26">gerändelte</text:span><text:span text:style-name="T24"> Transportknöpfe, </text:span><text:span text:style-name="T29">Abziehbü</text:span><text:span text:style-name="T30">g</text:span><text:span text:style-name="T29">el </text:span><text:span text:style-name="T26">für Bodendeckel </text:span><text:span text:style-name="T29">von vorn gesehen rechts, </text:span><text:span text:style-name="T26">einfaches „Innenleben“ des Bodendeckels </text:span><text:span text:style-name="T28">mit</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T31">von außen </text:span><text:span text:style-name="T26">an das Bodenblech geschraubte</text:span><text:span text:style-name="T28">r</text:span><text:span text:style-name="T26"> Alu-</text:span><text:span text:style-name="T28">Schien</text:span><text:span text:style-name="T26">e, </text:span><text:span text:style-name="T32">zum Vergleich unten rechts der Bodendeckel mit Blecheinsatz einer späteren Altix I</text:span></text:p>
      <text:p text:style-name="P10"><text:span text:style-name="T32"><text:s/></text:span><text:span text:style-name="T33">▼</text:span></text:p>
