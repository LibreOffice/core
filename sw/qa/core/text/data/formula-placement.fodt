<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" xmlns:math="http://www.w3.org/1998/Math/MathML" office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.text">
 <office:font-face-decls>
  <style:font-face style:name="Liberation Serif" svg:font-family="'Liberation Serif'" style:font-family-generic="roman" style:font-pitch="variable"/>
 </office:font-face-decls>
 <office:styles>
  <style:default-style style:family="paragraph">
   <style:text-properties style:font-name="Liberation Serif" fo:font-size="12pt" fo:language="en" fo:country="US"/>
  </style:default-style>
  <style:style style:name="Standard" style:family="paragraph" style:class="text"/>
 </office:styles>
 <office:automatic-styles>
  <style:style style:name="fr1" style:family="graphic">
   <style:graphic-properties style:vertical-pos="middle" style:vertical-rel="text" fo:padding="0in" fo:border="none"/>
  </style:style>
  <style:style style:name="fr2" style:family="graphic">
   <style:graphic-properties style:wrap="none" style:vertical-pos="top" style:vertical-rel="paragraph" style:horizontal-pos="center" style:horizontal-rel="paragraph" fo:padding="0in" fo:border="none"/>
  </style:style>
  <style:style style:name="fr3" style:family="graphic">
   <style:graphic-properties style:wrap="none" style:vertical-pos="from-top" style:vertical-rel="page" style:horizontal-pos="from-left" style:horizontal-rel="page" fo:padding="0in" fo:border="none"/>
  </style:style>
 </office:automatic-styles>
 <office:body>
  <office:text>
   <text:p text:style-name="Standard">The mass energy equivalence is <draw:frame draw:style-name="fr1" draw:name="Object1" text:anchor-type="as-char" svg:width="0.9in" svg:height="0.3in" draw:z-index="0"><draw:object><math:math><math:semantics><math:mrow><math:mi mathvariant="normal">E</math:mi><math:mo stretchy="false">=</math:mo><math:msup><math:mi mathvariant="italic">mc</math:mi><math:mn>2</math:mn></math:msup></math:mrow><math:annotation encoding="StarMath 5.0">E=mc^2</math:annotation></math:semantics></math:math></draw:object></draw:frame> in a paragraph.</text:p>
   <text:p text:style-name="Standard">One on its own follows.<draw:frame draw:style-name="fr2" draw:name="Object2" text:anchor-type="paragraph" svg:x="1in" svg:y="0.2in" svg:width="0.6in" svg:height="0.4in" draw:z-index="1"><draw:object><math:math><math:semantics><math:mrow><math:mfrac><math:mi mathvariant="italic">a</math:mi><math:mn>2</math:mn></math:mfrac></math:mrow><math:annotation encoding="StarMath 5.0">a over 2</math:annotation></math:semantics></math:math></draw:object></draw:frame></text:p>
   <text:p text:style-name="Standard">One on the page follows.<draw:frame draw:style-name="fr3" draw:name="Object3" text:anchor-type="page" text:anchor-page-number="1" svg:x="4in" svg:y="4in" svg:width="0.7in" svg:height="0.3in" draw:z-index="2"><draw:object><math:math><math:semantics><math:mrow><math:mi mathvariant="italic">b</math:mi><math:mo stretchy="false">+</math:mo><math:mn>1</math:mn></math:mrow><math:annotation encoding="StarMath 5.0">b+1</math:annotation></math:semantics></math:math></draw:object></draw:frame></text:p>
  </office:text>
 </office:body>
</office:document>
